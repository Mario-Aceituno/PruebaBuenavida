public static class InlineMarkdown
{
    private static readonly Regex CodeRegex = new(@"`([^`\n]+)`", RegexOptions.Compiled);
    private static readonly Regex LinkRegex = new(@"\[([^\]\n]+)\]\((https?://[^\s)]+)\)", RegexOptions.Compiled);
    private static readonly Regex BoldRegex = new(@"\*\*([^\*\n]+)\*\*", RegexOptions.Compiled);
    private static readonly Regex ItalicRegex = new(@"(?<!\*)\*([^\*\n]+)\*(?!\*)", RegexOptions.Compiled);
    private static readonly Regex UnderlineRegex = new(@"__([^_\n]+)__", RegexOptions.Compiled);

    private static readonly Regex ListLineRegex = new(@"^(?<indent>(?: {2})*)(?<marker>[-*]|\d+\.)\s+(?<content>.*)$", RegexOptions.Compiled);

    public static MarkupString Render(string? text)
    {
        if (string.IsNullOrEmpty(text)) return new MarkupString(string.Empty);

        var lines = text.Replace("\r\n", "\n").Split('\n');
        var sb = new StringBuilder();

        // Niveles de lista abiertos actualmente: (nivel, tipo "bullet"|"number")
        var openLevels = new List<(int Level, string Type)>();
        var counters = new Dictionary<int, int>();

        void CloseFrom(int level)
        {
            while (openLevels.Count > 0 && openLevels[^1].Level >= level)
            {
                sb.Append("</ul>");
                counters.Remove(openLevels[^1].Level);
                openLevels.RemoveAt(openLevels.Count - 1);
            }
        }

        foreach (var rawLine in lines)
        {
            var match = ListLineRegex.Match(rawLine);

            if (match.Success)
            {
                var level = match.Groups["indent"].Value.Length / 2;
                var isNumbered = char.IsDigit(match.Groups["marker"].Value[0]);
                var type = isNumbered ? "number" : "bullet";

                // Cerrar niveles más profundos o de tipo distinto en el mismo nivel
                while (openLevels.Count > 0 && (openLevels[^1].Level > level ||
                       (openLevels[^1].Level == level && openLevels[^1].Type != type)))
                {
                    sb.Append("</ul>");
                    counters.Remove(openLevels[^1].Level);
                    openLevels.RemoveAt(openLevels.Count - 1);
                }

                if (openLevels.Count == 0 || openLevels[^1].Level < level)
                {
                    sb.Append("<ul class=\"editra-preview__list editra-preview__list--lvl").Append(level).Append("\">");
                    openLevels.Add((level, type));
                    counters[level] = 0;
                }

                counters[level] = counters.GetValueOrDefault(level, 0) + 1;
                var marker = type == "number" ? $"{counters[level]}." : "*";

                sb.Append("<li><span class=\"editra-preview__marker\">").Append(marker).Append("</span>")
                  .Append("<span class=\"editra-preview__item-text\">")
                  .Append(RenderInline(match.Groups["content"].Value))
                  .Append("</span></li>");
            }
            else
            {
                CloseFrom(0);
                sb.Append(RenderInline(rawLine)).Append("<br />");
            }
        }

        CloseFrom(0);

        return new MarkupString(sb.ToString());
    }

    private static string RenderInline(string line)
    {
        var html = System.Net.WebUtility.HtmlEncode(line);
        html = CodeRegex.Replace(html, "<code class=\"inline-code\">$1</code>");
        html = LinkRegex.Replace(html, "<a href=\"$2\" target=\"_blank\" rel=\"noopener noreferrer\">$1</a>");
        html = BoldRegex.Replace(html, "<strong>$1</strong>");
        html = UnderlineRegex.Replace(html, "<u>$1</u>");
        html = ItalicRegex.Replace(html, "<em>$1</em>");
        return html;
    }
}





.editra-preview__list {
    list-style: none;
    margin: 0.25rem 0;
    padding-left: 0;
}
.editra-preview__list li {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
}
.editra-preview__list--lvl0 { margin-left: 0; }
.editra-preview__list--lvl1 { margin-left: 1.25rem; }
.editra-preview__list--lvl2 { margin-left: 2.5rem; }
.editra-preview__list--lvl3 { margin-left: 3.75rem; }

.editra-preview__marker {
    flex: 0 0 auto;
    color: var(--editra-muted, #8b93a5);
    font-weight: 600;
    min-width: 1.1rem;
}
.editra-preview__item-text { flex: 1; }

.editra-toolbar { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.35rem; }




@if (!ReadOnly)
{
    <div class="editra-toolbar">
        <button type="button" class="editra-icon-btn" title="Negrita" @onclick='() => ToggleInlineWrap("**")'>
            <Icon Name="bold" />
        </button>
        <button type="button" class="editra-icon-btn" title="Cursiva" @onclick='() => ToggleInlineWrap("*")'>
            <Icon Name="italic" />
        </button>
        <button type="button" class="editra-icon-btn" title="Subrayado" @onclick='() => ToggleInlineWrap("__")'>
            <Icon Name="underline" />
        </button>
        <span class="editra-toolbar__sep"></span>
        <button type="button" class="editra-chip-btn" title="Viñetas" @onclick='() => ToggleListMarker("-")'>
            <Icon Name="list" /> Viñeta
        </button>
        <button type="button" class="editra-chip-btn" title="Lista numerada" @onclick='() => ToggleListMarker("1.")'>
            <Icon Name="list-ordered" /> Numerada
        </button>
        <button type="button" class="editra-icon-btn" title="Aumentar sangría" @onclick="() => ChangeIndent(1)">
            <Icon Name="indent" />
        </button>
        <button type="button" class="editra-icon-btn" title="Disminuir sangría" @onclick="() => ChangeIndent(-1)">
            <Icon Name="outdent" />
        </button>
    </div>
}




.editra-toolbar__sep {
    width: 1px;
    background: var(--editra-border, #2a2f3a);
    margin: 0 0.15rem;
}




private async Task ToggleInlineWrap(string marker)
{
    var selection = await JS.InvokeAsync<TextSelection?>("editraTextarea.getSelection", ParagraphElementId);
    var text = Block.Text ?? string.Empty;

    var start = selection?.Start ?? text.Length;
    var end = selection?.End ?? text.Length;
    if (end < start) (start, end) = (end, start);

    if (start == end)
    {
        // Sin selección: inserta el par de marcadores con el cursor en medio
        var newText = text[..start] + marker + marker + text[start..];
        Block.Text = newText;
        await Changed();
        var caret = start + marker.Length;
        await JS.InvokeVoidAsync("editraTextarea.setSelection", ParagraphElementId, caret, caret);
        return;
    }

    var selected = text[start..end];
    var markerLen = marker.Length;

    var alreadyWrapped = start >= markerLen && end + markerLen <= text.Length
        && text.Substring(start - markerLen, markerLen) == marker
        && text.Substring(end, markerLen) == marker;

    string newFullText;
    int newStart, newEnd;

    if (alreadyWrapped)
    {
        newFullText = text[..(start - markerLen)] + selected + text[(end + markerLen)..];
        newStart = start - markerLen;
        newEnd = newStart + selected.Length;
    }
    else
    {
        newFullText = text[..start] + marker + selected + marker + text[end..];
        newStart = start;
        newEnd = end + markerLen * 2;
    }

    Block.Text = newFullText;
    await Changed();
    await JS.InvokeVoidAsync("editraTextarea.setSelection", ParagraphElementId, newStart, newEnd);
}