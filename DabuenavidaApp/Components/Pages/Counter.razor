private void GoToJourneyStep(int index)
{
    if (index < 0 || index >= _journey.Count) return;

    _journeyDirection = index > _journeyStepIndex 
        ? "next" 
        : "prev";

    _journeyStepIndex = index;
    _journeyStep = BuildAreaStory(_journey[index].AreaName);
}


<div class="journey-modal__body journey-modal__body--@_journeyDirection"
     @key="_journeyStepIndex">

.journey-modal__body--next {
    animation: journeySlideNext .25s ease;
}


.journey-modal__body--prev {
    animation: journeySlidePrev .25s ease;
}



@keyframes journeySlideNext {

    from {
        opacity:0;
        transform:translateX(20px);
    }

    to {
        opacity:1;
        transform:translateX(0);
    }

}



@keyframes journeySlidePrev {

    from {
        opacity:0;
        transform:translateX(-20px);
    }

    to {
        opacity:1;
        transform:translateX(0);
    }

}

