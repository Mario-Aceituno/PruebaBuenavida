namespace Application.Common.Models;

/// <summary>
/// Categorías fijas de almacenamiento. Cada una mapea a una subcarpeta/prefijo
/// controlado por la capa de infraestructura, nunca por input externo directo.
/// Evita que un caller pueda inyectar rutas arbitrarias vía un string de carpeta.
/// </summary>
public enum FileCategory
{
    ArticleCover,
    ArticleAttachment,
    UserAvatar
}

namespace Application.Common.Models;

/// <summary>
/// Encapsula los datos necesarios para subir un archivo al storage configurado.
/// </summary>
public sealed record FileUploadRequest
{
    public required Stream Content { get; init; }
    public required string FileName { get; init; }
    public required string ContentType { get; init; }
    public required long SizeInBytes { get; init; }
    public required FileCategory Category { get; init; }
}