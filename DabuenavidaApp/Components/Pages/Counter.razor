    public async Task<IReadOnlyList<Article>> GetHistoryArticlesAsync(int count = 20)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty)
            return new List<Article>();

        await using var db = await _dbFactory.CreateDbContextAsync();

        var query = from h in db.ArticleHistories
                    where h.UserId == userId
                    group h by h.ArticleId into g
                    select new { ArticleId = g.Key, LastViewedAt = g.Max(h => h.ViewedAt) };

        var ordered = from lv in query
                      join a in db.Articles on lv.ArticleId equals a.Id
                      orderby lv.LastViewedAt descending
                      select a;

        var articles = await ordered.Take(count).ToListAsync();

        foreach (var article in articles)
            await PopulateNotMappedListsAsync(db, article);

        return articles;
    }

    public async Task RegisterArticleViewAsync(Guid articleId)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return;

        await using var db = await _dbFactory.CreateDbContextAsync();

        var existing = await db.ArticleHistories
            .FirstOrDefaultAsync(h => h.UserId == userId && h.ArticleId == articleId);

        if (existing != null)
            existing.ViewedAt = DateTime.UtcNow;
        else
            db.ArticleHistories.Add(new ArticleHistory
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                ArticleId = articleId,
                ViewedAt = DateTime.UtcNow
            });

        await db.SaveChangesAsync();
    }

    public async Task<IReadOnlyDictionary<Guid, DateTime>> GetHistoryLastViewAsync(int count = 20)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty)
            return new Dictionary<Guid, DateTime>();

        await using var db = await _dbFactory.CreateDbContextAsync();

        var lastViews = await db.ArticleHistories
            .Where(h => h.UserId == userId)
            .GroupBy(h => h.ArticleId)
            .Select(g => new { ArticleId = g.Key, LastViewedAt = g.Max(h => h.ViewedAt) })
            .OrderByDescending(x => x.LastViewedAt)
            .Take(count)
            .ToListAsync();

        return lastViews.ToDictionary(x => x.ArticleId, x => x.LastViewedAt);
    }

