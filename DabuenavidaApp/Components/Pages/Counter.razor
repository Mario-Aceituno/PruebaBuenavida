@* ============================================================
   EditraMediaUploader.razor
   ------------------------------------------------------------
   Campo reutilizable para los bloques de Editra que necesitan
   URL(s) de medios (Image, Gallery, Video, FileAttachment).

   - Permite SUBIR archivo (usa IFileStorageService -> CDN/local)
     o pegar una URL manualmente (legado / enlaces externos).
   - Muestra vista previa (imagen, video o icono de archivo).
   - Soporta múltiples archivos ordenados (Gallery) o uno solo
     (Image, Video thumbnail, FileAttachment).
   - Permite reordenar (subir/bajar) y quitar cada item.
   - En modo ReadOnly solo muestra las previews, sin controles.

   AJUSTA SI DIFIERE EN TU PROYECTO (marcado con "// AJUSTA"):
   - Namespace de FileCategory / FileUploadRequest / FileUploadResult
   - Nombres de propiedades de FileUploadResult (Succeeded, Key, Error)
   ============================================================ *@
@using CorpWiki.Application.Common.Models
@using CorpWiki.Application.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IFileStorageService FileStorage

<div class="editra-uploader @(ReadOnly ? "editra-uploader--readonly" : "")">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="editra-label">@Label</label>
    }

    @if (Urls.Count(u => !string.IsNullOrWhiteSpace(u)) > 0)
    {
        <div class="editra-uploader__list">
            @for (var i = 0; i < Urls.Count; i++)
            {
                var idx = i;
                if (string.IsNullOrWhiteSpace(Urls[idx])) { continue; }

                <div class="editra-uploader__item">
                    <div class="editra-uploader__thumb">
                        @RenderPreview(Urls[idx])
                    </div>

                    <div class="editra-uploader__meta">
                        <span class="editra-uploader__filename" title="@Urls[idx]">
                            @FileNameFromUrl(Urls[idx])
                        </span>
                    </div>

                    @if (!ReadOnly)
                    {
                        <div class="editra-uploader__actions">
                            @if (Multiple && idx > 0)
                            {
                                <button type="button" class="editra-icon-btn editra-icon-btn--sm"
                                        title="Subir" @onclick="() => MoveUp(idx)">
                                    <Icon Name="chevron-up" />
                                </button>
                            }
                            @if (Multiple && idx < Urls.Count - 1)
                            {
                                <button type="button" class="editra-icon-btn editra-icon-btn--sm"
                                        title="Bajar" @onclick="() => MoveDown(idx)">
                                    <Icon Name="chevron-down" />
                                </button>
                            }
                            <button type="button" class="editra-icon-btn editra-icon-btn--sm editra-icon-btn--danger"
                                    title="Quitar" @onclick="() => RemoveAt(idx)">
                                <Icon Name="trash-2" />
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (!ReadOnly)
    {
        <div class="editra-uploader__controls">

            <label class="editra-chip-btn editra-uploader__upload-btn @(_uploading ? "is-disabled" : "")">
                @if (_uploading)
                {
                    <span class="editra-uploader__spinner"></span>
                    <span>Subiendo…</span>
                }
                else
                {
                    <Icon Name="upload" />
                    <span>@UploadButtonText</span>
                }
                <InputFile OnChange="OnFilesSelected" multiple="@Multiple"
                           accept="@Accept" disabled="@_uploading" class="editra-uploader__input-file" />
            </label>

            @if (ShowManualUrlInput && (!Multiple || Urls.Count(u => !string.IsNullOrWhiteSpace(u)) == 0))
            {
                <div class="editra-uploader__manual">
                    <input class="editra-input" placeholder="o pega una URL: https://…"
                           value="@_manualUrl" @oninput="OnManualUrlInput" />
                    <button type="button" class="editra-icon-btn editra-icon-btn--sm" title="Agregar URL"
                            disabled="@string.IsNullOrWhiteSpace(_manualUrl)" @onclick="AddManualUrl">
                        <Icon Name="plus" />
                    </button>
                </div>
            }
            else if (ShowManualUrlInput && Multiple)
            {
                <button type="button" class="editra-chip-btn" @onclick="() => _showManualForGallery = !_showManualForGallery">
                    <Icon Name="link" /> Agregar por URL
                </button>
            }
        </div>

        @if (ShowManualUrlInput && Multiple && _showManualForGallery)
        {
            <div class="editra-uploader__manual">
                <input class="editra-input" placeholder="https://…"
                       value="@_manualUrl" @oninput="OnManualUrlInput" />
                <button type="button" class="editra-icon-btn editra-icon-btn--sm" title="Agregar URL"
                        disabled="@string.IsNullOrWhiteSpace(_manualUrl)" @onclick="AddManualUrl">
                    <Icon Name="plus" />
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="editra-uploader__error">
                <Icon Name="alert-triangle" /> @_error
            </p>
        }
    }
</div>

@code {
    /// <summary>Lista enlazada (bindable) de URLs del bloque. Ej: Block.Urls</summary>
    [Parameter] public List<string> Urls { get; set; } = new();
    [Parameter] public EventCallback<List<string>> UrlsChanged { get; set; }

    /// <summary>true = Gallery (varios archivos). false = Image/Video/FileAttachment (uno solo).</summary>
    [Parameter] public bool Multiple { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public string UploadButtonText { get; set; } = "Subir archivo";

    /// <summary>Filtro nativo del input file, ej: "image/*", "video/*", o "" para cualquiera.</summary>
    [Parameter] public string Accept { get; set; } = "image/*";

    /// <summary>Permite además pegar una URL a mano (enlaces externos, legado).</summary>
    [Parameter] public bool ShowManualUrlInput { get; set; } = true;

    /// <summary>Categoría de almacenamiento. AJUSTA el enum a tu FileCategory real.</summary>
    [Parameter] public FileCategory Category { get; set; } = FileCategory.ArticleAttachment;

    [Parameter] public long MaxFileSizeBytes { get; set; } = 25 * 1024 * 1024; // 25 MB

    /// <summary>
    /// Se dispara tras cada subida exitosa, útil para que el padre rellene
    /// Block.Text / Block.Meta (ej: nombre y tamaño en FileAttachment).
    /// </summary>
    [Parameter] public EventCallback<UploadedFileInfo> OnUploaded { get; set; }

    private bool _uploading;
    private string? _error;
    private string _manualUrl = string.Empty;
    private bool _showManualForGallery;

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _uploading = true;
        StateHasChanged();

        try
        {
            var files = Multiple
                ? e.GetMultipleFiles(10).ToList()
                : new List<IBrowserFile> { e.File };

            foreach (var file in files)
            {
                await UploadOne(file);
            }
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task UploadOne(IBrowserFile file)
    {
        try
        {
            await using var stream = file.OpenReadStream(MaxFileSizeBytes);

            // AJUSTA: nombres de propiedades de FileUploadRequest si difieren.
            var request = new FileUploadRequest
            {
                Content = stream,
                FileName = file.Name,
                SizeInBytes = file.Size,
                Category = Category
            };

            var result = await FileStorage.UploadAsync(request);

            // AJUSTA: nombres de propiedades de FileUploadResult si difieren
            // (aquí se asume Succeeded / Key / Error).
            if (!result.Succeeded || string.IsNullOrWhiteSpace(result.Key))
            {
                _error = result.Error ?? "No se pudo subir el archivo.";
                return;
            }

            var url = FileStorage.GetPublicUrl(result.Key);

            if (Multiple)
            {
                Urls.Add(url);
            }
            else
            {
                if (Urls.Count == 0) Urls.Add(url);
                else Urls[0] = url;
            }

            await UrlsChanged.InvokeAsync(Urls);

            if (OnUploaded.HasDelegate)
            {
                await OnUploaded.InvokeAsync(new UploadedFileInfo(url, file.Name, file.Size));
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OnManualUrlInput(ChangeEventArgs e) => _manualUrl = e.Value?.ToString() ?? string.Empty;

    private async Task AddManualUrl()
    {
        if (string.IsNullOrWhiteSpace(_manualUrl)) return;

        if (Multiple)
        {
            Urls.Add(_manualUrl.Trim());
        }
        else
        {
            if (Urls.Count == 0) Urls.Add(_manualUrl.Trim());
            else Urls[0] = _manualUrl.Trim();
        }

        _manualUrl = string.Empty;
        _showManualForGallery = false;
        await UrlsChanged.InvokeAsync(Urls);
    }

    private async Task RemoveAt(int idx)
    {
        Urls.RemoveAt(idx);
        await UrlsChanged.InvokeAsync(Urls);
    }

    private async Task MoveUp(int idx)
    {
        if (idx <= 0) return;
        (Urls[idx - 1], Urls[idx]) = (Urls[idx], Urls[idx - 1]);
        await UrlsChanged.InvokeAsync(Urls);
    }

    private async Task MoveDown(int idx)
    {
        if (idx >= Urls.Count - 1) return;
        (Urls[idx + 1], Urls[idx]) = (Urls[idx], Urls[idx + 1]);
        await UrlsChanged.InvokeAsync(Urls);
    }

    private static string FileNameFromUrl(string url)
    {
        var clean = url.Split('?')[0].TrimEnd('/');
        var last = clean.Contains('/') ? clean[(clean.LastIndexOf('/') + 1)..] : clean;
        return string.IsNullOrWhiteSpace(last) ? url : Uri.UnescapeDataString(last);
    }

    private static readonly string[] ImageExt = { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".avif" };
    private static readonly string[] VideoExt = { ".mp4", ".webm", ".ogg", ".mov" };

    private RenderFragment RenderPreview(string url) => builder =>
    {
        var ext = Path.GetExtension(url.Split('?')[0]).ToLowerInvariant();

        if (ImageExt.Contains(ext))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "src", url);
            builder.AddAttribute(2, "alt", FileNameFromUrl(url));
            builder.AddAttribute(3, "loading", "lazy");
            builder.CloseElement();
        }
        else if (VideoExt.Contains(ext))
        {
            builder.OpenElement(0, "video");
            builder.AddAttribute(1, "src", url);
            builder.AddAttribute(2, "controls", true);
            builder.AddAttribute(3, "preload", "metadata");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", url);
            builder.AddAttribute(2, "target", "_blank");
            builder.AddAttribute(3, "class", "editra-uploader__file-icon");
            builder.OpenComponent<Icon>(4);
            builder.AddAttribute(5, "Name", "file");
            builder.CloseComponent();
            builder.CloseElement();
        }
    };

    /// <summary>Info devuelta al padre tras una subida exitosa.</summary>
    public record UploadedFileInfo(string Url, string FileName, long SizeInBytes);
}








/* EditraMediaUploader.razor.css
   Ajusta las variables (--editra-*) si ya las tienes definidas globalmente;
   si no existen, caen a los valores de respaldo indicados. */

.editra-uploader {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
}

/* ---------- Lista de items ---------- */

.editra-uploader__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.6rem;
}

.editra-uploader--readonly .editra-uploader__list {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
}

.editra-uploader__item {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--editra-border, #2a2f3a);
    border-radius: 10px;
    overflow: hidden;
    background: var(--editra-surface, #12151c);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.editra-uploader__item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
}

.editra-uploader__thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--editra-surface-alt, #1b1f29);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.editra-uploader__thumb img,
.editra-uploader__thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.editra-uploader__file-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--editra-muted, #8b93a5);
}

.editra-uploader__meta {
    padding: 0.35rem 0.5rem;
    border-top: 1px solid var(--editra-border, #2a2f3a);
}

.editra-uploader__filename {
    display: block;
    font-size: 0.75rem;
    color: var(--editra-muted, #8b93a5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.editra-uploader__actions {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 0.15s ease;
}

.editra-uploader__item:hover .editra-uploader__actions {
    opacity: 1;
}

.editra-icon-btn--danger:hover {
    background: rgba(220, 53, 69, 0.15);
    color: #dc3545;
}

/* ---------- Controles de subida ---------- */

.editra-uploader__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
}

.editra-uploader__upload-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
}

.editra-uploader__upload-btn.is-disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.editra-uploader__input-file {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
}

.editra-uploader__manual {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 1 1 220px;
    min-width: 200px;
}

.editra-uploader__manual .editra-input {
    flex: 1;
}

.editra-uploader__spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: editra-uploader-spin 0.7s linear infinite;
}

@keyframes editra-uploader-spin {
    to { transform: rotate(360deg); }
}

.editra-uploader__error {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #dc3545;
    margin: 0;
}






# Integración de EditraMediaUploader en EditraBlockEditor.razor

## 0. Requisitos previos

1. Copia `EditraMediaUploader.razor` y `EditraMediaUploader.razor.css` a la
   misma carpeta de tus componentes Editra (donde está `EditraBlockEditor.razor`).
2. Revisa los comentarios `// AJUSTA` dentro del componente:
   - Propiedades de `FileUploadRequest` (`Content`, `FileName`, `SizeInBytes`, `Category`).
   - Propiedades de `FileUploadResult` (asumí `Succeeded`, `Key`, `Error` — cámbialas
     si tu modelo real usa otros nombres, ej. `IsSuccess`, `Key`, `ErrorMessage`).
3. Si tu `FileCategory` no tiene un valor genérico para medios de artículo,
   te recomiendo añadir uno nuevo en vez de reusar `ArticleAttachment` para todo:

```csharp
public enum FileCategory
{
    ArticleCover,
    ArticleAttachment,
    ArticleMedia,   // <- nuevo: imágenes/galería/adjuntos insertados en el cuerpo
    UserAvatar
}
```

   y en `CategoryFolder`:

```csharp
FileCategory.ArticleMedia => "articulos/media",
```

4. `EditraBlockEditor.razor` no necesita inyectar `IFileStorageService`
   directamente: el componente lo inyecta él mismo. Solo asegúrate de que
   `IFileStorageService` esté registrado en DI (ya lo tienes, por
   `LocalFileStorageService`).

---

## 1. Case `ContentBlockType.Image`

Reemplaza el bloque actual (label + input de URL + preview manual) por:

```razor
case ContentBlockType.Image:
    <div class="editra-field editra-media">
        <EditraMediaUploader Label="Imagen"
                              Urls="Block.Urls"
                              UrlsChanged="urls => { Block.Urls = urls; Changed(); }"
                              Multiple="false"
                              Accept="image/*"
                              Category="FileCategory.ArticleMedia"
                              ReadOnly="ReadOnly" />

        <label class="editra-label">Texto alternativo</label>
        <input class="editra-input" placeholder="Describe la imagen (accesibilidad)" readonly="@ReadOnly"
               @bind="Block.Text" @bind:event="oninput" @bind:after="Changed" />
    </div>
    break;
```

La preview de la imagen ya la resuelve el propio uploader (no necesitas el
`@if (!string.IsNullOrWhiteSpace(...)) { <div class="editra-media__preview">...` manual).

---

## 2. Case `ContentBlockType.Gallery`

```razor
case ContentBlockType.Gallery:
    <div class="editra-field editra-media">
        <EditraMediaUploader Label="Imágenes"
                              Urls="Block.Urls"
                              UrlsChanged="urls => { Block.Urls = urls; Changed(); }"
                              Multiple="true"
                              Accept="image/*"
                              Category="FileCategory.ArticleMedia"
                              ReadOnly="ReadOnly" />
    </div>
    break;
```

Esto sustituye todo el `@for` manual con inputs por fila + botón "Agregar
imagen" + preview en grilla: el uploader ya maneja orden (subir/bajar),
preview en grilla y quitar.

---

## 3. Case `ContentBlockType.Video`

Aquí mantén el campo de Título como está, y usa el uploader solo para la
miniatura (o para subir el video si algún día permites archivos de video
directos, ya que el componente detecta `.mp4/.webm/.ogg` y renderiza
`<video>`):

```razor
case ContentBlockType.Video:
    <div class="editra-field editra-media">
        <label class="editra-label">Título del video</label>
        <input class="editra-input" placeholder="Título…" readonly="@ReadOnly"
               @bind="Block.Text" @bind:event="oninput" @bind:after="Changed" />

        <EditraMediaUploader Label="Miniatura o video"
                              Urls="Block.Urls"
                              UrlsChanged="urls => { Block.Urls = urls; Changed(); }"
                              Multiple="false"
                              Accept="image/*,video/*"
                              ShowManualUrlInput="true"
                              Category="FileCategory.ArticleMedia"
                              ReadOnly="ReadOnly" />
    </div>
    break;
```

`ShowManualUrlInput="true"` deja la puerta abierta a pegar un link de
YouTube/Vimeo como antes, sin obligar a subir archivo.

---

## 4. Case `ContentBlockType.FileAttachment`

Este es el único caso donde además de la URL quieres autocompletar
`Block.Text` (nombre) y `Block.Meta` (tipo · tamaño). Para eso usamos
`OnUploaded`:

```razor
case ContentBlockType.FileAttachment:
    <div class="editra-field editra-media">
        <EditraMediaUploader Label="Archivo"
                              Urls="Block.Urls"
                              UrlsChanged="urls => { Block.Urls = urls; Changed(); }"
                              Multiple="false"
                              Accept="*"
                              ShowManualUrlInput="true"
                              Category="FileCategory.ArticleAttachment"
                              ReadOnly="ReadOnly"
                              OnUploaded="info => HandleAttachmentUploaded(Block, info)" />

        <label class="editra-label">Nombre del archivo</label>
        <input class="editra-input" placeholder="archivo.pdf" readonly="@ReadOnly"
               @bind="Block.Text" @bind:event="oninput" @bind:after="Changed" />

        <label class="editra-label">Descripción (tipo · tamaño)</label>
        <input class="editra-input" placeholder="Ej: PDF · 2.3 MB" readonly="@ReadOnly"
               @bind="Block.Meta" @bind:event="oninput" @bind:after="Changed" />
    </div>
    break;
```

Y en el `@code` de `EditraBlockEditor.razor`:

```csharp
private async Task HandleAttachmentUploaded(ContentBlock block, EditraMediaUploader.UploadedFileInfo info)
{
    // Solo autocompleta si el usuario no había escrito nada ya
    if (string.IsNullOrWhiteSpace(block.Text))
        block.Text = info.FileName;

    if (string.IsNullOrWhiteSpace(block.Meta))
    {
        var ext = Path.GetExtension(info.FileName).TrimStart('.').ToUpperInvariant();
        block.Meta = $"{ext} · {FormatSize(info.SizeInBytes)}";
    }

    Changed(); // o el método que ya uses para notificar cambios/guardar
}

private static string FormatSize(long bytes) => bytes switch
{
    < 1024 => $"{bytes} B",
    < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
    _ => $"{bytes / (1024.0 * 1024):0.#} MB"
};
```

(Si ya tienes un `FormatSize` como el que vi en tu modal de subida original,
reusa ese en vez de duplicarlo.)

---

## 5. Case `ContentBlockType.ExternalLink`

Este no lleva uploader — sigue siendo puramente un link externo, tal como
lo tienes. No lo toques.

---

## 6. Persistencia al editar (requisito "que al editar sigan saliendo los que están")

Como `Block.Urls` ya es la fuente de verdad (lista de strings) y el
componente solo lee/escribe sobre esa misma lista vía `Urls`/`UrlsChanged`,
al cargar un artículo existente para editar, `Block.Urls` ya viene poblado
desde tu backend → el uploader las va a mostrar automáticamente como
previews en cuanto se renderiza, sin ningún cambio adicional de tu parte.

---

## 7. Pendientes opcionales (mejoras, no bloqueantes)

- **Drag & drop real** en vez de botones subir/bajar: se puede añadir con
  SortableJS + interop JS si luego quieres esa UX más fluida en Gallery.
- **Barra de progreso real** de subida (actualmente solo hay spinner
  indeterminado) — requeriría exponer progreso desde `IFileStorageService`
  o subir por chunks.
- **Borrado físico del storage al quitar** un item: hoy `RemoveAt` solo
  quita la URL del bloque (no borra el archivo del disco/CDN). Si quieres
  que además llame a `IFileStorageService.DeleteAsync(key)`, hay que
  guardar el `key` (no solo la URL pública) junto a cada entrada — puedo
  ayudarte a extender el modelo si te interesa esta limpieza automática.
