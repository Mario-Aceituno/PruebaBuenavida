namespace Domain.ValueObjects;

public sealed record StoredFileUrl
{
    public string Value { get; }

    public StoredFileUrl(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            throw new ArgumentException("La URL del archivo no puede estar vacía.", nameof(value));

        if (!Uri.IsWellFormedUriString(value, UriKind.Absolute))
            throw new ArgumentException("La URL provista no tiene un formato absoluto válido.", nameof(value));

        Value = value;
    }

    public static implicit operator string(StoredFileUrl fileUrl) => fileUrl.Value;
    public override string ToString() => Value;
}
