using Application.Interfaces;

namespace Application.UseCases.Files;

/// <summary>
/// Orquesta la eliminación de un archivo del storage configurado.
/// </summary>
public sealed class DeleteFileUseCase
{
    private readonly IFileStorageService _storageService;

    public DeleteFileUseCase(IFileStorageService storageService)
    {
        _storageService = storageService;
    }

    public async Task<bool> ExecuteAsync(string? key, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(key))
            return false;

        return await _storageService.DeleteAsync(key, cancellationToken);
    }
}