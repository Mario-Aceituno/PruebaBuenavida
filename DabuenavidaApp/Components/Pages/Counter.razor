if (Regex.IsMatch(code, @"^\s*\*{2,}|^\s*[HFDC]\s+|DCL-S\s+\w+|DCL-PROC\s+\w+|EXSR\s+\w+|EVAL\s+\w+\s*=|^\s*C\s+EVAL\b", RegexOptions.Multiline | RegexOptions.IgnoreCase))
    return "rpgle";

if (Regex.IsMatch(code, @"IDENTIFICATION\s+DIVISION|PROCEDURE\s+DIVISION|WORKING-STORAGE\s+SECTION|\bPIC\s+[9XA]|PERFORM\s+\w+(-\w+)*\s*(UNTIL|THRU)?", RegexOptions.IgnoreCase))
    return "cobol";