using Amazon.S3;
using CorpWiki.Application.Interfaces;
using CorpWiki.Infrastructure.Helpers;
//using CorpWiki.Infrastructure.Options;
using CorpWiki.Infrastructure.Persistence;
using CorpWiki.Infrastructure.Security;
using CorpWiki.Infrastructure.Services;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using CorpWiki.Application.UseCases.Files;
using Microsoft.Extensions.Options;
using Microsoft.Extensions.Logging;
namespace CorpWiki.Infrastructure;

/// <summary>
/// Registra todos los servicios de infraestructura: DbContext, proveedores de DB,
/// Active Directory, servicios de seguridad y almacenamiento de archivos.
/// </summary>
public static class InfrastructureServiceExtensions
{
    public static IServiceCollection AddDaviWikiInfrastructure(
        this IServiceCollection services, IConfiguration configuration)
    {
        // --- 1. Configurar DbContext con el proveedor de base de datos seleccionado ---
        var provider = configuration["DatabaseProvider"] ?? "MySQL";
        var connectionString = configuration.GetConnectionString(provider);

        if (string.IsNullOrWhiteSpace(connectionString))
        {
            throw new InvalidOperationException(
                $"No se encontró ConnectionString para el proveedor '{provider}'. " +
                $"Verificá la sección ConnectionStrings:{provider} en appsettings.json.");
        }

        // IMPORTANTE: se usa AddDbContextFactory en lugar de AddDbContext.
        //
        // En Blazor Server / Interactive, un "scope" de DI dura TODO el circuito
        // (toda la sesión del usuario en pestaña), no una sola request HTTP como
        // en una API tradicional. Si el DbContext se registra como Scoped puro
        // (AddDbContext), todos los servicios Scoped del circuito (SecurityService,
        // EfWikiDataService, etc.) terminan compartiendo LA MISMA instancia de
        // DbContext. Como DbContext no es thread-safe ni reentrante, en cuanto dos
        // componentes disparan awaits concurrentes sobre ese mismo contexto
        // (típicamente en el primer render / refresh, cuando el layout, el guard de
        // permisos y la página cargan datos casi al mismo tiempo) EF Core lanza:
        //   "A second operation was started on this context before a previous
        //    operation completed."
        // y esa excepción suele quedar silenciada en algún catch/guard, dejando la
        // UI vacía sin explicación.
        //
        // AddDbContextFactory registra IDbContextFactory<DaviWikiDbContext> como
        // singleton (que es seguro de compartir) y además sigue registrando
        // DaviWikiDbContext scoped por compatibilidad con código existente que lo
        // inyecte directo (p. ej. el seeding en Program.cs). Los servicios que
        // hacen I/O concurrente deben migrar a pedir el factory y crear su propio
        // contexto por operación con CreateDbContextAsync().
        services.AddDbContextFactory<DaviWikiDbContext>(options =>
        {
            switch (provider.ToUpperInvariant())
            {
                case "MYSQL":
                    var serverVersion = ServerVersion.AutoDetect(connectionString);
                    options.UseMySql(connectionString, serverVersion, mysql =>
                    {
                        mysql.MigrationsAssembly(typeof(DaviWikiDbContext).Assembly.FullName);
                        mysql.EnableRetryOnFailure(3);
                    });
                    break;

                case "SQLSERVER":
                    options.UseSqlServer(connectionString, sql =>
                    {
                        sql.MigrationsAssembly(typeof(DaviWikiDbContext).Assembly.FullName);
                        sql.EnableRetryOnFailure(3);
                    });
                    break;

                case "POSTGRESQL":
                    options.UseNpgsql(connectionString, npg =>
                    {
                        npg.MigrationsAssembly(typeof(DaviWikiDbContext).Assembly.FullName);
                        npg.EnableRetryOnFailure(3);
                    });
                    break;

                default:
                    throw new InvalidOperationException(
                        $"Proveedor de base de datos no soportado: '{provider}'. " +
                        "Valores válidos: MySQL, SQLServer, PostgreSQL.");
            }
            options.LogTo(Console.WriteLine, LogLevel.Information).EnableSensitiveDataLogging();
        });

        // --- 2. Registrar el validador de Active Directory (real o simulado) ---
        var simulateAdString = configuration["Security:SimulateAD"];
        var simulateAd = bool.TryParse(simulateAdString, out var parsed) && parsed;

        if (simulateAd)
        {
            services.AddScoped<IActiveDirectoryValidator, SimulatedAdService>();
        }
        else
        {
            services.AddScoped<IActiveDirectoryValidator, ActiveDirectoryService>();
        }

        // --- 3. Registrar servicios de seguridad ---
        services.AddScoped<ISecurityService, SecurityService>();
        services.AddScoped<IAuthenticationService, AuthenticationService>();

        services.Configure<FileStorageOptions>(
            configuration.GetSection(FileStorageOptions.SectionName));
        services.AddHttpContextAccessor();

        // --- 4. Registrar servicio de almacenamiento de archivos ---
        var storageOptions = configuration
            .GetSection(FileStorageOptions.SectionName)
            .Get<FileStorageOptions>();

        if (string.Equals(storageOptions?.Provider, "CloudflareR2", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(storageOptions?.Provider, "S3", StringComparison.OrdinalIgnoreCase))
        {
            services.AddSingleton<IAmazonS3>(_ =>
            {
                var config = new AmazonS3Config
                {
                    ServiceURL = storageOptions.ServiceUrl,
                    ForcePathStyle = true // requerido por R2
                };

                return new AmazonS3Client(storageOptions.AccessKey, storageOptions.SecretKey, config);
            });

            services.AddScoped<IFileStorageService, CloudflareR2StorageService>();
        }
        else
        {
            services.AddScoped<IFileStorageService, LocalFileStorageService>();
        }

        // --- 5. Registrar casos de uso de archivos ---
        var allowedExtensions = new HashSet<string>(
            storageOptions?.AllowedExtensions ?? Array.Empty<string>(),
            StringComparer.OrdinalIgnoreCase);

        services.AddScoped<UploadFileUseCase>(sp =>
            new UploadFileUseCase(
                sp.GetRequiredService<IFileStorageService>(),
                storageOptions?.MaxFileSizeInBytes ?? 20 * 1024 * 1024,
                allowedExtensions));

        services.AddScoped<DeleteFileUseCase>();

        return services;
    }
}







using CorpWiki.Application.Interfaces;
using CorpWiki.Domain.Entities.Security;
using CorpWiki.Infrastructure.Persistence;
using Microsoft.AspNetCore.Components.Authorization;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using System.Security.Claims;

namespace CorpWiki.Infrastructure.Security;

/// <summary>
/// Implementación del servicio RBAC: gestión de usuarios, roles, permisos y auditoría.
/// Ubicado en Infrastructure porque accede directamente al DbContext.
///
/// IMPORTANTE: este servicio es Scoped (vive todo el circuito de Blazor Server).
/// Para evitar que dos operaciones concurrentes (p. ej. el layout pidiendo el
/// usuario actual mientras una página carga datos) compitan por el mismo
/// DbContext, cada método crea su propio contexto aislado vía
/// IDbContextFactory en lugar de reutilizar un DbContext inyectado.
/// </summary>
public class SecurityService : ISecurityService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;
    private readonly ILogger<SecurityService> _logger;
    private readonly AuthenticationStateProvider _authStateProvider;

    public SecurityService(
        IDbContextFactory<DaviWikiDbContext> dbFactory,
        ILogger<SecurityService> logger,
        AuthenticationStateProvider authStateProvider)
    {
        _dbFactory = dbFactory;
        _logger = logger;
        _authStateProvider = authStateProvider;
    }

    // =========================================================================
    // USUARIOS
    // =========================================================================

    public async Task<SecurityUser?> GetUserByUsernameAsync(string username)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityUsers
            .Include(u => u.UserRoles).ThenInclude(ur => ur.Role)
            .FirstOrDefaultAsync(u => u.Username == username);
    }

    public async Task<SecurityUser?> GetUserByIdAsync(Guid userId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityUsers
            .Include(u => u.UserRoles).ThenInclude(ur => ur.Role)
            .FirstOrDefaultAsync(u => u.Id == userId);
    }

    public async Task<Guid> GetCurrentUserIdAsync()
    {
        // No toca la base de datos: no necesita contexto.
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity == null || !user.Identity.IsAuthenticated)
            return Guid.Empty;

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ??
                          user.FindFirst("sub")?.Value ??
                          user.FindFirst("UserId")?.Value;

        if (!string.IsNullOrEmpty(userIdClaim) && Guid.TryParse(userIdClaim, out var userId))
        {
            return userId;
        }

        return Guid.Empty;
    }

    public async Task<List<SecurityUser>> GetAllUsersAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityUsers
            .Include(u => u.UserRoles).ThenInclude(ur => ur.Role)
            .OrderBy(u => u.FullName)
            .ToListAsync();
    }

    public async Task<SecurityUser> ProvisionUserAsync(
        string username, string peopleSoftId, string fullName, string email,
        string department = "", string position = "")
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var user = new SecurityUser
        {
            Id = Guid.NewGuid(),
            Username = username,
            PeopleSoftId = peopleSoftId,
            FullName = fullName,
            Email = email,
            Department = department,
            Position = position,
            IsActive = true,
            CreatedAt = DateTime.UtcNow,
            LastLoginAt = DateTime.UtcNow
        };

        db.SecurityUsers.Add(user);

        // Asignar rol "Lector" por defecto al auto-provisionarse.
        db.SecurityUserRoles.Add(new SecurityUserRole
        {
            UserId = user.Id,
            RoleId = DatabaseSeeder.RoleIds.Reader,
            AssignedAt = DateTime.UtcNow,
            AssignedBy = "SYSTEM"
        });

        await db.SaveChangesAsync();
        _logger.LogInformation("Usuario auto-provisionado: {Username} ({PeopleSoft})", username, peopleSoftId);

        return user;
    }

    public async Task UpdateLastLoginAsync(Guid userId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var user = await db.SecurityUsers.FindAsync(userId);
        if (user != null)
        {
            user.LastLoginAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
        }
    }

    public async Task<bool> ToggleUserActiveAsync(Guid userId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var user = await db.SecurityUsers.FindAsync(userId);
        if (user == null) return false;

        user.IsActive = !user.IsActive;
        await db.SaveChangesAsync();
        return true;
    }

    public async Task<bool> UpdateUserAsync(Guid userId, string fullName, string email, string department, string position, string peopleSoftId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var user = await db.SecurityUsers.FindAsync(userId);
        if (user == null) return false;

        user.FullName = fullName;
        user.Email = email;
        user.Department = department;
        user.Position = position;
        user.PeopleSoftId = peopleSoftId;
        await db.SaveChangesAsync();
        return true;
    }

    // =========================================================================
    // ROLES
    // =========================================================================

    public async Task<List<SecurityRole>> GetAllRolesAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityRoles
            .Include(r => r.UserRoles)
            .OrderBy(r => r.Name)
            .ToListAsync();
    }

    public async Task<SecurityRole?> GetRoleByIdAsync(Guid roleId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityRoles
            .Include(r => r.RolePermissions).ThenInclude(rp => rp.Permission)
            .Include(r => r.RolePermissions).ThenInclude(rp => rp.Screen)
            .FirstOrDefaultAsync(r => r.Id == roleId);
    }

    public async Task<SecurityRole> CreateRoleAsync(string name, string description)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var role = new SecurityRole
        {
            Id = Guid.NewGuid(),
            Name = name,
            Description = description,
            IsSystemRole = false,
            CreatedAt = DateTime.UtcNow
        };

        db.SecurityRoles.Add(role);
        await db.SaveChangesAsync();
        _logger.LogInformation("Rol creado: {RoleName}", name);
        return role;
    }

    public async Task<bool> UpdateRoleAsync(Guid roleId, string name, string description)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var role = await db.SecurityRoles.FindAsync(roleId);
        if (role == null || role.IsSystemRole) return false;

        role.Name = name;
        role.Description = description;
        await db.SaveChangesAsync();
        return true;
    }

    public async Task<bool> DeleteRoleAsync(Guid roleId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var role = await db.SecurityRoles.FindAsync(roleId);
        if (role == null || role.IsSystemRole) return false;

        db.SecurityRoles.Remove(role);
        await db.SaveChangesAsync();
        _logger.LogInformation("Rol eliminado: {RoleName}", role.Name);
        return true;
    }

    public async Task<bool> AssignRoleToUserAsync(Guid userId, Guid roleId, string assignedBy)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var exists = await db.SecurityUserRoles
            .AnyAsync(ur => ur.UserId == userId && ur.RoleId == roleId);

        if (exists) return false;

        db.SecurityUserRoles.Add(new SecurityUserRole
        {
            UserId = userId,
            RoleId = roleId,
            AssignedAt = DateTime.UtcNow,
            AssignedBy = assignedBy
        });

        await db.SaveChangesAsync();
        return true;
    }

    public async Task<bool> RemoveRoleFromUserAsync(Guid userId, Guid roleId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var userRole = await db.SecurityUserRoles
            .FirstOrDefaultAsync(ur => ur.UserId == userId && ur.RoleId == roleId);

        if (userRole == null) return false;

        db.SecurityUserRoles.Remove(userRole);
        await db.SaveChangesAsync();
        return true;
    }

    public async Task<List<SecurityRole>> GetUserRolesAsync(Guid userId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityUserRoles
            .Where(ur => ur.UserId == userId)
            .Include(ur => ur.Role)
            .Select(ur => ur.Role)
            .ToListAsync();
    }

    // =========================================================================
    // PERMISOS
    // =========================================================================

    public async Task<List<SecurityPermission>> GetAllPermissionsAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityPermissions.OrderBy(p => p.Name).ToListAsync();
    }

    // =========================================================================
    // PANTALLAS
    // =========================================================================

    public async Task<List<SecurityScreen>> GetAllScreensAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityScreens
            .OrderBy(s => s.DisplayOrder)
            .ToListAsync();
    }

    // =========================================================================
    // PERMISOS POR ROL Y PANTALLA
    // =========================================================================

    public async Task<List<SecurityRolePermission>> GetRolePermissionsAsync(Guid roleId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityRolePermissions
            .Where(rp => rp.RoleId == roleId)
            .Include(rp => rp.Permission)
            .Include(rp => rp.Screen)
            .ToListAsync();
    }

    public async Task SetRolePermissionAsync(Guid roleId, Guid screenId, Guid permissionId, bool granted)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var existing = await db.SecurityRolePermissions
            .FirstOrDefaultAsync(rp =>
                rp.RoleId == roleId &&
                rp.ScreenId == screenId &&
                rp.PermissionId == permissionId);

        if (granted && existing == null)
        {
            db.SecurityRolePermissions.Add(new SecurityRolePermission
            {
                RoleId = roleId,
                PermissionId = permissionId,
                ScreenId = screenId
            });
        }
        else if (!granted && existing != null)
        {
            db.SecurityRolePermissions.Remove(existing);
        }

        await db.SaveChangesAsync();
    }

    public async Task<bool> UserHasPermissionAsync(Guid userId, string screenCode, string permissionCode)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityUserRoles
            .Where(ur => ur.UserId == userId)
            .SelectMany(ur => ur.Role.RolePermissions)
            .AnyAsync(rp =>
                rp.Screen.Code == screenCode &&
                rp.Permission.Code == permissionCode);
    }

    public async Task<Dictionary<string, List<string>>> GetUserScreenPermissionsAsync(Guid userId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var permissions = await db.SecurityUserRoles
            .Where(ur => ur.UserId == userId)
            .SelectMany(ur => ur.Role.RolePermissions)
            .Include(rp => rp.Screen)
            .Include(rp => rp.Permission)
            .Select(rp => new { ScreenCode = rp.Screen.Code, PermissionCode = rp.Permission.Code })
            .Distinct()
            .ToListAsync();

        return permissions
            .GroupBy(p => p.ScreenCode)
            .ToDictionary(
                g => g.Key,
                g => g.Select(x => x.PermissionCode).ToList());
    }

    // =========================================================================
    // AUDITORÍA
    // =========================================================================

    public async Task LogAuditAsync(Guid? userId, string username, string action, string details = "", string ipAddress = "")
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        db.SecurityAuditLogs.Add(new SecurityAuditLog
        {
            Id = Guid.NewGuid(),
            UserId = userId,
            Username = username,
            Action = action,
            Details = details,
            IpAddress = ipAddress,
            OccurredAt = DateTime.UtcNow
        });

        await db.SaveChangesAsync();
    }

    public async Task<List<SecurityAuditLog>> GetAuditLogsAsync(int count = 100)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.SecurityAuditLogs
            .OrderByDescending(a => a.OccurredAt)
            .Take(count)
            .Include(a => a.User)
            .ToListAsync();
    }
}










using CorpWiki.Application.DTOs;
using CorpWiki.Application.Interfaces;
using CorpWiki.Application.Interfaces.Repositories;
using CorpWiki.Domain.Entities;
using Microsoft.AspNetCore.SignalR;
using Microsoft.EntityFrameworkCore;
using Microsoft.IdentityModel.Tokens;
using System;
using System.Configuration;
using System.Threading.Tasks;

namespace CorpWiki.Infrastructure.Persistence;

/// <summary>
/// Implementación EF Core del servicio principal (Paso 5).
/// Orquesta la transaccionalidad y las relaciones complejas.
///
/// IMPORTANTE: este servicio es Scoped (vive todo el circuito de Blazor Server).
/// Antes recibía un único DaviWikiDbContext también Scoped, compartido con
/// SecurityService y con cualquier otro servicio del mismo circuito. Como
/// DbContext no admite operaciones concurrentes, en el primer render (varios
/// componentes disparando OnInitializedAsync casi al mismo tiempo) esto
/// producía "A second operation was started on this context before a previous
/// operation completed" de forma intermitente.
///
/// Ahora cada método público crea su propio DbContext aislado a través de
/// IDbContextFactory. Los métodos que antes mezclaban _db con los repositorios
/// dentro de una misma transacción (CreateArticleAsync, UpdateArticleAsync)
/// dejaron de usar los repositorios internamente: si dos objetos usan
/// instancias de DbContext distintas no pueden compartir una misma
/// transacción, así que esas operaciones ahora trabajan directo sobre el
/// DbSet del contexto local (db.Articles, etc.) para mantener la
/// transaccionalidad intacta.
/// </summary>
public class EfWikiDataService : IWikiDataService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;
    private readonly ISecurityService _securityService;
    private readonly IArticleRepository _articleRepo;
    private readonly ICategoryRepository _categoryRepo;
    private readonly ITagRepository _tagRepo;
    private readonly IAuthorRepository _authorRepo;
    private readonly IMediaFileRepository _mediaRepo;
    private readonly CorpWiki.Application.Helpers.ISlugGenerator _slugGenerator;
    private readonly ICommentBroadcaster _commentBroadcaster;

    public EfWikiDataService(
        IDbContextFactory<DaviWikiDbContext> dbFactory,
        ISecurityService securityService,
        IArticleRepository articleRepo,
        ICategoryRepository categoryRepo,
        ITagRepository tagRepo,
        IAuthorRepository authorRepo,
        IMediaFileRepository mediaRepo,
        CorpWiki.Application.Helpers.ISlugGenerator slugGenerator,
        ICommentBroadcaster commentBroadcaster)
    {
        _dbFactory = dbFactory;
        _securityService = securityService;
        _articleRepo = articleRepo;
        _categoryRepo = categoryRepo;
        _tagRepo = tagRepo;
        _authorRepo = authorRepo;
        _mediaRepo = mediaRepo;
        _slugGenerator = slugGenerator;
        _commentBroadcaster = commentBroadcaster;
    }

    // Estos pasamanos siguen usando sus repositorios propios (no comparten
    // transacción con nada más), así que no necesitan tocarse.
    public async Task<IReadOnlyList<Article>> GetArticlesAsync() => await _articleRepo.GetAllAsync();
    public async Task<Article?> GetArticleByIdAsync(Guid id, bool track = false) => await _articleRepo.GetByIdAsync(id, track);
    public async Task<Article?> GetArticleBySlugAsync(string slug, bool track = false) => await _articleRepo.GetBySlugAsync(slug, track);

    public async Task<bool> IsFavoriteAsync(Guid articleId)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty)
            return false;

        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.ArticleFavorites.AnyAsync(f => f.UserId == userId && f.ArticleId == articleId);
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "US";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", parts.Take(2).Select(s => s[0])).ToUpper();
    }

    public async Task IncrementArticleViewCountAsync(Guid articleId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var article = await db.Articles.FindAsync(articleId);
        if (article != null)
        {
            article.ViewCount++;
            await db.SaveChangesAsync();
        }
    }

    public async Task<bool> ToggleFavoriteAsync(Guid articleId)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty)
            return false;

        await using var db = await _dbFactory.CreateDbContextAsync();

        var favorite = await db.ArticleFavorites.FirstOrDefaultAsync(f => f.UserId == userId && f.ArticleId == articleId);
        if (favorite != null)
        {
            db.ArticleFavorites.Remove(favorite);
            await db.SaveChangesAsync();
            return false;
        }

        var newFavorite = new ArticleFavorite
        {
            UserId = userId,
            ArticleId = articleId,
            CreatedAt = DateTime.UtcNow
        };

        await db.ArticleFavorites.AddAsync(newFavorite);
        await db.SaveChangesAsync();
        return true;
    }

    public async Task<bool> HasUserRatedAsync(Guid articleId)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return false;

        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.ArticleRatings
            .AnyAsync(r => r.ArticleId == articleId && r.UserId == userId);
    }

    public async Task<double?> GetUserRatingAsync(Guid articleId)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return null;

        await using var db = await _dbFactory.CreateDbContextAsync();

        var score = await db.ArticleRatings
            .Where(r => r.ArticleId == articleId && r.UserId == userId)
            .Select(r => (byte?)r.Score)
            .FirstOrDefaultAsync();

        // Score se guarda en unidades de 0.5 (byte 1-10) -> convertir a double real
        return score is null ? null : score.Value / 2.0;
    }

    public async Task RateArticleAsync(Guid articleId, double score)
    {
        if (score < 0.5 || score > 5.0 || (score * 2) % 1 != 0)
            throw new ArgumentOutOfRangeException(nameof(score), "La puntuación debe ir de 0.5 a 5.0 en pasos de 0.5.");

        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty)
            throw new UnauthorizedAccessException("Debes iniciar sesión para calificar.");

        var byteScore = (byte)Math.Round(score * 2);

        await using var db = await _dbFactory.CreateDbContextAsync();

        var existing = await db.ArticleRatings
            .FirstOrDefaultAsync(r => r.ArticleId == articleId && r.UserId == userId);

        if (existing is null)
        {
            db.ArticleRatings.Add(new ArticleRating
            {
                Id = Guid.NewGuid(),
                ArticleId = articleId,
                UserId = userId,
                Score = byteScore,
                CreatedAt = DateTime.UtcNow
            });
        }
        else
        {
            existing.Score = byteScore; // actualiza en lugar de duplicar o crear una nueva
        }

        await db.SaveChangesAsync();
        await RecalculateArticleRatingAsync(db, articleId);
    }

    // Recalcular promedio (convirtiendo cada Score de unidades de 0.5 a real) y cantidad.
    // Recibe el mismo "db" que la llamada que lo originó para no abrir un segundo
    // contexto en medio de la misma operación lógica.
    private async Task RecalculateArticleRatingAsync(DaviWikiDbContext db, Guid articleId)
    {
        var ratings = await db.ArticleRatings
            .Where(r => r.ArticleId == articleId)
            .Select(r => (int)r.Score)
            .ToListAsync();

        var article = await db.Articles.FirstOrDefaultAsync(a => a.Id == articleId);
        if (article is not null)
        {
            article.Rating = ratings.Count == 0 ? 0 : ratings.Average(s => s / 2.0);
            article.RatingCount = ratings.Count;

            await db.SaveChangesAsync();
        }
    }

    public async Task<IReadOnlyList<Article>> GetFeaturedArticlesAsync(int count = 10)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var articles = await db.Articles
            .Where(a => a.ViewCount > 0 || a.RatingCount > 0)
            .ToListAsync();

        if (articles.Count == 0) return Array.Empty<Article>();

        var maxViews = articles.Max(a => a.ViewCount);
        var maxRatingCount = articles.Max(a => a.RatingCount);

        double Score(Article a)
        {
            var viewsNorm = maxViews == 0 ? 0 : (double)a.ViewCount / maxViews;
            var ratingCountNorm = maxRatingCount == 0 ? 0 : (double)a.RatingCount / maxRatingCount;
            var ratingNorm = a.Rating / 5.0;

            return (viewsNorm * 0.4) + (ratingNorm * 0.4) + (ratingCountNorm * 0.2);
        }

        var topFeatured = articles
            .OrderByDescending(Score)
            .Take(count)
            .ToList();

        foreach (var article in topFeatured)
        {
            article.IsFeatured = true;
        }

        return topFeatured;
    }

