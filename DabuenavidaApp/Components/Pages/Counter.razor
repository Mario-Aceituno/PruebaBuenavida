    public async Task<IReadOnlyList<CommentDto>> GetCommentsByArticleAsync(Guid articleId)
    {
        var currentUserId = await _securityService.GetCurrentUserIdAsync();

        await using var db = await _dbFactory.CreateDbContextAsync();

        var all = await db.ArticleComments
            .Include(c => c.User)
            .Where(c => c.ArticleId == articleId)
            .OrderBy(c => c.CreatedAt)
            .ToListAsync();

        if (all.Count == 0) return new List<CommentDto>();

        var likeCounts = await db.ArticleCommentLikes
            .Where(l => db.ArticleComments.Any(c => c.Id == l.CommentId && c.ArticleId == articleId))
            .GroupBy(l => l.CommentId)
            .Select(g => new { CommentId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.CommentId, x => x.Count);

        var likedByMe = currentUserId != Guid.Empty
            ? (await db.ArticleCommentLikes
                .Where(l => l.UserId == currentUserId && db.ArticleComments.Any(c => c.Id == l.CommentId && c.ArticleId == articleId))
                .Select(l => l.CommentId)
                .ToListAsync()).ToHashSet()
            : new HashSet<Guid>();

        // Mapa comentario -> raiz de su hilo, y comentario -> autor (para menciones)
        var byId = all.ToDictionary(c => c.Id);
        Guid GetRootId(ArticleComment c)
        {
            var current = c;
            while (current.ParentCommentId is Guid pid && byId.TryGetValue(pid, out var parent))
                current = parent;
            return current.Id;
        }

        CommentDto Map(ArticleComment c)
        {
            var dto = new CommentDto
            {
                Id = c.Id,
                ParentCommentId = c.ParentCommentId,
                Content = c.Content,
                CreatedAt = c.CreatedAt,
                UpdatedAt = c.UpdatedAt,
                AuthorName = c.User?.FullName ?? "Usuario",
                AuthorInitials = GetInitials(c.User?.FullName),
                AuthorColorFrom = c.User?.AvatarColorFrom ?? "#6366f1",
                AuthorColorTo = c.User?.AvatarColorTo ?? "#8b5cf6",
                LikesCount = likeCounts.TryGetValue(c.Id, out var lc) ? lc : 0,
                IsLikedByCurrentUser = likedByMe.Contains(c.Id),
                CanEditOrDelete = currentUserId != Guid.Empty && c.UserId == currentUserId,
                UserId = c.UserId
            };
            return dto;
        }

        var roots = all.Where(c => c.ParentCommentId == null)
            .OrderBy(c => c.CreatedAt)
            .Select(Map)
            .ToList();

        var rootsById = roots.ToDictionary(r => r.Id);
        // Aplanar: cualquier comentario cuya raiz de hilo sea un root, va a Replies de ese root
        foreach (var c in all.Where(c => c.ParentCommentId != null).OrderBy(c => c.CreatedAt))
        {
            var rootId = GetRootId(c);
            if (!rootsById.TryGetValue(rootId, out var rootDto)) continue;
            var replyDto = Map(c);
            // Si respondió a otra respuesta (no a la raíz), guardar mención
            if (c.ParentCommentId != rootId && byId.TryGetValue(c.ParentCommentId!.Value, out var directParent))
            {
                replyDto.ReplyingToCommentId = directParent.Id;
                replyDto.ReplyingToAuthorName = directParent.User?.FullName ?? "Usuario";
            }
            rootDto.Replies.Add(replyDto);
        }

        return roots;
    }

    public async Task<CommentDto> CreateCommentAsync(Guid articleId, Guid? parentCommentId, string content)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) throw new InvalidOperationException("Usuario no autenticado.");
        if (string.IsNullOrWhiteSpace(content)) throw new ArgumentException("El comentario no puede estar vacio.");

        await using var db = await _dbFactory.CreateDbContextAsync();

        var comment = new ArticleComment
        {
            Id = Guid.NewGuid(),
            ArticleId = articleId,
            UserId = userId,
            ParentCommentId = parentCommentId,
            Content = content.Trim(),
            CreatedAt = DateTime.UtcNow,
            IsDeleted = false
        };

        db.ArticleComments.Add(comment);
        await db.SaveChangesAsync();
        await CreateNotificationForNewCommentAsync(db, comment, userId);

        var saved = await db.ArticleComments.Include(c => c.User)
            .FirstAsync(c => c.Id == comment.Id);

        var dto = new CommentDto
        {
            Id = saved.Id,
            ParentCommentId = saved.ParentCommentId,
            Content = saved.Content,
            CreatedAt = saved.CreatedAt,
            UserId = saved.UserId,
            AuthorName = saved.User?.FullName ?? "Usuario",
            AuthorInitials = GetInitials(saved.User?.FullName),
            AuthorColorFrom = saved.User?.AvatarColorFrom ?? "#6366f1",
            AuthorColorTo = saved.User?.AvatarColorTo ?? "#8b5cf6",
            CanEditOrDelete = true
        };

        await _commentBroadcaster.CommentAddedAsync(articleId, dto);
        return dto;
    }

    public async Task<bool> UpdateCommentAsync(Guid commentId, string content)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return false;
        if (string.IsNullOrWhiteSpace(content)) return false;

        await using var db = await _dbFactory.CreateDbContextAsync();

        var comment = await db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
        if (comment is null || comment.UserId != userId) return false;

        comment.Content = content.Trim();
        comment.UpdatedAt = DateTime.UtcNow;

        await db.SaveChangesAsync();

        var updated = await db.ArticleComments.Include(c => c.User).FirstAsync(c => c.Id == commentId);
        var likesCount = await db.ArticleCommentLikes.CountAsync(l => l.CommentId == commentId);
        var isLikedByCurrentUser = await db.ArticleCommentLikes.AnyAsync(l => l.CommentId == commentId && l.UserId == userId);

        var dto = new CommentDto
        {
            Id = updated.Id,
            ParentCommentId = updated.ParentCommentId,
            Content = updated.Content,
            CreatedAt = updated.CreatedAt,
            UpdatedAt = updated.UpdatedAt,
            UserId = updated.UserId,
            AuthorName = updated.User?.FullName ?? "Usuario",
            AuthorInitials = GetInitials(updated.User?.FullName),
            AuthorColorFrom = updated.User?.AvatarColorFrom ?? "#6366f1",
            AuthorColorTo = updated.User?.AvatarColorTo ?? "#8b5cf6",
            LikesCount = likesCount,
            IsLikedByCurrentUser = isLikedByCurrentUser,
            CanEditOrDelete = true,
        };

        await _commentBroadcaster.CommentUpdatedAsync(updated.ArticleId, dto);
        return true;
    }

    public async Task<bool> DeleteCommentAsync(Guid commentId)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return false;

        await using var db = await _dbFactory.CreateDbContextAsync();

        var root = await db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
        if (root is null || root.UserId != userId) return false;

        var allInArticle = await db.ArticleComments
            .Where(c => c.ArticleId == root.ArticleId)
            .ToListAsync();

        var toDelete = new List<ArticleComment> { root };
        var frontier = new HashSet<Guid> { root.Id };

        while (frontier.Count > 0)
        {
            var children = allInArticle
                .Where(c => c.ParentCommentId is Guid pid && frontier.Contains(pid))
                .ToList();

            if (children.Count == 0) break;

            toDelete.AddRange(children);
            frontier = children.Select(c => c.Id).ToHashSet();
        }

        var articleId = root.ArticleId;

        // La transacción manual debe envolverse en la execution strategy configurada
        // (EnableRetryOnFailure), o EF Core rechaza el BeginTransactionAsync directo.
        var strategy = db.Database.CreateExecutionStrategy();
        await strategy.ExecuteAsync(async () =>
        {
            await using var tx = await db.Database.BeginTransactionAsync();
            try
            {
                for (int i = toDelete.Count - 1; i >= 0; i--)
                {
                    db.ArticleComments.Remove(toDelete[i]);
                    await db.SaveChangesAsync();
                }

                await tx.CommitAsync();
            }
            catch
            {
                await tx.RollbackAsync();
                throw;
            }
        });

        var deletedIds = toDelete.Select(c => c.Id).ToArray();
        await _commentBroadcaster.CommentDeletedAsync(articleId, deletedIds);
        return true;
    }

    public async Task<bool> ToggleCommentLikeAsync(Guid commentId)
    {
        var userId = await _securityService.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return false;

        await using var db = await _dbFactory.CreateDbContextAsync();

        var existing = await db.ArticleCommentLikes
            .FirstOrDefaultAsync(l => l.CommentId == commentId && l.UserId == userId);

        bool liked;
        if (existing != null)
        {
            db.ArticleCommentLikes.Remove(existing);
            liked = false;
        }
        else
        {
            db.ArticleCommentLikes.Add(new ArticleCommentLike
            {
                CommentId = commentId,
                UserId = userId,
                CreatedAt = DateTime.UtcNow
            });
            liked = true;
        }

        await db.SaveChangesAsync();

        if (liked)
        {
            var comment = await db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
            if (comment != null && comment.UserId != userId)
            {
                db.Notifications.Add(new Notification
                {
                    Id = Guid.NewGuid(),
                    RecipientUserId = comment.UserId,
                    ActorUserId = userId,
                    CommentId = comment.Id,
                    Type = NotificationType.CommentLike,
                    CreatedAt = DateTime.UtcNow
                });

                await db.SaveChangesAsync();
            }
        }

        var likesCount = await db.ArticleCommentLikes.CountAsync(l => l.CommentId == commentId);
        var articleId = (await db.ArticleComments.FirstAsync(c => c.Id == commentId)).ArticleId;
        await _commentBroadcaster.CommentLikeToggledAsync(articleId, commentId, likesCount, userId, liked);
        return liked;
    }

    private async Task CreateNotificationForNewCommentAsync(DaviWikiDbContext db, ArticleComment comment, Guid actorUserId)
    {
        if (comment.ParentCommentId is null)
        {
            var article = await db.Articles.FirstOrDefaultAsync(a => a.Id == comment.ArticleId);
            if (article is null) return;

            var author = await db.Authors.FirstOrDefaultAsync(a => a.Id == article.AuthorId);
            if (author?.SecurityUserId is not Guid recipientId || recipientId == actorUserId) return;

            db.Notifications.Add(new Notification
            {
                Id = Guid.NewGuid(),
                RecipientUserId = recipientId,
                ActorUserId = actorUserId,
                CommentId = comment.Id,
                Type = NotificationType.CommentOnArticle,
                CreatedAt = DateTime.UtcNow
            });

            await db.SaveChangesAsync();
        }
        else
        {
            var parent = await db.ArticleComments.FirstOrDefaultAsync(c => c.Id == comment.ParentCommentId);
            if (parent is null || parent.UserId == actorUserId) return;

            db.Notifications.Add(new Notification
            {
                Id = Guid.NewGuid(),
                RecipientUserId = parent.UserId,
                ActorUserId = actorUserId,
                CommentId = comment.Id,
                Type = NotificationType.ReplyToComment,
                CreatedAt = DateTime.UtcNow
            });

            await db.SaveChangesAsync();
        }
    }

