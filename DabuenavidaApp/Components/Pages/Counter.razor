@* --- RoleManagement.razor (Sección Modal Mejorada) --- *@

@if (_showCreateModal)
{
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal modal--xl" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="createRoleTitle">
            
            @* Header *@
            <div class="modal__header">
                <div>
                    <h3 id="createRoleTitle" class="modal__title">Crear nuevo rol</h3>
                    <p class="modal__subtitle">Configure las propiedades generales y establezca los permisos por módulo.</p>
                </div>
                <button type="button" class="btn-icon btn-icon--ghost" @onclick="CloseCreateModal" aria-label="Cerrar">
                    <Icon Name="x" />
                </button>
            </div>

            @* Body *@
            <div class="modal__body modal__body--scrollable">
                
                @* 1. Información General & Herencia *@
                <div class="form-grid form-grid--3-cols">
                    <div class="form-group">
                        <label class="form-label" for="roleName">Nombre <span class="form-required">*</span></label>
                        <input id="roleName" class="form-control" placeholder="Ej: Colaborador externo" @bind="_newRoleName" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="roleDesc">Descripción</label>
                        <input id="roleDesc" class="form-control" placeholder="Para qué se usa este rol" @bind="_newRoleDescription" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="inheritRole">Heredar permisos de</label>
                        <select id="inheritRole" class="form-control" @onchange="OnInheritRoleChanged">
                            <option value="">-- Sin plantilla (Vacío) --</option>
                            @foreach (var role in _roles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <hr class="modal-divider" />

                @* 2. Encabezado de Permisos y Presets Masivos *@
                <div class="permissions-header">
                    <div>
                        <h4 class="permissions-header__title">Matriz de Permisos</h4>
                        <span class="permissions-header__count">
                            <strong>@_newRolePermissionCount</strong> de <strong>@_maxPossiblePermissions</strong> seleccionados
                        </span>
                    </div>

                    <div class="permissions-toolbar">
                        <div class="search-box">
                            <Icon Name="search" />
                            <input type="text" class="search-box__input" placeholder="Buscar pantalla..." 
                                   @bind="_screenSearchModal" @bind:event="oninput" />
                        </div>

                        <div class="preset-group">
                            <span class="preset-group__label">Aplicar a todas:</span>
                            <div class="segmented-control">
                                <button type="button" class="segmented-btn" @onclick='() => ApplyPresetToAllNewRole("none")'>Ninguno</button>
                                <button type="button" class="segmented-btn" @onclick='() => ApplyPresetToAllNewRole("read")'>Lectura</button>
                                <button type="button" class="segmented-btn" @onclick='() => ApplyPresetToAllNewRole("write")'>Editor</button>
                                <button type="button" class="segmented-btn" @onclick='() => ApplyPresetToAllNewRole("admin")'>Total</button>
                            </div>
                        </div>
                    </div>
                </div>

                @* 3. Lista de Módulos / Pantallas *@
                <div class="matrix-grid">
                    @foreach (var s in FilteredScreensModal)
                    {
                        <div class="matrix-card">
                            <div class="matrix-card__header">
                                <span class="matrix-card__title">@s.Name</span>
                                <span class="matrix-card__preset-badge">
                                    @GetNewRolePreset(s.Id)
                                </span>
                            </div>

                            <div class="matrix-card__pills">
                                @foreach (var p in _permissions)
                                {
                                    var key = (s.Id, p.Id);
                                    var isOn = _newRoleMatrix.GetValueOrDefault(key);
                                    var visual = GetPermVisual(p.Code);

                                    <button type="button" 
                                            class="perm-chip @(isOn ? $"perm-chip--active perm-chip--{p.Code.ToLower()}" : "")"
                                            aria-pressed="@isOn"
                                            @onclick="() => ToggleNewRolePermission(s.Id, p.Id, !isOn)">
                                        <Icon Name="@(isOn ? "check" : "plus")" Size="14" />
                                        <span>@visual.Label</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>

            @* Footer *@
            <div class="modal__footer">
                <button type="button" class="btn btn--secondary" @onclick="CloseCreateModal">Cancelar</button>
                <button type="button" class="btn btn--primary" 
                        disabled="@string.IsNullOrWhiteSpace(_newRoleName)" 
                        @onclick="CreateRole">
                    Crear rol
                </button>
            </div>

        </div>
    </div>
}





@* --- Código C# Acompañante para la Herencia de Roles --- *@
@code {
    private async Task OnInheritRoleChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();
        if (Guid.TryParse(rawValue, out var selectedRoleId))
        {
            var targetRole = _roles.FirstOrDefault(r => r.Id == selectedRoleId);
            if (targetRole != null)
            {
                // Carga los permisos del rol seleccionado y los asigna a la matriz actual
                var granted = await SecurityService.GetRolePermissionsAsync(targetRole.Id);
                
                // Reiniciar matriz
                foreach (var s in _screens)
                {
                    foreach (var p in _permissions)
                    {
                        _newRoleMatrix[(s.Id, p.Id)] = false;
                    }
                }

                // Aplicar permisos del rol base
                foreach (var rp in granted)
                {
                    _newRoleMatrix[(rp.ScreenId, rp.PermissionId)] = true;
                }
            }
        }
    }
}






/* --- CSS Sugerido para el Estilo Premium --- */

/* Modal Layout */
.modal--xl {
    width: 90vw;
    max-width: 1000px;
    border-radius: 12px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.form-grid--3-cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
}

.modal-divider {
    border: 0;
    border-top: 1px solid var(--border-color, #e5e7eb);
    margin: 20px 0;
}

/* Toolbar & Presets */
.permissions-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 16px;
}

.permissions-toolbar {
    display: flex;
    align-items: center;
    gap: 16px;
}

.preset-group {
    display: flex;
    align-items: center;
    gap: 8px;
}

.preset-group__label {
    font-size: 0.85rem;
    color: var(--text-muted, #6b7280);
    white-space: nowrap;
}

.segmented-control {
    display: inline-flex;
    background: #f3f4f6;
    padding: 2px;
    border-radius: 8px;
}

.segmented-btn {
    border: none;
    background: transparent;
    padding: 4px 10px;
    font-size: 0.8rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.segmented-btn:hover {
    background: #e5e7eb;
}

/* Chips de Permisos */
.matrix-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.matrix-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 12px 16px;
}

.matrix-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.matrix-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.perm-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid #d1d5db;
    background: #f9fafb;
    color: #374151;
    font-size: 0.825rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.perm-chip--active {
    background: #e0f2fe;
    border-color: #0284c7;
    color: #0369a1;
    font-weight: 500;
}
