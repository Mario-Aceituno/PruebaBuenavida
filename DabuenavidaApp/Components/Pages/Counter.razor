@if (_showConfirmModal)
{
    <div class="modal-overlay">
        <div class="modal">
            <div class="modal__header">
                <h3>@_confirmTitle</h3>
            </div>
            <div class="modal__body">
                <p>@_confirmMessage</p>
            </div>
            <div class="modal__footer">
                <button class="btn btn--ghost btn--sm" @onclick="CloseConfirmModal">No, cancelar</button>
                <button class="btn @_confirmButtonClass btn--sm" @onclick="ConfirmPendingAction">@_confirmButtonText</button>
            </div>
        </div>
    </div>
}