@if (_showCreateModal)
{
    <div class="role-modal-overlay" @onclick="CloseCreateModal">
        <div class="role-modal" @onclick:stopPropagation="true" role="dialog">
            
            @* Header Pro *@
            <header class="role-modal__header">
                <div class="role-modal__header-info">
                    <div class="role-modal__icon-badge">
                        <Icon Name="shield-plus" Size="20" />
                    </div>
                    <div>
                        <h2>Crear nuevo rol</h2>
                        <p>Configure los datos principales y asigne los accesos por módulo.</p>
                    </div>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseCreateModal">
                    <Icon Name="x" Size="18" />
                </button>
            </header>

            <div class="role-modal__body">
                
                @* 1. Datos Básicos *@
                <section class="form-section">
                    <div class="form-grid">
                        <div class="field-group">
                            <label for="roleName">Nombre del rol <span class="req">*</span></label>
                            <input id="roleName" type="text" class="custom-input" 
                                   placeholder="Ej: Gestor Operativo" @bind="_newRoleName" />
                        </div>
                        <div class="field-group">
                            <label for="roleDesc">Descripción</label>
                            <input id="roleDesc" type="text" class="custom-input" 
                                   placeholder="Objetivo o alcance de este rol..." @bind="_newRoleDescription" />
                        </div>
                    </div>
                </section>

                @* 2. Flujo Descriptivo de Herencia (Role Preset Picker) *@
                <section class="inheritance-section">
                    <div class="inheritance-section__header">
                        <div>
                            <span class="section-tag">Plantilla de Permisos</span>
                            <h3>¿Desea partir de un rol existente?</h3>
                            <p>Copia automáticamente los permisos del rol seleccionado para ahorrar tiempo.</p>
                        </div>
                        @if (_selectedInheritRole != null)
                        {
                            <button type="button" class="btn-link-danger" @onclick="ClearInheritance">
                                <Icon Name="trash-2" Size="14" /> Quitar plantilla
                            </button>
                        }
                    </div>

                    <div class="role-picker-grid">
                        <div class="role-picker-card @(_selectedInheritRole == null ? "is-selected" : "")"
                             @onclick="ClearInheritance">
                            <div class="role-picker-card__radio"></div>
                            <div class="role-picker-card__content">
                                <span class="role-picker-card__title">Desde cero</span>
                                <span class="role-picker-card__desc">Sin permisos asignados de inicio</span>
                            </div>
                        </div>

                        @foreach (var role in _roles)
                        {
                            var isSelected = _selectedInheritRole?.Id == role.Id;
                            var permCount = GetPermissionCount(role.Id);

                            <div class="role-picker-card @(isSelected ? "is-selected" : "")"
                                 @onclick="() => SelectInheritRole(role)">
                                <div class="role-picker-card__radio"></div>
                                <div class="role-picker-card__content">
                                    <div class="role-picker-card__top">
                                        <span class="role-picker-card__title">@role.Name</span>
                                        <span class="role-picker-card__badge">@permCount permisos</span>
                                    </div>
                                    <span class="role-picker-card__desc">
                                        @(string.IsNullOrWhiteSpace(role.Description) ? "Sin descripción" : role.Description)
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                @* 3. Matriz de Permisos Optimizada *@
                <section class="matrix-section">
                    <div class="matrix-toolbar">
                        <div class="matrix-toolbar__summary">
                            <h3>Matriz de accesos</h3>
                            <span class="matrix-counter">
                                <strong>@_newRolePermissionCount</strong> de @_maxPossiblePermissions activos
                            </span>
                        </div>

                        <div class="matrix-toolbar__actions">
                            <div class="search-input-wrapper">
                                <Icon Name="search" Size="16" />
                                <input type="text" placeholder="Buscar módulo..." 
                                       @bind="_screenSearchModal" @bind:event="oninput" />
                            </div>

                            <div class="bulk-presets">
                                <span class="bulk-label">Acciones globales:</span>
                                <div class="button-group">
                                    <button type="button" @onclick='() => ApplyPresetToAllNewRole("none")'>Sin acceso</button>
                                    <button type="button" @onclick='() => ApplyPresetToAllNewRole("read")'>Lectura</button>
                                    <button type="button" @onclick='() => ApplyPresetToAllNewRole("write")'>Editor</button>
                                    <button type="button" @onclick='() => ApplyPresetToAllNewRole("admin")'>Total</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="screens-list">
                        @foreach (var s in FilteredScreensModal)
                        {
                            <div class="screen-row">
                                <div class="screen-row__info">
                                    <span class="screen-row__title">@s.Name</span>
                                </div>

                                <div class="screen-row__pills">
                                    @foreach (var p in _permissions)
                                    {
                                        var key = (s.Id, p.Id);
                                        var isOn = _newRoleMatrix.GetValueOrDefault(key);
                                        var visual = GetPermVisual(p.Code);

                                        <button type="button" 
                                                class="perm-toggle-chip @(isOn ? $"is-active code--{p.Code.ToLower()}" : "")"
                                                @onclick="() => ToggleNewRolePermission(s.Id, p.Id, !isOn)">
                                            <Icon Name="@(isOn ? "check" : "plus")" Size="13" />
                                            <span>@visual.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>

            </div>

            @* Footer *@
            <footer class="role-modal__footer">
                <button type="button" class="btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
                <button type="button" class="btn-primary" 
                        disabled="@string.IsNullOrWhiteSpace(_newRoleName)" 
                        @onclick="CreateRole">
                    Guardar y crear rol
                </button>
            </footer>

        </div>
    </div>
}









@code {
    private SecurityRole? _selectedInheritRole = null;

    private async Task SelectInheritRole(SecurityRole role)
    {
        _selectedInheritRole = role;
        
        // Cargar permisos del rol elegido
        var granted = await SecurityService.GetRolePermissionsAsync(role.Id);
        
        // Limpiar matriz
        foreach (var s in _screens)
        {
            foreach (var p in _permissions)
            {
                _newRoleMatrix[(s.Id, p.Id)] = false;
            }
        }

        // Marcar permisos del rol copiado
        foreach (var rp in granted)
        {
            _newRoleMatrix[(rp.ScreenId, rp.PermissionId)] = true;
        }
    }

    private void ClearInheritance()
    {
        _selectedInheritRole = null;
        foreach (var s in _screens)
        {
            foreach (var p in _permissions)
            {
                _newRoleMatrix[(s.Id, p.Id)] = false;
            }
        }
    }

    private int GetPermissionCount(Guid roleId)
    {
        return _rolePermissionCounts.GetValueOrDefault(roleId, 0);
    }
}







/* Modal Wrapper */
.role-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
}

.role-modal {
    background: #ffffff;
    width: 100%;
    max-width: 960px;
    max-height: 90vh;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.role-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 28px;
    border-bottom: 1px solid #f1f5f9;
}

.role-modal__header-info {
    display: flex;
    align-items: center;
    gap: 14px;
}

.role-modal__icon-badge {
    width: 42px;
    height: 42px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.role-modal__header h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0f172a;
    margin: 0;
}

.role-modal__header p {
    font-size: 0.875rem;
    color: #64748b;
    margin: 2px 0 0 0;
}

.btn-close-modal {
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 6px;
    border-radius: 8px;
    transition: background 0.2s;
}

.btn-close-modal:hover {
    background: #f1f5f9;
    color: #0f172a;
}

.role-modal__body {
    padding: 24px 28px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
}

/* Form Fields */
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.field-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: #334155;
    margin-bottom: 6px;
}

.field-group .req {
    color: #ef4444;
}

.custom-input {
    width: 100%;
    padding: 9px 13px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.custom-input:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

/* Inheritance Cards */
.inheritance-section {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px 20px;
}

.inheritance-section__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.section-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #2563eb;
}

.inheritance-section h3 {
    font-size: 0.975rem;
    font-weight: 600;
    color: #1e293b;
    margin: 2px 0;
}

.inheritance-section p {
    font-size: 0.825rem;
    color: #64748b;
    margin: 0;
}

.role-picker-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
}

.role-picker-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.role-picker-card:hover {
    border-color: #93c5fd;
    background: #faf5ff;
}

.role-picker-card.is-selected {
    border-color: #2563eb;
    background: #eff6ff;
    box-shadow: 0 0 0 1px #2563eb;
}

.role-picker-card__radio {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid #cbd5e1;
    margin-top: 2px;
    flex-shrink: 0;
}

.role-picker-card.is-selected .role-picker-card__radio {
    border-color: #2563eb;
    background: #2563eb;
    box-shadow: inset 0 0 0 3px #ffffff;
}

.role-picker-card__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0f172a;
}

.role-picker-card__badge {
    font-size: 0.725rem;
    background: #e2e8f0;
    color: #475569;
    padding: 2px 6px;
    border-radius: 4px;
}

.role-picker-card__desc {
    display: block;
    font-size: 0.775rem;
    color: #64748b;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Permissions Matrix */
.matrix-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 16px;
}

.matrix-toolbar__summary h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: #0f172a;
}

.matrix-counter {
    font-size: 0.825rem;
    color: #64748b;
}

.matrix-toolbar__actions {
    display: flex;
    align-items: center;
    gap: 14px;
}

.search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.search-input-wrapper icon {
    position: absolute;
    left: 10px;
    color: #94a3b8;
}

.search-input-wrapper input {
    padding: 7px 12px 7px 32px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.85rem;
    width: 180px;
}

.bulk-presets {
    display: flex;
    align-items: center;
    gap: 8px;
}

.bulk-label {
    font-size: 0.8rem;
    color: #64748b;
}

.button-group {
    display: inline-flex;
    background: #f1f5f9;
    padding: 3px;
    border-radius: 8px;
}

.button-group button {
    border: none;
    background: transparent;
    padding: 4px 10px;
    font-size: 0.775rem;
    font-weight: 500;
    color: #475569;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.button-group button:hover {
    background: #ffffff;
    color: #0f172a;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

/* Rows & Chips */
.screens-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.screen-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    transition: border-color 0.15s;
}

.screen-row:hover {
    border-color: #cbd5e1;
}

.screen-row__title {
    font-size: 0.9rem;
    font-weight: 500;
    color: #1e293b;
}

.screen-row__pills {
    display: flex;
    gap: 8px;
}

.perm-toggle-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
}

.perm-toggle-chip:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
}

.perm-toggle-chip.is-active {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
}

/* Footer Buttons */
.role-modal__footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding: 16px 28px;
    border-top: 1px solid #f1f5f9;
    background: #f8fafc;
}

.btn-secondary {
    padding: 9px 18px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
}

.btn-primary {
    padding: 9px 18px;
    border: none;
    background: #2563eb;
    color: #ffffff;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-primary:hover:not(:disabled) {
    background: #1d4ed8;
}

.btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
