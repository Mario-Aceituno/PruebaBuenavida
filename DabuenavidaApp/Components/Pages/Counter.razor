@keyframes journeyContentIn {

    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}

Div1

<div class="journey-section journey-section--delay-1"
     style="display:flex; gap:var(--space-3); margin-bottom:var(--space-5); flex-wrap:wrap;"> 

Div2

<h4 class="widget__title journey-section journey-section--delay-2"
    style="font-size:var(--fs-sm); margin-bottom:var(--space-2);">
    <Icon Name="users" />Personas del equipo
</h4>

H4
<h4 class="widget__title journey-section journey-section--delay-3"
    style="font-size:var(--fs-sm); margin-bottom:var(--space-2);">
    Qué hizo el equipo
</h4> 

.journey-section {

    animation: journeySectionIn .25s ease both;

}


.journey-section--delay-1 {
    animation-delay: .05s;
}


.journey-section--delay-2 {
    animation-delay: .12s;
}


.journey-section--delay-3 {
    animation-delay: .20s;
}



@keyframes journeySectionIn {

    from {
        opacity: 0;
        transform: translateY(10px);
    }


    to {
        opacity: 1;
        transform: translateY(0);
    }

}