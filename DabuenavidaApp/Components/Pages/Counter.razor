}

<SecurityConfirmDialog Visible="_confirmingDelete is not null"
                       Title="Eliminar rol"
                       Message="@($"El rol '{_confirmingDelete?.Name}' se eliminará. Los usuarios que lo tengan asignado quedarán sin ese rol (podrían conservar otros). Esta acción no se puede deshacer.")"
                       ConfirmText="Eliminar"
                       Dangerous="true"
                       OnConfirm="DeleteRole"
                       OnCancel="() => _confirmingDelete = null" />

@if (_showToast)
{
    <div class="toast" role="status" aria-live="polite"><Icon Name="check-circle" /> @_toastMessage</div>
}

@code {
    private List<SecurityRole> _roles = new();
    private bool _loading = true;
    private bool _canWrite;
    private bool _showCreateModal;
    private string _newRoleName = "";
    private string _newRoleDescription = "";
    private string _actingUser = "unknown";
    private string _searchTerm = "";
    private SecurityRole? _confirmingDelete;
    private bool _showToast;
    private string _toastMessage = "";

    private IReadOnlyList<SecurityRole> FilteredRoles =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _roles
            : _roles.Where(r => r.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _roles = await SecurityService.GetAllRolesAsync();
        _loading = false;
    }

    private void GoToMatrix(Guid roleId) => Navigation.NavigateTo($"/admin/seguridad/roles/{roleId}/permisos");

    private async Task CreateRole()
    {
        if (!_canWrite || string.IsNullOrWhiteSpace(_newRoleName)) return;

        var role = await SecurityService.CreateRoleAsync(_newRoleName.Trim(), _newRoleDescription.Trim());
        await SecurityService.LogAuditAsync(null, _actingUser, "ROLE_CREATED", $"Rol creado: {role.Name}");

        _newRoleName = "";
        _newRoleDescription = "";
        _showCreateModal = false;
        _roles = await SecurityService.GetAllRolesAsync();

        _toastMessage = "Rol creado correctamente.";
        await ShowToast();
    }

    private async Task DeleteRole()
    {
        var role = _confirmingDelete;
        _confirmingDelete = null;
        if (!_canWrite || role is null || role.IsSystemRole) return;

        await SecurityService.DeleteRoleAsync(role.Id);
        await SecurityService.LogAuditAsync(null, _actingUser, "ROLE_DELETED", $"Rol eliminado: {role.Name}");

        _roles = await SecurityService.GetAllRolesAsync();
        _toastMessage = "Rol eliminado.";
        await ShowToast();
    }

    private async Task ShowToast()
    {
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }
}













@page "/admin/seguridad/auditoria"
@attribute [Authorize(Policy = "ADMIN:READ")]
@rendermode InteractiveServer
@inject ISecurityService SecurityService
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Web.Components.Shared.Security

<PageTitle>DaviWiki - Auditoría</PageTitle>

<AdminNav />

<SecurityPageHeader Title="Auditoría" Subtitle="@($"Últimos {_logs.Count} eventos de seguridad.")" />

@if (_loading)
{
    <div class="card" style="padding: var(--space-4)">
        @for (int i = 0; i < 6; i++)
        {
            <div class="skeleton" style="height:44px; margin-bottom:8px; border-radius:var(--radius-md)"></div>
        }
    </div>
}
else if (_logs.Count == 0)
{
    <SecurityEmptyState IconName="history" Title="Sin eventos registrados"
                        Description="Cuando se realicen cambios de seguridad (usuarios, roles, permisos) van a aparecer acá." />
}
else
{
    <div class="security-toolbar">
        <div class="security-search">
            <Icon Name="search" />
            <input type="text" placeholder="Buscar por usuario o detalle..." aria-label="Buscar en auditoría"
                   @bind="_searchTerm" @bind:event="oninput" @bind:after="ResetPage" />
        </div>
        <select class="input" style="max-width:220px" @bind="_actionFilter" @bind:after="ResetPage" aria-label="Filtrar por tipo de acción">
            <option value="">Todas las acciones</option>
            @foreach (var action in DistinctActions)
            {
                <option value="@action">@FormatAction(action)</option>
            }
        </select>
        <input type="date" class="input" style="max-width:160px" @bind="_dateFrom" @bind:after="ResetPage" aria-label="Desde" />
        <input type="date" class="input" style="max-width:160px" @bind="_dateTo" @bind:after="ResetPage" aria-label="Hasta" />
        @if (_actionFilter != "" || !string.IsNullOrWhiteSpace(_searchTerm) || _dateFrom is not null || _dateTo is not null)
        {
            <button class="btn btn--ghost btn--sm" @onclick="ClearFilters">Limpiar filtros</button>
        }
        <span class="security-toolbar__count">@FilteredLogs.Count de @_logs.Count</span>
    </div>

    @if (FilteredLogs.Count == 0)
    {
        <SecurityEmptyState IconName="search" Title="Sin resultados" Description="No hay eventos que coincidan con la búsqueda o el filtro." Inline="true" />
    }
    else
    {
        <div class="card data-table-wrap">
            <table class="data-table data-table--clickable">
                <thead>
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in PagedLogs)
                    {
                        <tr @onclick="() => _selectedLog = log">
                            <td style="white-space:nowrap; color:var(--text-tertiary)">@log.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="data-table__user-cell">
                                    <span class="activity-row__avatar">@(log.Username.Length > 0 ? log.Username[..1].ToUpper() : "?")</span>
                                    <strong>@log.Username</strong>
                                </div>
                            </td>
                            <td><span class="badge">@FormatAction(log.Action)</span></td>
                            <td style="max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-tertiary)">
                                @log.Details
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_totalPages > 1)
        {
            <div class="pagination" role="navigation" aria-label="Paginación de auditoría">
                <button class="btn btn--ghost btn--sm" disabled="@(_page == 1)" @onclick="() => GoToPage(_page - 1)">
                    <Icon Name="chevron-left" /> Anterior
                </button>
                <span class="pagination__info">Página @_page de @_totalPages</span>
                <button class="btn btn--ghost btn--sm" disabled="@(_page == _totalPages)" @onclick="() => GoToPage(_page + 1)">
                    Siguiente <Icon Name="chevron-right" />
                </button>
            </div>
        }
    }

    @if (_selectedLog is not null)
    {
        <div class="drawer-overlay" @onclick="() => _selectedLog = null">
            <div class="drawer" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="logDrawerTitle">
                <div class="drawer__header">
                    <h3 id="logDrawerTitle">Detalle del evento</h3>
                    <button class="btn btn--ghost btn--sm" @onclick="() => _selectedLog = null" aria-label="Cerrar"><Icon Name="x" /></button>
                </div>
                <div class="drawer__body">
                    <div class="drawer__row">
                        <span class="drawer__row-label">Fecha y hora</span>
                        <span class="drawer__row-value">@_selectedLog.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                    <div class="drawer__row">
                        <span class="drawer__row-label">Usuario</span>
                        <span class="drawer__row-value">@_selectedLog.Username</span>
                    </div>
                    <div class="drawer__row">
                        <span class="drawer__row-label">Acción</span>
                        <span class="drawer__row-value">@FormatAction(_selectedLog.Action)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selectedLog.Details))
                    {
                        <div class="drawer__row">
                            <span class="drawer__row-label">Detalle</span>
                            <span class="drawer__row-value">@_selectedLog.Details</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<SecurityAuditLog> _logs = new();
    private bool _loading = true;
    private string _searchTerm = "";
    private string _actionFilter = "";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private SecurityAuditLog? _selectedLog;
    private int _page = 1;
    private const int PageSize = 20;

    private IEnumerable<string> DistinctActions => _logs.Select(l => l.Action).Distinct().OrderBy(a => a);

    private IReadOnlyList<SecurityAuditLog> FilteredLogs =>
        _logs.Where(l =>
            (string.IsNullOrEmpty(_actionFilter) || l.Action == _actionFilter) &&
            (_dateFrom is null || l.OccurredAt.ToLocalTime().Date >= _dateFrom.Value.Date) &&
            (_dateTo is null || l.OccurredAt.ToLocalTime().Date <= _dateTo.Value.Date) &&
            (string.IsNullOrWhiteSpace(_searchTerm) ||
             l.Username.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (l.Details?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)))
        .ToList();

    private int _totalPages => Math.Max(1, (int)Math.Ceiling(FilteredLogs.Count / (double)PageSize));

    private IReadOnlyList<SecurityAuditLog> PagedLogs =>
        FilteredLogs.Skip((_page - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        _logs = await SecurityService.GetAuditLogsAsync(200);
        _loading = false;
    }

    private void ResetPage() => _page = 1;

    private void GoToPage(int page)
    {
        _page = Math.Clamp(page, 1, _totalPages);
    }

    private void ClearFilters()
    {
        _searchTerm = "";
        _actionFilter = "";
        _dateFrom = null;
        _dateTo = null;
        _page = 1;
    }

    private static string FormatAction(string action) => action switch
    {
        "USER_ACTIVATED" => "Usuario activado",
        "USER_DEACTIVATED" => "Usuario desactivado",
        "ROLE_ASSIGNED" => "Rol asignado",
        "ROLE_REMOVED" => "Rol removido",
        "ROLES_CHANGED" => "Roles modificados",
        "ROLE_CREATED" => "Rol creado",
        "ROLE_DELETED" => "Rol eliminado",
        "PERMISSION_CHANGED" => "Permisos modificados",
        _ => action
    };
}








/* ===== Toast (feedback de guardado) ===== */
.toast {
  position: fixed;
  bottom: var(--space-6);
  right: var(--space-6);
  z-index: 999;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: var(--bg-elevated);
  border: 1px solid var(--border-default);
  border-left: 3px solid #10b981;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  font-size: var(--fs-sm);
  font-weight: 600;
  animation: slideInLeft 0.2s var(--ease);
}

.toast .icon { color: #10b981; width: 16px; height: 16px; }

@keyframes slideInLeft {
  from { transform: translateX(24px); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* ===== Chips (roles) ===== */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 6px 4px 10px;
  border-radius: var(--radius-full);
  font-size: var(--fs-xs);
  font-weight: 600;
  background: var(--brand-50, rgba(99, 102, 241, 0.1));
  color: var(--brand-600, var(--brand-500));
  white-space: nowrap;
}

.chip--sm { padding: 3px 8px; font-size: 11px; }

.chip--muted {
  background: var(--bg-surface-3);
  color: var(--text-tertiary);
}

.chip__remove {
  display: inline-flex;
  padding: 2px;
  border-radius: 50%;
  color: inherit;
  opacity: 0.65;
  transition: opacity var(--transition-fast), background var(--transition-fast);
}

.chip__remove:hover { opacity: 1; background: rgba(0, 0, 0, 0.08); }
.chip__remove .icon { width: 12px; height: 12px; }

.role-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: var(--space-3) 0;
}

.role-chip-list--compact { margin: 0; gap: 4px; }

.role-chip-list__empty {
  font-size: var(--fs-sm);
  color: var(--text-tertiary);
  font-style: italic;
}

.role-assign-row {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  margin-top: var(--space-3);
  flex-wrap: wrap;
}

.role-assign-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2);
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1px solid var(--border-subtle);
  flex-wrap: wrap;
}

.role-assign-actions__hint {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--fs-xs);
  color: var(--text-tertiary);
  margin-right: auto;
}

.role-assign-actions__hint .icon { width: 14px; height: 14px; color: #d97706; }

/* ===== Acciones masivas ===== */
.bulk-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  background: var(--brand-50, rgba(99, 102, 241, 0.08));
  border: 1px solid var(--brand-500);
  border-radius: var(--radius-md);
  font-size: var(--fs-sm);
  flex-wrap: wrap;
}

.bulk-action-bar__actions {
  display: flex;
  gap: var(--space-2);
}

/* ===== Permission matrix: toggle por columna ===== */
.matrix-toolbar {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
}

.matrix-col-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.matrix-col-toggle { color: var(--text-tertiary); transition: color var(--transition-fast); }
.matrix-col-toggle:hover { color: var(--brand-500); }
.matrix-col-toggle .icon { width: 14px; height: 14px; }

.matrix-group-header td {
  background: var(--bg-surface-2);
  font-weight: 700;
  font-size: var(--fs-xs);
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--text-tertiary);
  padding: 6px var(--space-2) !important;
}

.matrix-changed { position: relative; }

.matrix-changed::after {
  content: "";
  position: absolute;
  top: 6px;
  right: 6px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--brand-500);
}

/* ===== Paginación ===== */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  margin-top: var(--space-4);
}

.pagination__info {
  font-size: var(--fs-sm);
  color: var(--text-tertiary);
}

/* ===== Security Page Header ===== */
.security-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
  flex-wrap: wrap;
}

.security-header__back {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-tertiary);
  margin-bottom: var(--space-2);
  transition: color var(--transition-fast);
}

.security-header__back:hover { color: var(--brand-500); }
.security-header__back .icon { width: 14px; height: 14px; }
.security-header__titles h1 { margin-bottom: 4px; }
.security-header__titles p { color: var(--text-tertiary); font-size: var(--fs-sm); max-width: 560px; }

.security-header__actions {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  flex-shrink: 0;
}

/* ===== Toolbar: búsqueda + filtros ===== */
.security-toolbar {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
}

.security-search { position: relative; flex: 1; min-width: 220px; max-width: 340px; }

.security-search .icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  width: 15px;
  height: 15px;
  color: var(--text-tertiary);
  pointer-events: none;
}

.security-search input {
  width: 100%;
  padding: 8px 12px 8px 34px;
  border: 1px solid var(--border-default);
  border-radius: var(--radius-md);
  background: var(--bg-elevated);
  font-size: var(--fs-sm);
  transition: border-color var(--transition-fast);
}

.security-search input:focus { border-color: var(--brand-500); }

.security-filter-group {
  display: flex;
  gap: 4px;
  padding: 3px;
  background: var(--bg-surface-2);
  border-radius: var(--radius-md);
}

.security-filter-btn {
  padding: 6px 12px;
  border-radius: var(--radius-sm, 6px);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--text-tertiary);
  transition: background var(--transition-fast), color var(--transition-fast);
}

.security-filter-btn:hover { color: var(--text-primary); }

.security-filter-btn--active {
  background: var(--bg-elevated);
  color: var(--text-primary);
  box-shadow: var(--shadow-sm, 0 1px 2px rgba(0, 0, 0, 0.1));
}

.security-toolbar__count {
  margin-left: auto;
  font-size: var(--fs-xs);
  color: var(--text-tertiary);
  white-space: nowrap;
}

/* ===== Data table ===== */
.data-table-wrap { overflow-x: auto; }

.data-table { width: 100%; border-collapse: collapse; min-width: 640px; }

.data-table thead th {
  text-align: left;
  padding: var(--space-3) var(--space-3);
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.03em;
  border-bottom: 1px solid var(--border-default);
  white-space: nowrap;
}

.data-table tbody td {
  padding: var(--space-3);
  border-bottom: 1px solid var(--border-subtle);
  vertical-align: middle;
  font-size: var(--fs-sm);
}

.data-table tbody tr { transition: background var(--transition-fast); }
.data-table tbody tr:hover { background: var(--bg-hover); }
.data-table tbody tr:last-child td { border-bottom: none; }

.data-table__user-cell { display: flex; align-items: center; gap: var(--space-3); }
.data-table__user-info { display: flex; flex-direction: column; line-height: 1.3; }
.data-table__user-name { font-weight: 600; color: var(--text-primary); }
.data-table__user-sub { font-size: var(--fs-xs); color: var(--text-tertiary); }
.data-table__actions { text-align: right; }
.data-table--clickable tbody tr { cursor: pointer; }

.data-table th.sortable { cursor: pointer; user-select: none; }
.data-table th.sortable:hover { color: var(--text-primary); }
.data-table th.sortable .icon { width: 12px; height: 12px; vertical-align: -1px; margin-left: 2px; opacity: 0.6; }

/* ===== Status badge ===== */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 9px;
  border-radius: var(--radius-full);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.status-badge__dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.status-badge--active { background: rgba(16, 185, 129, 0.12); color: #0a8a5f; }
.status-badge--active .status-badge__dot { background: #10b981; }
[data-theme="dark"] .status-badge--active { color: #34d399; }
.status-badge--inactive { background: var(--bg-surface-3); color: var(--text-tertiary); }
.status-badge--inactive .status-badge__dot { background: var(--text-tertiary); }

/* ===== Role cards ===== */
.role-card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: var(--space-4);
}

.role-card { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); }
.role-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }

.role-card__icon {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: var(--gradient-brand);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-card__icon .icon { width: 18px; height: 18px; }
.role-card__name { font-weight: 700; font-size: var(--fs-md); }
.role-card__desc { font-size: var(--fs-sm); color: var(--text-tertiary); flex: 1; line-height: 1.5; }

.role-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  padding-top: var(--space-3);
  border-top: 1px solid var(--border-subtle);
}

/* ===== Entity header (detalle) ===== */
.entity-header { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
.entity-header__avatar { width: 56px; height: 56px; font-size: var(--fs-lg); }

.entity-header__meta {
  font-size: var(--fs-sm);
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-top: 4px;
}

/* ===== Tabs (detalle) ===== */
.security-tabs {
  display: flex;
  gap: var(--space-1);
  border-bottom: 1px solid var(--border-default);
  margin: var(--space-6) 0 var(--space-6);
}

.security-tab {
  padding: var(--space-2) var(--space-3);
  margin-bottom: -1px;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-tertiary);
  border-bottom: 2px solid transparent;
  transition: color var(--transition-fast), border-color var(--transition-fast);
}

.security-tab:hover { color: var(--text-primary); }
.security-tab--active { color: var(--brand-500); border-color: var(--brand-500); }

/* ===== Drawer (auditoría) ===== */
.drawer-overlay {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal);
  background: rgba(0, 0, 0, 0.45);
  animation: fadeIn 0.15s var(--ease);
  display: flex;
  justify-content: flex-end;
}

.drawer {
  width: 100%;
  max-width: 420px;
  height: 100%;
  background: var(--bg-elevated);
  border-left: 1px solid var(--border-default);
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  animation: slideInRight 0.2s var(--ease);
}

@keyframes slideInRight {
  from { transform: translateX(24px); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

.drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
}

.drawer__body { padding: var(--space-5); overflow-y: auto; flex: 1; }

.drawer__row {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--border-subtle);
}

.drawer__row:last-child { border-bottom: none; }

.drawer__row-label {
  font-size: var(--fs-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--text-tertiary);
}

/* ===== Responsive ===== */
@media (max-width: 720px) {
  .security-header { flex-direction: column; }
  .security-toolbar__count { margin-left: 0; }
  .entity-header { flex-direction: column; align-items: flex-start; }
  .bulk-action-bar { flex-direction: column; align-items: flex-start; }

  .security-nav {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-default);
  }

  .security-nav__label {
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .security-nav__items {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    width: 100%;
    overflow-x: auto;
  }

  .security-nav__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 12px;
    border-radius: var(--radius-md);
    color: var(--text-tertiary);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .security-nav__item .icon { width: 16px; height: 16px; }
  .security-nav__item:hover { color: var(--text-primary); background: var(--bg-hover); }
  .security-nav__item--active { color: var(--brand-500); background: var(--bg-surface-2); }
}