/* ================= Tab Gestión — estilo wiki Davivienda (scoped) ================= */

.gestion-tab {
    --dvv-red: #EE0000;
    --dvv-red-dark: #c40000;
    --dvv-red-deep: #8a1f1f;
    --dvv-red-soft: rgba(238,0,0,0.08);
    --dvv-red-softer: rgba(238,0,0,0.04);
    --dvv-red-border: rgba(238,0,0,0.16);
}

/* ---- Cards base ---- */
.gestion-tab .management-grid .widget {
    border-radius: var(--radius-lg, 14px);
    border: 1px solid var(--border-subtle, rgba(0,0,0,0.06));
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.gestion-tab .management-grid .widget:hover {
    box-shadow: 0 4px 14px rgba(0,0,0,0.07);
}

.gestion-tab .widget--quick .widget__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1px;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
}

.gestion-tab .widget--quick .widget__title svg,
.gestion-tab .widget--quick .widget__title .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 6px;
    border-radius: var(--radius-full, 999px);
    background: var(--bg-surface-3, #f2f2f4);
    color: var(--text-secondary);
}

.gestion-tab .widget--quick .form-group__label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
    font-weight: 600;
}

/* ---- Inputs / selects ---- */
.gestion-tab select.input,
.gestion-tab textarea.input {
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--border-subtle, rgba(0,0,0,0.12));
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.gestion-tab select.input:focus,
.gestion-tab textarea.input:focus {
    outline: none;
    border-color: var(--dvv-red);
    box-shadow: 0 0 0 3px var(--dvv-red-softer);
}

/* ---- Botones acciones rápidas ---- */
.gestion-tab .widget--quick .btn {
    border-radius: var(--radius-md, 8px);
    font-weight: 600;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.gestion-tab .widget--quick .btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(0,0,0,0.08);
}

/* ---- Transferir: card insignia ---- */
.gestion-tab .widget--transfer {
    position: relative;
    background:
        radial-gradient(120% 100% at 0% 0%, var(--dvv-red-soft), transparent 55%),
        var(--bg-surface, #fff);
    border: 1px solid var(--dvv-red-border);
    border-radius: var(--radius-lg, 14px);
    padding: var(--space-6, 28px);
    box-shadow: 0 2px 10px rgba(238,0,0,0.07);
    overflow: hidden;
}

.gestion-tab .widget--transfer::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--dvv-red), #ff6a6a);
}

.gestion-tab .widget--transfer .widget__title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 800;
    color: var(--dvv-red-deep);
    margin-bottom: var(--space-5, 22px);
}

.gestion-tab .widget--transfer .widget__title svg,
.gestion-tab .widget--transfer .widget__title .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 7px;
    border-radius: var(--radius-full, 999px);
    background: var(--dvv-red);
    color: #fff;
    box-shadow: 0 2px 6px rgba(238,0,0,0.35);
}

.gestion-tab .widget--transfer .form-group {
    margin-bottom: var(--space-4, 16px);
}

.gestion-tab .widget--transfer .form-group__label {
    color: var(--dvv-red-deep);
    font-weight: 600;
    font-size: 12px;
}

.gestion-tab .widget--transfer + .widget {
    margin-top: var(--space-6, 28px);
}

/* ---- Botón Transferir ---- */
.gestion-tab .btn--transfer {
    background: linear-gradient(135deg, var(--dvv-red), var(--dvv-red-dark));
    border: none;
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.2px;
    padding: 11px 26px;
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 3px 10px rgba(238,0,0,0.32);
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
}
.gestion-tab .btn--transfer:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(238,0,0,0.4);
    filter: brightness(1.03);
}
.gestion-tab .btn--transfer:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(238,0,0,0.3);
}
.gestion-tab .btn--transfer:disabled {
    background: #f3b8b8;
    color: #fff;
    box-shadow: none;
    opacity: 1;
    cursor: not-allowed;
}

/* ---- Historial: timeline ---- */
.gestion-tab .widget--history {
    border-radius: var(--radius-lg, 14px);
    padding: var(--space-5, 22px);
}

.gestion-tab .widget--history .widget__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-4, 16px);
}

.gestion-tab .widget--history .activity-row {
    position: relative;
    display: flex;
    gap: 14px;
    padding-block: 14px;
    padding-left: 4px;
}

.gestion-tab .widget--history .activity-row::before {
    content: "";
    position: absolute;
    left: 19px;
    top: 44px;
    bottom: -14px;
    width: 1.5px;
    background: var(--border-subtle, rgba(0,0,0,0.08));
}
.gestion-tab .widget--history .activity-row:last-child::before {
    display: none;
}

.gestion-tab .widget--history .activity-row__icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full, 999px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
}

.gestion-tab .widget--history .activity-row__text {
    font-size: 13.5px;
    color: var(--text-primary);
    margin: 0 0 3px 0;
}
.gestion-tab .widget--history .activity-row__text strong {
    color: var(--dvv-red);
}

.gestion-tab .widget--history .activity-row__time {
    font-size: 12px;
    color: var(--text-tertiary);
    margin: 0;
}

.gestion-tab .form-group__label {
    display: block;
    font-size: 12px;
    color: var(--text-tertiary);
    margin-bottom: 4px;
}

@media (max-width: 900px) {
    .gestion-tab .widget--transfer {
        padding: var(--space-4, 16px);
    }
}