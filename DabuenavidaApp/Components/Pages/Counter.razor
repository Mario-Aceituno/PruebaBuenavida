<div class="journey-progress">
    <div class="journey-progress__fill"
         style="width:@($"{((_journeyStepIndex + 1) * 100.0 / _journey.Count):F0}%")">
    </div>
</div>


.journey-progress{

    width:100%;

    height:6px;

    background:rgba(255,255,255,.18);

    border-radius:999px;

    overflow:hidden;

    margin-top:var(--space-3);

}



.journey-progress__fill{

    height:100%;

    border-radius:999px;

    background:currentColor;

    transition:width .35s ease;

}