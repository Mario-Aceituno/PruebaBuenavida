using CorpWiki.Domain.Entities;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations;

public class CollectionArticleConfiguration : IEntityTypeConfiguration<CollectionArticle>
{
    public void Configure(EntityTypeBuilder<CollectionArticle> builder)
    {
        builder.ToTable("collection_articles");
        builder.HasKey(x => new { x.CollectionId, x.ArticleId });

        builder.HasOne<Collection>()
            .WithMany()
            .HasForeignKey(x => x.CollectionId)
            .OnDelete(DeleteBehavior.Cascade);

        builder.HasOne<Article>()
            .WithMany()
            .HasForeignKey(x => x.ArticleId)
            .OnDelete(DeleteBehavior.Cascade);
    }
}