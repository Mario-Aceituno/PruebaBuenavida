using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Components.Authorization;

namespace CorpWiki.Web.Security;

/// <summary>
/// Base para páginas de contenido que necesitan mostrar/ocultar acciones
/// (crear, editar, eliminar, exportar) según los permisos del usuario sobre
/// una pantalla específica. La entrada a la página se sigue controlando
/// aparte con [Authorize(Policy = "CODE:READ")].
/// </summary>
public abstract class PermissionAwareComponentBase : ComponentBase
{
    [Inject] protected AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    /// <summary>Código de pantalla (debe existir en DatabaseSeeder.ScreenIds).</summary>
    protected abstract string ScreenCode { get; }

    protected bool CanWrite { get; private set; }
    protected bool CanDelete { get; private set; }
    protected bool CanExport { get; private set; }
    protected bool CanAdmin { get; private set; }
    protected string CurrentUsername { get; private set; } = "unknown";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        CanWrite = user.HasPermission(ScreenCode, "WRITE");
        CanDelete = user.HasPermission(ScreenCode, "DELETE");
        CanExport = user.HasPermission(ScreenCode, "EXPORT");
        CanAdmin = user.HasPermission(ScreenCode, "ADMIN");
        CurrentUsername = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        await OnPermissionsLoadedAsync();
    }

    /// <summary>Las páginas cargan sus datos acá en vez de OnInitializedAsync directamente.</summary>
    protected virtual Task OnPermissionsLoadedAsync() => Task.CompletedTask;
}




