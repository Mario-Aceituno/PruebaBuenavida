.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    width: 100%;
}

.field-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0; /* Evita que el hijo desborde el Grid */
}

.custom-input {
    width: 100%;
    box-sizing: border-box; /* Asegura que el padding no incremente el ancho */
    padding: 9px 13px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.9rem;
}








.role-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999; /* Garantiza estar sobre todo el contenido */
    padding: 20px;
    box-sizing: border-box;
}

.role-modal {
    background: #ffffff;
    width: 100%;
    max-width: 900px;
    max-height: 85vh; /* Limita la altura al 85% de la pantalla */
    border-radius: 16px;
    display: flex;
    flex-direction: flex-col;
    flex-direction: column;
    overflow: hidden; /* El contenedor padre no genera scroll */
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

.role-modal__body {
    padding: 24px;
    overflow-y: auto; /* Solo el cuerpo interna del modal hace scroll */
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
}
