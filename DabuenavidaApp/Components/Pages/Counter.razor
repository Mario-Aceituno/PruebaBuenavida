    public async Task<Article> CreateArticleAsync(
        string title,
        string summary,
        Guid categoryId,
        Guid authorId,
        Guid? coverImageMediaId,
        bool isFeatured,
        ArticleStatus status,
        List<ArticleContentBlock>? content = null,
        IEnumerable<Guid>? tagIds = null,
        IEnumerable<Guid>? relatedArticleIds = null,
        IEnumerable<Guid>? attachmentMediaIds = null)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var strategy = db.Database.CreateExecutionStrategy();

        return await strategy.ExecuteAsync(async () =>
        {
            await using var transaction = await db.Database.BeginTransactionAsync();
            try
            {
                var article = new Article
                {
                    Id = Guid.NewGuid(),
                    Title = title,
                    Summary = summary,
                    CategoryId = categoryId,
                    AuthorId = authorId,
                    CoverImageMediaId = coverImageMediaId,
                    IsFeatured = isFeatured,
                    Status = status,
                    Content = content ?? new List<ArticleContentBlock>()
                };

                db.Articles.Add(article);
                await db.SaveChangesAsync();

                if (tagIds != null && tagIds.Any())
                {
                    await db.ArticleTags.AddRangeAsync(tagIds.Select(tId => new ArticleTag { ArticleId = article.Id, TagId = tId }));
                    await db.SaveChangesAsync();
                }

                if (relatedArticleIds != null && relatedArticleIds.Any())
                {
                    await db.ArticleRelateds.AddRangeAsync(relatedArticleIds.Select(rId => new ArticleRelated { ArticleId = article.Id, RelatedArticleId = rId }));
                    await db.SaveChangesAsync();
                }

                if (attachmentMediaIds != null && attachmentMediaIds.Any())
                {
                    await db.ArticleAttachments.AddRangeAsync(attachmentMediaIds.Select(mId => new ArticleAttachment { ArticleId = article.Id, MediaFileId = mId }));
                    await db.SaveChangesAsync();
                }

                await transaction.CommitAsync();
                await PopulateNotMappedListsAsync(db, article);
                return article;
            }
            catch
            {
                await transaction.RollbackAsync();
                throw;
            }
        });
    }

    private async Task PopulateNotMappedListsAsync(DaviWikiDbContext db, Article article)
