            <div class="drawer__header">
                <h3>Detalle del evento</h3>
                <button class="btn btn--ghost btn--sm" @onclick="() => _selectedLog = null" aria-label="Cerrar"><Icon Name="x" /></button>
            </div>
            <div class="drawer__body">
                <div class="drawer__row">
                    <span class="drawer__row-label">Fecha y hora</span>
                    <span class="drawer__row-value">@_selectedLog.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                </div>
                <div class="drawer__row">
                    <span class="drawer__row-label">Usuario</span>
                    <span class="drawer__row-value">@_selectedLog.Username</span>
                </div>
                <div class="drawer__row">
                    <span class="drawer__row-label">Acción</span>
                    <span class="drawer__row-value">@FormatAction(_selectedLog.Action)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedLog.Details))
                {
                    <div class="drawer__row">
                        <span class="drawer__row-label">Detalle</span>
                        <span class="drawer__row-value">@_selectedLog.Details</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<SecurityAuditLog> _logs = new();
    private bool _loading = true;
    private string _searchTerm = "";
    private string _actionFilter = "";
    private SecurityAuditLog? _selectedLog;

    private IEnumerable<string> DistinctActions => _logs.Select(l => l.Action).Distinct().OrderBy(a => a);

    private IReadOnlyList<SecurityAuditLog> FilteredLogs =>
        _logs.Where(l =>
                (string.IsNullOrEmpty(_actionFilter) || l.Action == _actionFilter) &&
                (string.IsNullOrWhiteSpace(_searchTerm) ||
                 l.Username.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                 (l.Details?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _logs = await SecurityService.GetAuditLogsAsync(200);
        _loading = false;
    }

    private static string FormatAction(string action) => action switch
    {
        "USER_ACTIVATED" => "Usuario activado",
        "USER_DEACTIVATED" => "Usuario desactivado",
        "ROLE_ASSIGNED" => "Rol asignado",
        "ROLE_REMOVED" => "Rol removido",
        "ROLE_CREATED" => "Rol creado",
        "ROLE_DELETED" => "Rol eliminado",
        "PERMISSION_CHANGED" => "Permisos modificados",
        _ => action
    };
}




