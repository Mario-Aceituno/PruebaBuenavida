/// <summary>
/// Genera el resumen narrativo de la etapa actual del Journey Modal.
/// Usa únicamente datos ya cargados en _journeyStep (no dispara queries nuevas).
/// </summary>
private string BuildJourneySummary()
{
    if (_journeyStep is null) return string.Empty;

    var isFirst = _journeyStepIndex == 0;
    var isLast = _journeyStepIndex == _journey.Count - 1;

    var incoming = _journeyStep.Transfers.FirstOrDefault(t => t.ToAreaName == _journeyStep.AreaName);
    var outgoing = _journeyStep.Transfers.FirstOrDefault(t => t.FromAreaName == _journeyStep.AreaName);

    var opening = isFirst
        ? "El incidente inició su recorrido en esta área"
        : incoming is not null
            ? $"Esta área recibió el incidente desde {incoming.FromAreaName}"
            : "Esta área participó en el recorrido del incidente";

    var work = _journeyStep.ActiveHours > 0
        ? $" y trabajó en él durante {_journeyStep.ActiveHours:0.#} horas"
        : string.Empty;

    var closing = outgoing is not null
        ? $", antes de transferirlo a {outgoing.ToAreaName}."
        : isLast
            ? ". Es el área actual responsable del seguimiento."
            : ".";

    var team = _journeyStep.Users.Count switch
    {
        0 => string.Empty,
        1 => " Participó 1 persona de este equipo.",
        _ => $" Participaron {_journeyStep.Users.Count} personas de este equipo."
    };

    return $"{opening}{work}{closing}{team}";
}

/// <summary>Ordena el equipo mostrando primero al responsable actual, sin tocar cómo se obtienen los usuarios.</summary>
private IEnumerable<IncidentUser> TeamOrderedByResponsibility(IEnumerable<IncidentUser> users)
    => users.OrderByDescending(u => _detail is not null && u.Id == _detail.ResponsibleId);

Modal

@if (_showJourneyModal && _journeyStep is not null)
{
    <div class="journey-modal-overlay" @onclick="CloseJourneyModal">
        <div class="journey-modal" @onclick:stopPropagation="true">

            <div class="journey-modal__header" style="background:@ColorUtils.ToRgba(_journeyStep.Color,0.14); color:@_journeyStep.Color;">
                <span class="journey-modal__header-icon" style="background:@_journeyStep.Color;">
                    <Icon Name="@_journeyStep.Icon" />
                </span>
                <div style="flex:1; min-width:0;">
                    <h3 class="journey-modal__title">@_journeyStep.AreaName</h3>
                    <span class="journey-modal__step-label">Paso @(_journeyStepIndex + 1) de @_journey.Count</span>
                    <div class="journey-progress">
                        <div class="journey-progress__fill" style="width:@($"{((_journeyStepIndex + 1) * 100.0 / _journey.Count):F0}%")"></div>
                    </div>
                </div>
                <button class="btn btn--ghost btn--sm" @onclick="CloseJourneyModal"><Icon Name="x" /></button>
            </div>

            @* RESUMEN — narrativa generada por BuildJourneySummary(), sin lógica en el Razor *@
            <div class="journey-summary">
                <Icon Name="info" Class="journey-summary__icon" />
                <p class="journey-summary__text">@BuildJourneySummary()</p>
            </div>

            <div class="journey-modal__dots">
                @for (var i = 0; i < _journey.Count; i++)
                {
                    var idx = i;
                    var isActive = idx == _journeyStepIndex;
                    <span class="journey-modal__dot @(isActive ? "journey-modal__dot--active" : "")"
                        style="@(isActive ? $"background:{_journey[idx].Color};" : "")"
                        @onclick="() => GoToJourneyStep(idx)"
                        title="@_journey[idx].AreaName"></span>
                }
            </div>

            <div class="journey-modal__body journey-modal__body--@_journeyDirection" @key="_journeyStepIndex">

                @* MÉTRICAS *@
                <div class="journey-metrics journey-section journey-section--delay-1">
                    <div class="journey-metric journey-metric--work">
                        <Icon Name="activity" />
                        <div>
                            <span class="journey-metric__value">@_journeyStep.ActiveHours.ToString("0.#") h</span>
                            <span class="journey-metric__label">Trabajo efectivo</span>
                        </div>
                    </div>
                    <div class="journey-metric journey-metric--wait">
                        <Icon Name="clock" />
                        <div>
                            <span class="journey-metric__value">@_journeyStep.DeadHours.ToString("0.#") h</span>
                            <span class="journey-metric__label">Tiempo en espera</span>
                        </div>
                    </div>
                </div>

                @* EQUIPO *@
                <h4 class="widget__title journey-section journey-section--delay-2">
                    <Icon Name="users" /> Personas del equipo
                    <span class="journey-section__count">@_journeyStep.Users.Count</span>
                </h4>
                @{
                    var responsible = _journeyStep.Users.FirstOrDefault(u => _detail is not null && u.Id == _detail.ResponsibleId);
                    var others = _journeyStep.Users.Where(u => responsible is null || u.Id != responsible.Id).ToList();
                }
                @if (_journeyStep.Users.Count == 0)
                {
                    <div class="journey-empty">
                        <Icon Name="users" />
                        <p class="journey-empty__title">Sin participantes registrados</p>
                        <p class="journey-empty__desc">Esta área todavía no tiene usuarios asociados.</p>
                    </div>
                }
                else
                {
                    <div class="person-row-list">
                        @if (responsible is not null)
                        {
                            <div class="activity-row activity-row--highlight">
                                <span class="avatar avatar--sm">@InitialsOf(responsible.FullName)</span>
                                <div style="flex:1; min-width:0;">
                                    <p class="activity-row__text">
                                        <span class="badge badge--brand"><Icon Name="star" /> Responsable actual</span><br />
                                        <strong>@responsible.FullName</strong>
                                    </p>
                                    <p class="activity-row__time">@responsible.Role</p>
                                </div>
                            </div>
                        }
                        @if (others.Count > 0)
                        {
                            <p class="journey-subheading">Otros participantes</p>
                            @foreach (var u in others)
                            {
                                <div class="activity-row">
                                    <span class="avatar avatar--sm">@InitialsOf(u.FullName)</span>
                                    <div style="flex:1; min-width:0;">
                                        <p class="activity-row__text"><strong>@u.FullName</strong></p>
                                        <p class="activity-row__time">@u.Role</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                @* ACTIVIDAD — timeline *@
                <h4 class="widget__title journey-section journey-section--delay-3">
                    <Icon Name="history" /> Qué hizo el equipo
                    <span class="journey-section__count">@_journeyStep.Activity.Count</span>
                </h4>
                @if (_journeyStep.Activity.Count == 0)
                {
                    <div class="journey-empty">
                        <Icon Name="inbox" />
                        <p class="journey-empty__title">Sin actividad registrada</p>
                        <p class="journey-empty__desc">Nadie de este equipo generó actividad todavía.</p>
                    </div>
                }
                else
                {
                    <div class="journey-timeline">
                        @foreach (var entry in _journeyStep.Activity)
                        {
                            var color = IncidentCssHelpers.ActivityColor(entry.Type);
                            <div class="journey-timeline__item">
                                <div class="journey-timeline__dot" style="background:@ColorUtils.ToRgba(color,0.14); color:@color;">
                                    <Icon Name="@IncidentCssHelpers.ActivityIcon(entry.Type)" />
                                </div>
                                <div class="journey-timeline__content">
                                    <p class="activity-row__text"><strong>@entry.ActorName</strong> @entry.Description</p>
                                    <p class="activity-row__time">@entry.OccurredAt.ToRelativeLabel()</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* TRANSFERENCIAS — tarjeta *@
                @if (_journeyStep.Transfers.Count > 0)
                {
                    <h4 class="widget__title journey-section" style="margin-top:var(--space-5);">
                        <Icon Name="arrow-right" /> Transferencias relacionadas
                        <span class="journey-section__count">@_journeyStep.Transfers.Count</span>
                    </h4>
                    @foreach (var t in _journeyStep.Transfers)
                    {
                        <div class="journey-transfer-card">
                            <p class="journey-transfer-card__title">Transferencia realizada</p>
                            <div class="journey-transfer-card__grid">
                                <div><span class="journey-transfer-card__label">Origen</span><strong>@t.FromAreaName</strong></div>
                                <div><span class="journey-transfer-card__label">Destino</span><strong>@t.ToAreaName</strong></div>
                                <div><span class="journey-transfer-card__label">Responsable</span><strong>@t.ToUserName</strong></div>
                                <div><span class="journey-transfer-card__label">Fecha</span><strong>@t.TransferredAt.ToRelativeLabel()</strong></div>
                            </div>
                        </div>
                    }
                }

                @* COMENTARIOS — conversación *@
                @if (_journeyStep.Comments.Count > 0)
                {
                    <h4 class="widget__title journey-section" style="margin-top:var(--space-5);">
                        <Icon Name="message-circle" /> Comentarios del equipo
                        <span class="journey-section__count">@_journeyStep.Comments.Count</span>
                    </h4>
                    @foreach (var c in _journeyStep.Comments)
                    {
                        <div class="journey-comment">
                            <span class="avatar avatar--sm">@InitialsOf(c.AuthorName)</span>
                            <div style="flex:1; min-width:0;">
                                <p class="journey-comment__meta"><strong>@c.AuthorName</strong> · @c.CreatedAt.ToRelativeLabel()</p>
                                <p class="journey-comment__text">"@c.Text"</p>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="journey-modal__controls">
                <button class="btn btn--secondary btn--sm" @onclick="() => GoToJourneyStep(_journeyStepIndex - 1)" disabled="@(_journeyStepIndex == 0)">
                    <Icon Name="chevron-left" /> Anterior
                </button>
                <button class="btn btn--secondary btn--sm" @onclick="() => GoToJourneyStep(_journeyStepIndex + 1)" disabled="@(_journeyStepIndex == _journey.Count - 1)">
                    Siguiente <Icon Name="chevron-right" />
                </button>
            </div>
        </div>
    </div>
}

Nuevo css 

/* Resumen narrativo */
.journey-summary {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    background: var(--bg-surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-4) 0;
}
.journey-summary__icon { width: 16px; height: 16px; color: var(--brand-500); margin-top: 2px; flex-shrink: 0; }
.journey-summary__text { font-size: var(--fs-sm); color: var(--text-secondary); line-height: 1.5; }

/* Métricas */
.journey-metrics { display: flex; gap: var(--space-3); margin-bottom: var(--space-5); flex-wrap: wrap; }
.journey-metric {
    display: flex; align-items: center; gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--bg-surface-2);
    border: 1px solid var(--border-subtle);
}
.journey-metric .icon { width: 16px; height: 16px; }
.journey-metric--work { color: var(--color-success); }
.journey-metric--wait { color: var(--color-warning); }
.journey-metric__value { display: block; font-size: var(--fs-sm); font-weight: 700; color: var(--text-primary); }
.journey-metric__label { display: block; font-size: var(--fs-xs); color: var(--text-tertiary); }

.journey-section__count {
    font-size: var(--fs-xs); font-weight: 600;
    background: var(--bg-surface-3); color: var(--text-secondary);
    border-radius: var(--radius-full); padding: 1px 8px; margin-left: 6px;
}
.journey-subheading {
    font-size: var(--fs-xs); font-weight: 600; color: var(--text-tertiary);
    text-transform: uppercase; letter-spacing: 0.03em;
    margin: var(--space-3) 0 var(--space-1);
}
.activity-row--highlight {
    background: var(--bg-active);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    border-bottom: none;
}

/* Timeline de actividad */
.journey-timeline { position: relative; }
.journey-timeline__item { display: flex; gap: var(--space-3); position: relative; padding-bottom: var(--space-4); }
.journey-timeline__item:not(:last-child)::before {
    content: ""; position: absolute; left: 15px; top: 32px; bottom: -6px;
    width: 2px; background: var(--border-default);
}
.journey-timeline__dot {
    width: 32px; height: 32px; min-width: 32px; border-radius: var(--radius-full);
    display: flex; align-items: center; justify-content: center; z-index: 1;
}
.journey-timeline__dot .icon { width: 14px; height: 14px; }

/* Transferencia */
.journey-transfer-card {
    background: var(--bg-surface-2); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-2);
}
.journey-transfer-card__title { font-size: var(--fs-xs); font-weight: 700; color: var(--brand-500); margin-bottom: var(--space-2); }
.journey-transfer-card__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2) var(--space-4); }
.journey-transfer-card__label { display: block; font-size: var(--fs-xs); color: var(--text-tertiary); }

/* Comentarios */
.journey-comment { display: flex; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--border-subtle); }
.journey-comment:last-child { border-bottom: none; }
.journey-comment__meta { font-size: var(--fs-xs); color: var(--text-tertiary); margin-bottom: 2px; }
.journey-comment__text { font-size: var(--fs-sm); color: var(--text-primary); font-style: italic; line-height: 1.45; }

/* Estados vacíos */
.journey-empty { text-align: center; padding: var(--space-6) var(--space-4); color: var(--text-tertiary); }
.journey-empty .icon { width: 28px; height: 28px; margin-bottom: var(--space-2); opacity: 0.5; }
.journey-empty__title { font-size: var(--fs-sm); font-weight: 600; color: var(--text-secondary); }
.journey-empty__desc { font-size: var(--fs-xs); margin-top: 2px; }