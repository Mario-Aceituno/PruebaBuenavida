<div class="form-group">
    <label class="form-label" for="file-input">
        Archivo <span class="form-required">*</span>
    </label>
    <InputFile id="file-input" class="input" OnChange="OnFileSelected" />
    @if (_selectedFile is not null)
    {
        <p class="form-hint">
            <Icon Name="file" /> @_selectedFile.Name (@FormatSize(_selectedFile.Size))
        </p>
    }
</div>

<div class="form-group">
    <label class="form-label" for="file-name">Nombre de archivo <span class="form-required">*</span></label>
    <InputText id="file-name" class="input" @bind-Value="_form.FileName" placeholder="Ej: manual-onboarding.pdf" />
</div>





private IBrowserFile? _selectedFile;
private bool _isUploading;

private void OnFileSelected(InputFileChangeEventArgs e)
{
    _selectedFile = e.File;
    if (_editingId is null && string.IsNullOrWhiteSpace(_form.FileName))
        _form.FileName = e.File.Name; // pre-llena con el nombre real
}

private static string FormatSize(long bytes) =>
    bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024.0):0.#} MB" : $"{bytes / 1024.0:0.#} KB";

private async Task Save()
{
    if (string.IsNullOrWhiteSpace(_form.FileName))
    {
        _error = "El nombre de archivo es obligatorio.";
        return;
    }

    if (_editingId is null && _selectedFile is null)
    {
        _error = "Debes seleccionar un archivo para subir.";
        return;
    }

    var tags = (_form.TagsRaw ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    _isUploading = true;
    try
    {
        if (_editingId is null)
        {
            const long maxSize = 20 * 1024 * 1024; // ajustar a tu config real
            await using var stream = _selectedFile!.OpenReadStream(maxAllowedSize: maxSize);

            var uploadRequest = new FileUploadRequest
            {
                FileName = _form.FileName.Trim(),
                Content = stream,
                SizeInBytes = _selectedFile.Size,
                Category = FileCategory.ArticleAttachment // ver nota arriba
            };

            var result = await UploadFile.ExecuteAsync(uploadRequest);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            var authorId = (await Data.GetAuthorsAsync()).FirstOrDefault()?.Id ?? Guid.Empty;

            await Data.CreateMediaFileAsync(new MediaFile
            {
                Id = Guid.NewGuid(),
                FileName = _form.FileName.Trim(),
                Type = _form.Type,
                StorageUrl = result.Key!, // key devuelta por UploadAsync
                ThumbnailUrl = string.Empty,
                SizeInBytes = _selectedFile.Size,
                AuthorId = authorId,
                UploadedAt = DateTime.Now,
                Tags = tags,
                CategoryId = null
            });

            _all.Insert(0, (await Data.GetMediaFilesAsync()).First(m => m.StorageUrl == result.Key));
        }
        else
        {
            var mediaFile = await Data.GetMediaFileAsync(_editingId.Value);
            if (mediaFile is null) return;

            mediaFile.FileName = _form.FileName.Trim();
            mediaFile.Type = _form.Type;
            mediaFile.Tags = tags;
            await Data.UpdateMediaFileAsync(mediaFile);
        }

        ResetPage();
        _showModal = false;
    }
    finally
    {
        _isUploading = false;
    }
}


private async Task DeleteFile(MediaFile file)
{
    var deleted = await DeleteFile.ExecuteAsync(file.StorageUrl);
    if (deleted)
    {
        // asumiendo que agregas Data.DeleteMediaFileAsync(Guid id) a IWikiDataService
        _all.Remove(file);
        ResetPage();
    }
}