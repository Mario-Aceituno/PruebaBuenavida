}

<SecurityConfirmDialog Visible="_confirmingDelete is not null"
                        Title="Eliminar rol"
                        Message="@($"El rol '{_confirmingDelete?.Name}' se eliminará. Los usuarios que lo tengan asignado quedarán sin rol. Esta acción no se puede deshacer.")"
                        ConfirmText="Eliminar"
                        Dangerous="true"
                        OnConfirm="DeleteRole"
                        OnCancel="() => _confirmingDelete = null" />

@if (_showToast)
{
    <div class="toast"><Icon Name="check-circle" /> @_toastMessage</div>
}

@code {
    private List<SecurityRole> _roles = new();
    private bool _loading = true;
    private bool _canWrite;
    private bool _showCreateModal;
    private string _newRoleName = "";
    private string _newRoleDescription = "";
    private string _actingUser = "unknown";
    private SecurityRole? _confirmingDelete;
    private bool _showToast;
    private string _toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _roles = await SecurityService.GetAllRolesAsync();
        _loading = false;
    }

    private void GoToMatrix(Guid roleId) => Navigation.NavigateTo($"/admin/seguridad/roles/{roleId}/permisos");

    private async Task CreateRole()
    {
        if (!_canWrite || string.IsNullOrWhiteSpace(_newRoleName)) return;

        var role = await SecurityService.CreateRoleAsync(_newRoleName.Trim(), _newRoleDescription.Trim());
        await SecurityService.LogAuditAsync(null, _actingUser, "ROLE_CREATED", $"Rol creado: {role.Name}");

        _newRoleName = "";
        _newRoleDescription = "";
        _showCreateModal = false;
        _roles = await SecurityService.GetAllRolesAsync();

        _toastMessage = "Rol creado correctamente.";
        await ShowToast();
    }

    private async Task DeleteRole()
    {
        var role = _confirmingDelete;
        _confirmingDelete = null;
        if (!_canWrite || role is null || role.IsSystemRole) return;

        await SecurityService.DeleteRoleAsync(role.Id);
        await SecurityService.LogAuditAsync(null, _actingUser, "ROLE_DELETED", $"Rol eliminado: {role.Name}");

        _roles = await SecurityService.GetAllRolesAsync();
        _toastMessage = "Rol eliminado.";
        await ShowToast();
    }

    private async Task ShowToast()
    {
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }
}







@page "/admin/seguridad/roles/{RoleId:guid}/permisos"
@attribute [Authorize(Policy = "ADMIN:READ")]
@rendermode InteractiveServer
@inject ISecurityService SecurityService
@inject AuthenticationStateProvider AuthStateProvider
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Web.Security

<PageTitle>DaviWiki - Permisos de rol</PageTitle>

<AdminNav />

@if (_loading)
{
    <div class="skeleton" style="height:60px; border-radius:var(--radius-lg); margin-bottom:var(--space-4)"></div>
    <div class="skeleton" style="height:320px; border-radius:var(--radius-lg)"></div>
}
else if (_role is null)
{
    <SecurityEmptyState IconName="shield" Title="Rol no encontrado" Description="El rol que buscás no existe o fue eliminado." />
}
else
{
    <SecurityPageHeader BackHref="/admin/seguridad/roles" BackText="Roles" Title="@($"Permisos: {_role.Name}")"
                         Subtitle="Marcá qué puede hacer este rol en cada pantalla del sistema.">
        @if (_canWrite && _isDirty)
        {
            <button class="btn btn--primary" @onclick="Save">
                <Icon Name="check-circle" /> Guardar cambios
            </button>
        }
    </SecurityPageHeader>

    @if (_isDirty)
    {
        <div class="callout callout--tip">
            <Icon Name="alert-triangle" />
            <p>Tenés cambios sin guardar.</p>
        </div>
    }

    <div class="matrix-toolbar">
        <div class="security-search">
            <Icon Name="search" />
            <input type="text" placeholder="Buscar pantalla..." aria-label="Buscar pantalla"
                   @bind="_screenSearch" @bind:event="oninput" />
        </div>
        <span class="security-toolbar__count">@FilteredScreens.Count de @_screens.Count pantallas</span>
    </div>

    @if (FilteredScreens.Count == 0)
    {
        <SecurityEmptyState IconName="search" Title="Sin resultados" Description="No hay pantallas que coincidan con la búsqueda." Inline="true" />
    }
    else
    {
        <div class="card permission-matrix-wrap">
            <table class="permission-matrix">
                <colgroup>
                    <col class="permission-matrix__screen-col" />
                    @for (int i = 0; i < _permissions.Count; i++)
                    {
                        <col />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th>Pantalla</th>
                        @foreach (var p in _permissions)
                        {
                            <th>@p.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in FilteredScreens)
                    {
                        <tr>
                            <td>@s.Name</td>
                            @foreach (var p in _permissions)
                            {
                                var key = (s.Id, p.Id);
                                var changed = _original.TryGetValue(key, out var was) && was != _matrix[key];
                                <td class="@(changed ? "matrix-changed" : "")">
                                    <label class="switch">
                                        <input type="checkbox"
                                               disabled="@(!_canWrite)"
                                               checked="@_matrix[key]"
                                               aria-label="@($"{p.Name} en {s.Name}")"
                                               @onchange="@(e => Toggle(key, (bool)e.Value!))" />
                                        <span class="switch__track"></span>
                                    </label>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_showToast)
{
    <div class="toast"><Icon Name="check-circle" /> @_toastMessage</div>
}

@code {
    [Parameter] public Guid RoleId { get; set; }

    private SecurityRole? _role;
    private List<SecurityScreen> _screens = new();
    private List<SecurityPermission> _permissions = new();
    private Dictionary<(Guid ScreenId, Guid PermissionId), bool> _matrix = new();
    private Dictionary<(Guid ScreenId, Guid PermissionId), bool> _original = new();
    private bool _loading = true;
    private bool _canWrite;
    private string _actingUser = "unknown";
    private string _screenSearch = "";
    private bool _showToast;
    private string _toastMessage = "";
    private static readonly string[] PermissionOrder = { "READ", "WRITE", "DELETE", "EXPORT", "ADMIN" };
    private bool _isDirty => !_matrix.OrderBy(kv => kv.Key).SequenceEqual(_original.OrderBy(kv => kv.Key));

    private IReadOnlyList<SecurityScreen> FilteredScreens =>
        string.IsNullOrWhiteSpace(_screenSearch)
            ? _screens
            : _screens.Where(s => s.Name.Contains(_screenSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _role = await SecurityService.GetRoleByIdAsync(RoleId);
        _screens = (await SecurityService.GetAllScreensAsync()).OrderBy(s => s.DisplayOrder).ToList();
        _permissions = (await SecurityService.GetAllPermissionsAsync())
            .OrderBy(p => Array.IndexOf(PermissionOrder, p.Code))
            .ToList();

        var granted = await SecurityService.GetRolePermissionsAsync(RoleId);
        var grantedSet = granted.Select(rp => (rp.ScreenId, rp.PermissionId)).ToHashSet();

        foreach (var s in _screens)
        {
            foreach (var p in _permissions)
            {
                _matrix[(s.Id, p.Id)] = grantedSet.Contains((s.Id, p.Id));
            }
        }

        _original = new Dictionary<(Guid, Guid), bool>(_matrix);
        _loading = false;
    }

    private void Toggle((Guid ScreenId, Guid PermissionId) key, bool value)
    {
        if (!_canWrite) return;
        _matrix[key] = value;
    }

    private async Task Save()
    {
        if (!_canWrite) return;

        var changes = _matrix
            .Where(kv => !_original.TryGetValue(kv.Key, out var was) || was != kv.Value)
            .ToList();

        foreach (var kv in changes)
        {
            var (screenId, permissionId) = kv.Key;
            await SecurityService.SetRolePermissionAsync(RoleId, screenId, permissionId, kv.Value);
        }

        if (changes.Count > 0)
        {
            await SecurityService.LogAuditAsync(null, _actingUser, "PERMISSION_CHANGED",
                $"Rol '{_role!.Name}': {changes.Count} permiso(s) modificado(s).");
        }

        _original = new Dictionary<(Guid, Guid), bool>(_matrix);

        _toastMessage = $"{changes.Count} permiso(s) guardado(s).";
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }
}





