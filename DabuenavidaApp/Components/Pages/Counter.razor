if (tagIds != null)
{
    var incomingTags = tagIds.ToHashSet();

    var existingTagLinks = await _db.ArticleTags
        .Where(at => at.ArticleId == id)
        .ToListAsync();

    var toRemove = existingTagLinks
        .Where(at => !incomingTags.Contains(at.TagId))
        .ToList();

    if (toRemove.Count > 0)
    {
        _db.ArticleTags.RemoveRange(toRemove);
    }

    var existingTagIds = existingTagLinks.Select(at => at.TagId).ToHashSet();
    var newTags = incomingTags
        .Except(existingTagIds)
        .Select(tId => new ArticleTag { ArticleId = id, TagId = tId });

    if (newTags.Any())
    {
        await _db.ArticleTags.AddRangeAsync(newTags);
    }

    await _db.SaveChangesAsync();
}