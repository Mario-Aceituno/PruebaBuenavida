                </div>
                <div class="role-card__footer">
                    <button class="btn btn--secondary btn--sm" @onclick="() => GoToMatrix(r.Id)">
                        <Icon Name="grid-3x3" /> Permisos
                    </button>
                    @if (_canWrite && !r.IsSystemRole)
                    {
                        <button class="btn btn--ghost btn--sm" @onclick="() => _confirmingDelete = r" aria-label="Eliminar rol">
                            <Icon Name="trash-2" />
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@if (_showCreateModal)
{
    <div class="modal-overlay" @onclick="() => _showCreateModal = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal__header">
                <h3>Nuevo rol</h3>
                <button class="btn btn--ghost btn--sm" @onclick="() => _showCreateModal = false" aria-label="Cerrar"><Icon Name="x" /></button>
            </div>
            <div class="modal__body">
                <div class="form-group">
                    <label class="form-label" for="roleName">Nombre <span class="form-required">*</span></label>
                    <input id="roleName" class="input" placeholder="Ej: Colaborador externo" @bind="_newRoleName" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="roleDesc">Descripción</label>
                    <input id="roleDesc" class="input" placeholder="Para qué se usa este rol" @bind="_newRoleDescription" />
                </div>
                <div class="form-actions">
                    <button class="btn btn--ghost btn--sm" @onclick="() => _showCreateModal = false">Cancelar</button>
                    <button class="btn btn--primary btn--sm" disabled="@string.IsNullOrWhiteSpace(_newRoleName)" @onclick="CreateRole">Crear rol</button>
                </div>
            </div>
        </div>
