window.editraScrollTo = (elementId) => {
    const el = document.getElementById(elementId);
    if (el) {
        el.scrollIntoView({ behavior: "smooth", block: "start" });
    }
};






@inject IJSRuntime JS

<nav class="toc">
    <p class="toc__title"><Icon Name="layers-3" />En esta página</p>
    @foreach (var h in _headings)
    {
        <a class="toc__link toc__link--lvl@(h.Meta)"
           href="#block-@h.Order"
           @onclick="() => ScrollToBlock(h.Order)"
           @onclick:preventDefault="true">@h.Text</a>
    }
</nav>

@code {
    [Parameter, EditorRequired] public List<ArticleContentBlock> Blocks { get; set; } = new();

    private List<ArticleContentBlock> _headings = new();

    protected override void OnParametersSet()
    {
        _headings = Blocks.Where(b => b.Type == ContentBlockType.Heading).OrderBy(b => b.Order).ToList();
    }

    private async Task ScrollToBlock(int order)
    {
        await JS.InvokeVoidAsync("editraScrollTo", $"block-{order}");
    }
}