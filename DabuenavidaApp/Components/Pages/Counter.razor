private static async Task SeedScreensAsync(DaviWikiDbContext db, ILogger logger)
{
    var existingCodes = await db.SecurityScreens.Select(s => s.Code).ToListAsync();
    var existingSet = existingCodes.ToHashSet();

    var allScreens = new List<SecurityScreen>
    {
        new() { Id = ScreenIds.Home, Code = "HOME", Name = "Inicio", Route = "/home", Icon = "home", DisplayOrder = 1 },
        new() { Id = ScreenIds.Articles, Code = "ARTICLES", Name = "Artículos", Route = "/articulos", Icon = "file-text", DisplayOrder = 2 },
        new() { Id = ScreenIds.ArticleEditor, Code = "ARTICLE_EDITOR", Name = "Editor de Artículos", Route = "/articulos/nuevo", Icon = "edit", DisplayOrder = 3, ParentScreenId = ScreenIds.Articles },
        new() { Id = ScreenIds.Categories, Code = "CATEGORIES", Name = "Categorías", Route = "/categorias", Icon = "folder", DisplayOrder = 4 },
        new() { Id = ScreenIds.Tags, Code = "TAGS", Name = "Etiquetas", Route = "/etiquetas", Icon = "tag", DisplayOrder = 5 },
        new() { Id = ScreenIds.Collections, Code = "COLLECTIONS", Name = "Colecciones", Route = "/colecciones", Icon = "layers", DisplayOrder = 6 },
        new() { Id = ScreenIds.Multimedia, Code = "MULTIMEDIA", Name = "Multimedia", Route = "/multimedia", Icon = "image", DisplayOrder = 7 },
        new() { Id = ScreenIds.Authors, Code = "AUTHORS", Name = "Autores", Route = "/autores", Icon = "users", DisplayOrder = 8 },
        new() { Id = ScreenIds.Incidents, Code = "INCIDENTS", Name = "Incidencias", Route = "/incidencias", Icon = "alert-circle", DisplayOrder = 9 },
        new() { Id = ScreenIds.Stats, Code = "STATS", Name = "Estadísticas", Route = "/estadisticas", Icon = "bar-chart", DisplayOrder = 10 },
        new() { Id = ScreenIds.Search, Code = "SEARCH", Name = "Búsqueda", Route = "/buscar", Icon = "search", DisplayOrder = 11 },
        new() { Id = ScreenIds.AdminPanel, Code = "ADMIN", Name = "Administración", Route = "/admin", Icon = "settings", DisplayOrder = 12 },
        new() { Id = ScreenIds.Profile, Code = "PROFILE", Name = "Perfil", Route = "/perfil", Icon = "user", DisplayOrder = 13 },
        new() { Id = ScreenIds.Activity, Code = "ACTIVITY", Name = "Actividad", Route = "/actividad", Icon = "activity", DisplayOrder = 14 },

        // --- Pantallas nuevas ---
        new() { Id = ScreenIds.Dashboard, Code = "DASHBOARD", Name = "Dashboard", Route = "/dashboard", Icon = "layout-dashboard", DisplayOrder = 15 },
        new() { Id = ScreenIds.Explore, Code = "EXPLORE", Name = "Explorar", Route = "/explorar", Icon = "compass", DisplayOrder = 16 },
        new() { Id = ScreenIds.Favorites, Code = "FAVORITES", Name = "Favoritos", Route = "/favoritos", Icon = "star", DisplayOrder = 17 },
        new() { Id = ScreenIds.History, Code = "HISTORY", Name = "Historial", Route = "/historial", Icon = "history", DisplayOrder = 18 },
        new() { Id = ScreenIds.Help, Code = "HELP", Name = "Centro de ayuda", Route = "/ayuda", Icon = "life-buoy", DisplayOrder = 19 },
    };

    var missing = allScreens.Where(s => !existingSet.Contains(s.Code)).ToList();
    if (missing.Count == 0) return;

    db.SecurityScreens.AddRange(missing);
    await db.SaveChangesAsync();
    logger.LogInformation("Pantallas nuevas agregadas: {Count}", missing.Count);
}








