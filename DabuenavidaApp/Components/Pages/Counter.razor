                        ConfirmText="@(_user?.IsActive == true ? "Desactivar" : "Activar")"
                        Dangerous="@(_user?.IsActive == true)"
                        OnConfirm="ToggleActive"
                        OnCancel="() => _confirmingToggle = false" />

<SecurityConfirmDialog Visible="_confirmingRoleChange"
                        Title="Cambiar rol"
                        Message="@RoleChangeMessage"
                        ConfirmText="Confirmar cambio"
                        OnConfirm="ChangeRole"
                        OnCancel="() => _confirmingRoleChange = false" />

@if (_showToast)
{
    <div class="toast"><Icon Name="check-circle" /> @_toastMessage</div>
}

@code {
    [Parameter] public Guid UserId { get; set; }

    private SecurityUser? _user;
    private SecurityRole? _currentRole;
    private List<SecurityRole> _allRoles = new();
    private Guid _selectedRoleId = Guid.Empty;
    private bool _loading = true;
    private bool _canWrite;
    private string _actingUser = "unknown";
    private string _tab = "role";
    private bool _confirmingToggle;
    private bool _confirmingRoleChange;
    private bool _showToast;
    private string _toastMessage = "";

    private string RoleChangeMessage
    {
        get
        {
            var newRoleName = _selectedRoleId == Guid.Empty
                ? "sin rol"
                : _allRoles.FirstOrDefault(r => r.Id == _selectedRoleId)?.Name ?? "";
            return _currentRole is null
                ? $"Se asignará el rol '{newRoleName}' a {_user?.FullName}."
                : $"El rol de {_user?.FullName} cambiará de '{_currentRole.Name}' a '{newRoleName}'.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _user = await SecurityService.GetUserByIdAsync(UserId);
        _allRoles = await SecurityService.GetAllRolesAsync();

        var userRoles = await SecurityService.GetUserRolesAsync(UserId);
        _currentRole = userRoles.FirstOrDefault();
        _selectedRoleId = _currentRole?.Id ?? Guid.Empty;

        _loading = false;
    }

    private void RequestRoleChange()
    {
        if (!_canWrite || _user is null) return;
        _confirmingRoleChange = true;
    }

    private async Task ChangeRole()
    {
        _confirmingRoleChange = false;
        if (!_canWrite || _user is null) return;

        var oldRole = _currentRole;

        if (oldRole is not null)
        {
            await SecurityService.RemoveRoleFromUserAsync(UserId, oldRole.Id);
        }

        if (_selectedRoleId != Guid.Empty)
        {
            await SecurityService.AssignRoleToUserAsync(UserId, _selectedRoleId, _actingUser);
            var newRole = _allRoles.First(r => r.Id == _selectedRoleId);
            _currentRole = newRole;

            var detail = oldRole is null
                ? $"Rol asignado: {newRole.Name}"
                : $"Rol cambiado: {oldRole.Name} -> {newRole.Name}";

            await SecurityService.LogAuditAsync(UserId, _user.Username, "ROLE_ASSIGNED", detail);
            _toastMessage = "Rol actualizado correctamente.";
        }
        else
        {
            _currentRole = null;
            await SecurityService.LogAuditAsync(UserId, _user.Username, "ROLE_REMOVED",
                oldRole is null ? "Sin cambios." : $"Rol removido: {oldRole.Name}");
            _toastMessage = "Rol removido.";
        }

        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }

    private async Task ToggleActive()
    {
        _confirmingToggle = false;
        if (_user is null) return;

        var success = await SecurityService.ToggleUserActiveAsync(_user.Id);
        if (!success) return;

        _user.IsActive = !_user.IsActive;
        await SecurityService.LogAuditAsync(null, _actingUser,
            _user.IsActive ? "USER_ACTIVATED" : "USER_DEACTIVATED", $"Usuario afectado: {_user.Username}");

        _toastMessage = _user.IsActive ? "Usuario activado." : "Usuario desactivado.";
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..1].ToUpper() : $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}







@page "/admin/seguridad/roles"
