@if (_canWrite)
{
    <div class="matrix-bulk">
        <span>Aplicar a todas las visibles:</span>
        <div class="segmented" role="group" aria-label="Aplicar nivel a todas las pantallas visibles">
            <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("none")'>Sin acceso</button>
            <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("read")'>Lectura</button>
            <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("write")'>Editor</button>
            <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("admin")'>Total</button>
        </div>
    </div>
}







<div class="segmented" role="group" aria-label="@($"Nivel de acceso para {s.Name}")">
    <button class="segmented__btn @(preset == "none" ? "segmented__btn--active" : "")"
            disabled="@(!_canWrite)" @onclick='() => ApplyPreset(s.Id, "none")'>Sin acceso</button>
    <button class="segmented__btn @(preset == "read" ? "segmented__btn--active" : "")"
            disabled="@(!_canWrite)" @onclick='() => ApplyPreset(s.Id, "read")'>Lectura</button>
    <button class="segmented__btn @(preset == "write" ? "segmented__btn--active" : "")"
            disabled="@(!_canWrite)" @onclick='() => ApplyPreset(s.Id, "write")'>Editor</button>
    <button class="segmented__btn @(preset == "admin" ? "segmented__btn--active" : "")"
            disabled="@(!_canWrite)" @onclick='() => ApplyPreset(s.Id, "admin")'>Total</button>
    @if (preset == "custom")
    {
        <span class="segmented__custom-tag">Personalizado</span>
    }
</div>