public static void AddDaviWikiPolicies(this AuthorizationOptions options)
{
    var screenCodes = new[]
    {
        "HOME", "ARTICLES", "ARTICLE_EDITOR", "ARTICLE_DETAIL", "CATEGORIES", "TAGS",
        "COLLECTIONS", "MULTIMEDIA", "AUTHORS", "INCIDENTS", "STATS",
        "SEARCH", "ADMIN", "PROFILE", "ACTIVITY",
        "DASHBOARD", "EXPLORE", "FAVORITES", "HISTORY", "HELP"
    };

    var permissionCodes = new[] { "READ", "WRITE", "DELETE", "EXPORT", "ADMIN" };

    foreach (var screen in screenCodes)
    {
        foreach (var permission in permissionCodes)
        {
            var policyName = $"{screen}:{permission}";
            options.AddPolicy(policyName, policy =>
                policy.Requirements.Add(new ScreenPermissionRequirement(screen, permission)));
        }
    }
}



