private string BuildJourneyRoute()
{
    if (_journey.Count == 0)
        return string.Empty;

    return string.Join(" → ", _journey.Select(j => j.AreaName));
}


private double GetActivePercentage()
{
    if (_journeyStep is null)
        return 0;

    var total = _journeyStep.ActiveHours + _journeyStep.DeadHours;

    if (total <= 0)
        return 0;

    return Math.Round((_journeyStep.ActiveHours / total) * 100, 0);
}


private double GetWaitingPercentage()
{
    if (_journeyStep is null)
        return 0;

    var total = _journeyStep.ActiveHours + _journeyStep.DeadHours;

    if (total <= 0)
        return 0;

    return Math.Round((_journeyStep.DeadHours / total) * 100, 0);
}


private string BuildStageConclusion()
{
    if (_journeyStep is null)
        return string.Empty;

    var activity = _journeyStep.Activity.Count;
    var users = _journeyStep.Users.Count;

    if (_journeyStepIndex == _journey.Count - 1)
    {
        return $"Esta área mantiene actualmente el seguimiento del incidente. " +
               $"Participaron {users} personas y se registraron {activity} actividades.";
    }

    if (_journeyStep.Transfers.Count > 0)
    {
        var transfer = _journeyStep.Transfers.First();

        return $"El equipo trabajó esta etapa y posteriormente transfirió " +
               $"el incidente hacia {transfer.ToAreaName}.";
    }

    return $"Esta etapa contó con {users} participantes " +
           $"y {activity} actividades registradas.";
}


private string GetResponsibleSince()
{
    if (_detail is null || _journeyStep is null)
        return string.Empty;

    var responsible = _journeyStep.Users
        .FirstOrDefault(u => u.Id == _detail.ResponsibleId);

    if (responsible is null)
        return string.Empty;

    var activity = _journeyStep.Activity
        .Where(a => a.ActorName == responsible.FullName)
        .OrderBy(a => a.OccurredAt)
        .FirstOrDefault();

    return activity is null
        ? string.Empty
        : activity.OccurredAt.ToRelativeLabel();
}


<div class="journey-context">

    <div class="journey-context__item">
        <span>Recorrido</span>
        <strong>@BuildJourneyRoute()</strong>
    </div>

    <div class="journey-context__item">
        <span>Estado</span>
        <strong>@GetJourneyStageLabel()</strong>
    </div>

</div>



<div class="journey-metric journey-metric--distribution">

    <Icon Name="pie-chart" />

    <div>
        <span class="journey-metric__value">
            @GetActivePercentage()%
        </span>

        <span class="journey-metric__label">
            Trabajo efectivo
        </span>

        <small>
            @GetWaitingPercentage()% espera
        </small>
    </div>

</div>




<span class="badge badge--brand">
    <Icon Name="star" />
    Responsable actual
</span>

@if (!string.IsNullOrEmpty(GetResponsibleSince()))
{
    <p class="journey-responsible-time">
        Desde @GetResponsibleSince()
    </p>
}



<div class="journey-conclusion">

    <Icon Name="sparkles" />

    <div>
        <strong>
            Conclusión de esta etapa
        </strong>

        <p>
            @BuildStageConclusion()
        </p>
    </div>

</div>



.journey-context {
    display:flex;
    gap:var(--space-4);
    padding:var(--space-3) var(--space-6);
    border-bottom:1px solid var(--border-subtle);
    flex-wrap:wrap;
}

.journey-context__item {
    display:flex;
    flex-direction:column;
    gap:2px;
}

.journey-context__item span {
    font-size:var(--fs-xs);
    color:var(--text-tertiary);
}

.journey-context__item strong {
    font-size:var(--fs-sm);
    color:var(--text-primary);
}


.journey-metric--distribution small {
    font-size:var(--fs-xs);
    color:var(--text-tertiary);
}


.journey-responsible-time {
    margin-top:4px;
    font-size:var(--fs-xs);
    color:var(--text-tertiary);
}


.journey-conclusion {

    display:flex;
    gap:var(--space-3);

    margin-top:var(--space-6);
    padding:var(--space-4);

    background:var(--bg-surface-2);
    border:1px solid var(--border-subtle);
    border-radius:var(--radius-md);

}

.journey-conclusion p {

    margin-top:var(--space-1);
    font-size:var(--fs-sm);
    color:var(--text-secondary);
    line-height:1.5;

}