/* ===== AdminNav / security-nav — estilos base (desktop y default) ===== */
.security-nav {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--border-default);
}

.security-nav__label {
  font-size: var(--fs-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-tertiary);
  white-space: nowrap;
  flex-shrink: 0;
}

.security-nav__items {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.security-nav__item {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 8px 14px;
  border-radius: var(--radius-md);
  color: var(--text-tertiary);
  font-size: var(--fs-sm);
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  transition: background var(--transition-fast), color var(--transition-fast);
}

.security-nav__item .icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.security-nav__item:hover {
  color: var(--text-primary);
  background: var(--bg-hover);
}

.security-nav__item--active {
  color: var(--brand-500);
  background: var(--bg-surface-2);
}





@media (max-width: 720px) {
  .security-header { flex-direction: column; }
  .security-toolbar__count { margin-left: 0; }
  .entity-header { flex-direction: column; align-items: flex-start; }
  .bulk-action-bar { flex-direction: column; align-items: flex-start; }

  /* El nav pasa de fila a columna, con los items en scroll horizontal */
  .security-nav {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .security-nav__items {
    width: 100%;
    overflow-x: auto;
  }
}