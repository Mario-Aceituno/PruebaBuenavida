public class ArticleOwnershipHandler : AuthorizationHandler<MustBeArticleOwnerRequirement, Article>
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;

    public ArticleOwnershipHandler(IDbContextFactory<DaviWikiDbContext> dbFactory)
    {
        _dbFactory = dbFactory;
    }

    protected override async Task HandleRequirementAsync(
        AuthorizationHandlerContext context, MustBeArticleOwnerRequirement requirement, Article resource)
    {
        var user = context.User;
        var isContentAdmin = user.Claims.Any(c =>
            c.Type == "Permission:ARTICLES" && c.Value == "ADMIN");

        if (isContentAdmin)
        {
            context.Succeed(requirement);
            return;
        }

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out var userId))
            return;

        // Contexto propio, aislado — nunca compite con EfWikiDataService
        await using var db = await _dbFactory.CreateDbContextAsync();
        var isOwner = await db.Authors
            .AsNoTracking()
            .AnyAsync(a => a.Id == resource.AuthorId && a.SecurityUserId == userId);

        if (isOwner)
        {
            context.Succeed(requirement);
        }
    }
}






