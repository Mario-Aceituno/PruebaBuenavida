-- 1. Identifica los Authors huérfanos
SELECT a.Id
INTO #OrphanAuthors
FROM Authors a
LEFT JOIN dbo.security_users su ON su.Id = a.SecurityUserId
WHERE a.SecurityUserId IS NOT NULL AND su.Id IS NULL;

-- 2. Revisa dependencias antes de borrar (ajusta nombres de FK según tu esquema)
SELECT * FROM Notifications WHERE RecipientUserId IN (SELECT Id FROM #OrphanAuthors);
SELECT * FROM Articles WHERE AuthorId IN (SELECT Id FROM #OrphanAuthors);
SELECT * FROM Article_Comments WHERE AuthorId IN (SELECT Id FROM #OrphanAuthors);

-- 3. Si no hay dependencias críticas, elimina
DELETE FROM Authors WHERE Id IN (SELECT Id FROM #OrphanAuthors);

DROP TABLE #OrphanAuthors;