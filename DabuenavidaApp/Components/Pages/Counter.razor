[Inject] private UploadFileUseCase UploadFile { get; set; } = default!;
[Inject] private IFileStorageService Storage { get; set; } = default!;
// Data (IWikiDataService) ya debe estar inyectado

private bool _uploadingCover;
private string? _coverPreviewUrl;

private async Task OnCoverSelected(InputFileChangeEventArgs e)
{
    var file = e.File;
    if (file is null) return;

    _uploadingCover = true;
    StateHasChanged();

    try
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);

        var request = new FileUploadRequest
        {
            Content = stream,
            FileName = file.Name,
            ContentType = file.ContentType,
            SizeInBytes = file.Size,
            Category = FileCategory.ArticleCover
        };

        var uploadResult = await UploadFile.ExecuteAsync(request);

        if (!uploadResult.IsSuccess)
        {
            _error = uploadResult.ErrorMessage;
            return;
        }

        var mediaFile = new MediaFile
        {
            Id = Guid.NewGuid(),
            FileName = file.Name,
            Type = MediaType.Image,
            StorageUrl = uploadResult.Key!,
            SizeInBytes = file.Size,
            AuthorId = _model.AuthorId,
            UploadedAt = DateTime.UtcNow
        };

        var createdMedia = await Data.CreateMediaFileAsync(mediaFile);

        _model.CoverImageMediaId = createdMedia.Id;
        _coverPreviewUrl = Storage.GetPublicUrl(createdMedia.StorageUrl);
    }
    finally
    {
        _uploadingCover = false;
        StateHasChanged();
    }
}








