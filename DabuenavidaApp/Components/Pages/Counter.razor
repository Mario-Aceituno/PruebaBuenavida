/* ===== Security Page Header (nuevo, compartido) ===== */
.security-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
}
.security-header__back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    transition: color var(--transition-fast);
}
.security-header__back:hover { color: var(--brand-500); }
.security-header__back .icon { width: 14px; height: 14px; }
.security-header__titles h1 { margin-bottom: 4px; }
.security-header__titles p { color: var(--text-tertiary); font-size: var(--fs-sm); max-width: 560px; }
.security-header__actions { display: flex; gap: var(--space-2); align-items: center; flex-shrink: 0; }

/* ===== Toolbar: búsqueda + filtros ===== */
.security-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
}
.security-search {
    position: relative;
    flex: 1;
    min-width: 220px;
    max-width: 340px;
}
.security-search .icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 15px; height: 15px;
    color: var(--text-tertiary);
    pointer-events: none;
}
.security-search input {
    width: 100%;
    padding: 8px 12px 8px 34px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    font-size: var(--fs-sm);
    transition: border-color var(--transition-fast);
}
.security-search input:focus { border-color: var(--brand-500); }
.security-filter-group { display: flex; gap: 4px; padding: 3px; background: var(--bg-surface-2); border-radius: var(--radius-md); }
.security-filter-btn {
    padding: 6px 12px;
    border-radius: var(--radius-sm, 6px);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-tertiary);
    transition: background var(--transition-fast), color var(--transition-fast);
}
.security-filter-btn:hover { color: var(--text-primary); }
.security-filter-btn--active { background: var(--bg-elevated); color: var(--text-primary); box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.1)); }
.security-toolbar__count { margin-left: auto; font-size: var(--fs-xs); color: var(--text-tertiary); white-space: nowrap; }

/* ===== Data table (usuarios / auditoría) ===== */
.data-table-wrap { overflow-x: auto; }
.data-table { width: 100%; border-collapse: collapse; min-width: 640px; }
.data-table thead th {
    text-align: left;
    padding: var(--space-3) var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border-default);
    white-space: nowrap;
}
.data-table tbody td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
    font-size: var(--fs-sm);
}
.data-table tbody tr { transition: background var(--transition-fast); }
.data-table tbody tr:hover { background: var(--bg-hover); }
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table__user-cell { display: flex; align-items: center; gap: var(--space-3); }
.data-table__user-info { display: flex; flex-direction: column; line-height: 1.3; }
.data-table__user-name { font-weight: 600; color: var(--text-primary); }
.data-table__user-sub { font-size: var(--fs-xs); color: var(--text-tertiary); }
.data-table__actions { text-align: right; }
.data-table--clickable tbody tr { cursor: pointer; }
.data-table th.sortable { cursor: pointer; user-select: none; }
.data-table th.sortable:hover { color: var(--text-primary); }
.data-table th.sortable .icon { width: 12px; height: 12px; vertical-align: -1px; margin-left: 2px; opacity: 0.6; }

/* ===== Status badge ===== */
.status-badge { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-xs); font-weight: 700; padding: 3px 9px; border-radius: var(--radius-full); }
.status-badge__dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.status-badge--active { background: rgba(16,185,129,0.12); color: #0a8a5f; }
.status-badge--active .status-badge__dot { background: #10b981; }
[data-theme="dark"] .status-badge--active { color: #34d399; }
.status-badge--inactive { background: var(--bg-surface-3); color: var(--text-tertiary); }
.status-badge--inactive .status-badge__dot { background: var(--text-tertiary); }

/* ===== Role cards ===== */
.role-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-4); }
.role-card { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); }
.role-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
.role-card__icon { width: 38px; height: 38px; border-radius: var(--radius-md); background: var(--gradient-brand); color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.role-card__icon .icon { width: 18px; height: 18px; }
.role-card__name { font-weight: 700; font-size: var(--fs-md); }
.role-card__desc { font-size: var(--fs-sm); color: var(--text-tertiary); flex: 1; line-height: 1.5; }
.role-card__footer { display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); }

/* ===== Detail header (usuario) ===== */
.entity-header { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
.entity-header .avatar { width: 56px; height: 56px; font-size: var(--fs-lg); }
.entity-header__meta { font-size: var(--fs-sm); color: var(--text-tertiary); display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; margin-top: 4px; }

/* ===== Tabs (detalle) ===== */
.security-tabs { display: flex; gap: var(--space-1); border-bottom: 1px solid var(--border-default); margin: var(--space-6) 0 var(--space-5); }
.security-tab { padding: var(--space-3) var(--space-1); margin-right: var(--space-5); font-size: var(--fs-sm); font-weight: 600; color: var(--text-tertiary); border-bottom: 2px solid transparent; transition: color var(--transition-fast), border-color var(--transition-fast); }
.security-tab:hover { color: var(--text-primary); }
.security-tab--active { color: var(--brand-500); border-color: var(--brand-500); }

/* ===== Drawer (auditoría) ===== */
.drawer-overlay { position: fixed; inset: 0; z-index: var(--z-modal); background: rgba(0,0,0,0.45); animation: fadeIn 0.15s var(--ease); display: flex; justify-content: flex-end; }
.drawer { width: 100%; max-width: 420px; height: 100%; background: var(--bg-elevated); border-left: 1px solid var(--border-default); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; animation: slideInRight 0.2s var(--ease); }
@keyframes slideInRight { from { transform: translateX(24px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
.drawer__header { display: flex; align-items: center; justify-content: space-between; padding: var(--space-5); border-bottom: 1px solid var(--border-subtle); }
.drawer__body { padding: var(--space-5); overflow-y: auto; flex: 1; }
.drawer__row { display: flex; flex-direction: column; gap: 2px; padding: var(--space-3) 0; border-bottom: 1px solid var(--border-subtle); }
.drawer__row:last-child { border-bottom: none; }
.drawer__row-label { font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-tertiary); }
.drawer__row-value { font-size: var(--fs-sm); color: var(--text-primary); }

/* ===== Toast (feedback de guardado) ===== */
.toast { position: fixed; bottom: var(--space-6); right: var(--space-6); z-index: 999; display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); background: var(--bg-elevated); border: 1px solid var(--border-default); border-left: 3px solid #10b981; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); font-size: var(--fs-sm); font-weight: 600; animation: slideInLeft 0.2s var(--ease); }
.toast .icon { color: #10b981; width: 16px; height: 16px; }

/* ===== Permission matrix: agrupación + búsqueda ===== */
.matrix-toolbar { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); flex-wrap: wrap; }
.matrix-group-header td { background: var(--bg-surface-2); font-weight: 700; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-tertiary); padding: 6px var(--space-2) !important; }
.matrix-changed { position: relative; }
.matrix-changed::after { content: ""; position: absolute; top: 6px; right: 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--brand-500); }

@media (max-width: 720px) {
    .security-header { flex-direction: column; }
    .security-toolbar__count { margin-left: 0; }
    .entity-header { flex-direction: column; align-items: flex-start; }
}






