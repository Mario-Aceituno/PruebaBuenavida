namespace Application.Common.Models;

/// <summary>
/// Resultado de una operación de subida de archivo al storage configurado.
/// </summary>
public sealed record FileUploadResult
{
    public required bool IsSuccess { get; init; }
    public string? Key { get; init; }
    public string? ErrorMessage { get; init; }

    public static FileUploadResult Success(string key) =>
        new() { IsSuccess = true, Key = key };

    public static FileUploadResult Failure(string errorMessage) =>
        new() { IsSuccess = false, ErrorMessage = errorMessage };
}