else if (_roles.Count == 0)
{
    <SecurityEmptyState IconName="shield" Title="No hay roles creados"
                         Description="Creá un rol para empezar a asignar permisos por pantalla."
                         ActionText="@(_canWrite ? "Nuevo rol" : null)"
                         OnAction="() => _showCreateModal = true" />
}
else
{
    <div class="role-card-grid">
        @foreach (var r in _roles)
        {
            <div class="card role-card">
                <div class="role-card__top">
                    <div class="role-card__icon"><Icon Name="shield" /></div>
                    @if (r.IsSystemRole)
                    {
                        <span class="badge">Sistema</span>
                    }
                </div>
                <div>
                    <div class="role-card__name">@r.Name</div>
