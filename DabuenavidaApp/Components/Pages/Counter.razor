private static async Task SeedMissingScreenPermissionsAsync(DaviWikiDbContext db, ILogger logger)
{
    var systemRoleIds = new[] { RoleIds.Admin, RoleIds.Editor, RoleIds.Reader };
    var existingRoleIds = await db.SecurityRoles
        .Where(r => systemRoleIds.Contains(r.Id))
        .Select(r => r.Id)
        .ToListAsync();

    if (existingRoleIds.Count == 0) return; // SeedRolesAsync todavía no corrió

    var allPermissionIds = new[] { PermissionIds.Read, PermissionIds.Write, PermissionIds.Delete, PermissionIds.Export, PermissionIds.Admin };
    var contentPermissionIds = new[] { PermissionIds.Read, PermissionIds.Write };
    var readOnlyPermissionIds = new[] { PermissionIds.Read };

    var allScreenIds = await db.SecurityScreens.Select(s => s.Id).ToListAsync();
    var contentScreenIds = allScreenIds.Where(id => id != ScreenIds.AdminPanel).ToList();

    var existingSet = (await db.SecurityRolePermissions
        .Select(rp => new { rp.RoleId, rp.ScreenId, rp.PermissionId })
        .ToListAsync())
        .Select(a => (a.RoleId, a.ScreenId, a.PermissionId))
        .ToHashSet();

    var toAdd = new List<SecurityRolePermission>();

    void AddIfMissing(Guid roleId, Guid screenId, Guid permId)
    {
        if (existingSet.Add((roleId, screenId, permId)))
            toAdd.Add(new SecurityRolePermission { RoleId = roleId, ScreenId = screenId, PermissionId = permId });
    }

    if (existingRoleIds.Contains(RoleIds.Admin))
        foreach (var screenId in allScreenIds)
            foreach (var permId in allPermissionIds)
                AddIfMissing(RoleIds.Admin, screenId, permId);

    if (existingRoleIds.Contains(RoleIds.Editor))
        foreach (var screenId in contentScreenIds)
            foreach (var permId in contentPermissionIds)
                AddIfMissing(RoleIds.Editor, screenId, permId);

    if (existingRoleIds.Contains(RoleIds.Reader))
        foreach (var screenId in contentScreenIds)
            foreach (var permId in readOnlyPermissionIds)
                AddIfMissing(RoleIds.Reader, screenId, permId);

    if (toAdd.Count == 0) return;

    db.SecurityRolePermissions.AddRange(toAdd);
    await db.SaveChangesAsync();
    logger.LogInformation("Permisos de paridad agregados a roles de sistema: {Count}", toAdd.Count);
}






await SeedPermissionsAsync(db, logger);
await SeedScreensAsync(db, logger);
