.journey-modal__dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--border-strong);

    cursor: pointer;

    transition:
        transform .20s ease,
        background-color .20s ease,
        opacity .20s ease,
        box-shadow .20s ease;

    opacity: .65;
}


.journey-modal__dot--active {
    transform: scale(1.45);
    opacity: 1;
    box-shadow: 0 0 0 4px rgba(255,255,255,.08);
}

.journey-modal__dot:hover {
    transform: scale(1.2);
    opacity: .9;
}