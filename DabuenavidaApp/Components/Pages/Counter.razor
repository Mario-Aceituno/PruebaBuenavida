<div class="journey-context__route">

    @for (var i = 0; i < _journey.Count; i++)
    {
        var area = _journey[i];

        <span class="journey-context__area
            @(i == _journeyStepIndex ? "journey-context__area--active" : "")"
              
              @onclick="() => GoToJourneyStep(i)"
              title="Paso @(i + 1): @area.AreaName">

            @(i + 1). @area.AreaName

        </span>


        @if (i < _journey.Count - 1)
        {
            <Icon Name="chevron-right" />
        }
    }

</div>






.journey-context__area {
    cursor: pointer;
    transition:
        transform .18s ease,
        background .18s ease,
        box-shadow .18s ease;
}


.journey-context__area:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
}


.journey-context__area--active {
    transform: scale(1.04);
}






var isReturn = _journey.Take(i)
    .Any(x => x.AreaName == area.AreaName);






.journey-return {

    margin-left:6px;

    font-size:var(--fs-xs);

    color:var(--text-tertiary);

    font-weight:600;

}





.journey-modal__body {
    animation-duration: .25s;
}


.journey-modal__body--next {
    animation-name: journeySlideNext;
}


.journey-modal__body--prev {
    animation-name: journeySlidePrev;
}


@keyframes journeySlideNext {

    from {
        opacity:0;
        transform:translateX(20px);
    }

    to {
        opacity:1;
        transform:translateX(0);
    }

}


@keyframes journeySlidePrev {

    from {
        opacity:0;
        transform:translateX(-20px);
    }

    to {
        opacity:1;
        transform:translateX(0);
    }

}





