public static class InlineMarkdown
{
    private static readonly Regex CodeRegex = new(@"`([^`\n]+)`", RegexOptions.Compiled);
    private static readonly Regex LinkRegex = new(@"\[([^\]\n]+)\]\((https?://[^\s)]+)\)", RegexOptions.Compiled);
    private static readonly Regex BoldRegex = new(@"\*\*([^\*\n]+)\*\*", RegexOptions.Compiled);
    private static readonly Regex ItalicRegex = new(@"(?<!\*)\*([^\*\n]+)\*(?!\*)", RegexOptions.Compiled);

    // Captura indentación (pares de 2 espacios), tipo de marcador y contenido
    private static readonly Regex ListLineRegex = new(@"^(?<indent>(?: {2})*)(?<marker>[-*]|\d+\.)\s+(?<content>.*)$", RegexOptions.Compiled);

    public static MarkupString Render(string? text)
    {
        if (string.IsNullOrEmpty(text)) return new MarkupString(string.Empty);

        var lines = text.Replace("\r\n", "\n").Split('\n');
        var sb = new StringBuilder();

        // Pila de listas abiertas: (nivel, tag "ul"|"ol")
        var stack = new Stack<(int Level, string Tag)>();

        void CloseTo(int level)
        {
            while (stack.Count > 0 && stack.Peek().Level >= level)
                sb.Append("</").Append(stack.Pop().Tag).Append('>');
        }

        foreach (var rawLine in lines)
        {
            var match = ListLineRegex.Match(rawLine);

            if (match.Success)
            {
                var level = match.Groups["indent"].Value.Length / 2;
                var isNumbered = char.IsDigit(match.Groups["marker"].Value[0]);
                var tag = isNumbered ? "ol" : "ul";

                // Cerrar niveles más profundos o del mismo nivel con tag distinto
                while (stack.Count > 0 && (stack.Peek().Level > level ||
                       (stack.Peek().Level == level && stack.Peek().Tag != tag)))
                {
                    sb.Append("</").Append(stack.Pop().Tag).Append('>');
                }

                if (stack.Count == 0 || stack.Peek().Level < level)
                {
                    sb.Append('<').Append(tag).Append(" class=\"editra-preview__list editra-preview__list--lvl")
                      .Append(level).Append("\">");
                    stack.Push((level, tag));
                }

                sb.Append("<li>").Append(RenderInline(match.Groups["content"].Value)).Append("</li>");
            }
            else
            {
                CloseTo(0);
                sb.Append(RenderInline(rawLine)).Append("<br />");
            }
        }

        CloseTo(0);

        return new MarkupString(sb.ToString());
    }

    private static string RenderInline(string line)
    {
        var html = System.Net.WebUtility.HtmlEncode(line);
        html = CodeRegex.Replace(html, "<code class=\"inline-code\">$1</code>");
        html = LinkRegex.Replace(html, "<a href=\"$2\" target=\"_blank\" rel=\"noopener noreferrer\">$1</a>");
        html = BoldRegex.Replace(html, "<strong>$1</strong>");
        html = ItalicRegex.Replace(html, "<em>$1</em>");
        return html;
    }
}





@if (!ReadOnly)
{
    <div class="editra-toolbar">
        <button type="button" class="editra-chip-btn" title="Viñetas" @onclick='() => ToggleListMarker("-")'>
            <Icon Name="list" /> Viñeta
        </button>
        <button type="button" class="editra-chip-btn" title="Lista numerada" @onclick='() => ToggleListMarker("1.")'>
            <Icon Name="list-ordered" /> Numerada
        </button>
        <button type="button" class="editra-icon-btn" title="Aumentar sangría" @onclick="() => ChangeIndent(1)">
            <Icon Name="indent" />
        </button>
        <button type="button" class="editra-icon-btn" title="Disminuir sangría" @onclick="() => ChangeIndent(-1)">
            <Icon Name="outdent" />
        </button>
    </div>
}






private static readonly Regex LineListRegex = new(@"^(?<indent>(?: {2})*)(?<marker>[-*]|\d+\.)\s+(?<content>.*)$", RegexOptions.Compiled);

private async Task ToggleListMarker(string markerType)
{
    var (lines, firstLine, lastLine) = await GetSelectedLines();

    var anyContentLine = false;
    var allThisType = true;
    for (var i = firstLine; i <= lastLine; i++)
    {
        var trimmed = lines[i].TrimStart(' ');
        if (trimmed.Length == 0) continue;
        anyContentLine = true;

        var m = LineListRegex.Match(lines[i]);
        var isThisType = m.Success && (markerType == "-"
            ? !char.IsDigit(m.Groups["marker"].Value[0])
            : char.IsDigit(m.Groups["marker"].Value[0]));

        if (!isThisType) allThisType = false;
    }
    var shouldRemove = anyContentLine && allThisType;

    for (var i = firstLine; i <= lastLine; i++)
    {
        var line = lines[i];
        var m = LineListRegex.Match(line);
        var indent = m.Success ? m.Groups["indent"].Value : "";
        var content = m.Success ? m.Groups["content"].Value : line.TrimStart(' ');

        lines[i] = shouldRemove
            ? indent + content
            : indent + markerType + " " + content;
    }

    await ApplyLines(lines, firstLine, lastLine);
}

private async Task ChangeIndent(int delta)
{
    var (lines, firstLine, lastLine) = await GetSelectedLines();

    for (var i = firstLine; i <= lastLine; i++)
    {
        var m = LineListRegex.Match(lines[i]);
        if (!m.Success) continue; // solo afecta líneas que ya son lista

        var level = Math.Max(0, m.Groups["indent"].Value.Length / 2 + delta);
        lines[i] = new string(' ', level * 2) + m.Groups["marker"].Value + " " + m.Groups["content"].Value;
    }

    await ApplyLines(lines, firstLine, lastLine);
}

private sealed record TextSelection(int Start, int End);

private async Task<(string[] Lines, int FirstLine, int LastLine)> GetSelectedLines()
{
    var selection = await JS.InvokeAsync<TextSelection?>("editraTextarea.getSelection", ParagraphElementId);

    var text = (Block.Text ?? string.Empty).Replace("\r\n", "\n");
    var lines = text.Split('\n');

    var selStart = selection?.Start ?? 0;
    var selEnd = selection?.End ?? text.Length;
    if (selEnd < selStart) (selStart, selEnd) = (selEnd, selStart);

    var lineStarts = new int[lines.Length];
    var offset = 0;
    for (var i = 0; i < lines.Length; i++)
    {
        lineStarts[i] = offset;
        offset += lines[i].Length + 1;
    }

    var firstLine = 0;
    for (var i = 0; i < lines.Length; i++)
    {
        firstLine = i;
        if (selStart <= lineStarts[i] + lines[i].Length) break;
    }

    var lastLine = firstLine;
    for (var i = lines.Length - 1; i >= 0; i--)
    {
        if (lineStarts[i] <= selEnd) { lastLine = i; break; }
    }
    if (lastLine < firstLine) lastLine = firstLine;

    return (lines, firstLine, lastLine);
}

private async Task ApplyLines(string[] lines, int firstLine, int lastLine)
{
    Block.Text = string.Join('\n', lines);
    await Changed();

    var newLineStarts = new int[lines.Length];
    var newOffset = 0;
    for (var i = 0; i < lines.Length; i++)
    {
        newLineStarts[i] = newOffset;
        newOffset += lines[i].Length + 1;
    }

    var newSelStart = newLineStarts[firstLine];
    var newSelEnd = newLineStarts[lastLine] + lines[lastLine].Length;

    await JS.InvokeVoidAsync("editraTextarea.setSelection", ParagraphElementId, newSelStart, newSelEnd);
}






