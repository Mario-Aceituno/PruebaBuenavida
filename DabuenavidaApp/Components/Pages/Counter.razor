@page "/tags"
@rendermode InteractiveServer
@inject IWikiDataService Data
@inject IAppSettingsService Settings
@inject IToastService Toast

<PageTitle>DaviWiki - Etiquetas</PageTitle>

<div class="page-header">
    <div>
        <h1>Etiquetas</h1>
        <p>@_tags.Count etiquetas usadas en toda la DaviWiki.</p>
    </div>
    <div class="page-header__actions">
        <button class="btn btn--primary" @onclick="OpenNewTagModal">
            <Icon Name="plus" /> Nueva Etiqueta
        </button>
    </div>
</div>

<section class="section">
    <SectionHeader Title="Más usadas" />
    <div class="tag-cloud">
        @foreach (var tag in _tags.OrderByDescending(t => t.UsageCount).Take(30))
        {
            <TagChip Tag="tag" ShowCount="true" SizeClass="@SizeFor(tag.UsageCount)" />
        }
    </div>
</section>

<section class="section">
    <SectionHeader Title="Gestionar etiquetas" Subtitle="Editá el nombre de cualquier etiqueta existente" />
    <div class="explorer-toolbar">
        <div class="explorer-search">
            <Icon Name="search" />
            <input class="explorer-search__input" 
                   type="text" 
                   placeholder="Buscar etiqueta por nombre..." 
                   @bind="_query" 
                   @bind:event="oninput" 
                   @bind:after="ApplyFilters" />
        </div>
    </div>
    <div class="media-list card">
        @foreach (var tag in _pageItems)
        {
            <div class="media-list-row">
                <div class="article-list-item__icon">
                    <Icon Name="tag" />
                </div>
                <div class="media-list-row__info">
                    <div class="media-list-row__name">@tag.Name</div>
                    <div class="media-list-row__meta">/etiquetas/@tag.Slug</div>
                </div>
                <span class="badge">@tag.UsageCount usos</span>
                <div class="row-actions">
                    <button class="icon-btn icon-btn--ghost" title="Editar" @onclick="() => OpenEditTagModal(tag)">
                        <Icon Name="pencil" />
                    </button>
                </div>
            </div>
        }
    </div>
    <Pagination TotalItems="_filteredTags.Count" PageSize="_pageSize" CurrentPage="_page" CurrentPageChanged="OnPageChanged" />
</section>

<Modal IsOpen="_showModal" IsOpenChanged="OnModalOpenChanged" Title="@(_editingId is null ? "Nueva Etiqueta" : "Editar Etiqueta")">
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="form-group">
            <label class="form-label" for="tag-name">Nombre <span class="form-required">*</span></label>
            <InputText id="tag-name" class="input" @bind-Value="_form.Name" placeholder="Ej: Onboarding" />
            <ValidationMessage For="@(() => _form.Name)" />
        </div>

        @if (_editingId is null)
        {
            <p class="form-hint">
                <Icon Name="info" /> Esta vista previa agrega la etiqueta solo en tu pantalla actual; la base de datos de ejemplo (Mock Data) no se modifica.
            </p>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="callout callout--danger">
                <Icon Name="alert-triangle" />
                <p>@_error</p>
            </div>
        }

        <div class="form-actions">
            <button type="button" class="btn btn--secondary" @onclick="CloseModal">Cancelar</button>
            <button type="submit" class="btn btn--primary">
                <Icon Name="@(_editingId is null ? "plus" : "check-circle")" />
                @(_editingId is null ? "Crear etiqueta" : "Guardar cambios")
            </button>
        </div>
    </EditForm>
</Modal>






using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Components;
using CorpWiki.Domain.Entities;

namespace CorpWiki.Web.Components.Pages;

public partial class Etiquetas
{
    private List<Tag> _tags = new();
    private List<Tag> _pageItems = new();
    private int _maxUsage = 1;

    private int _page = 1;
    private int _pageSize = 10;

    private bool _showModal;
    private Guid? _editingId;
    private TagFormModel _form = new();
    private string? _error;

    private string _query = string.Empty;
    private List<Tag> _filteredTags = new();

    protected override async Task OnInitializedAsync()
    {
        _pageSize = Settings.DefaultPageSize;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _tags = (await Data.GetTagsAsync()).ToList();
        RecalculateMax();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            _filteredTags = _tags.ToList();
        }
        else
        {
            _filteredTags = _tags
                .Where(t => t.Name.Contains(_query, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        ApplyPage();
    }

    private void ApplyPage()
    {
        _pageItems = _filteredTags
            .Skip((_page - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private void OnPageChanged(int page)
    {
        _page = page;
        ApplyPage();
    }

    private void RecalculateMax()
    {
        _maxUsage = _tags.Any() ? _tags.Max(t => t.UsageCount) : 1;
    }

    private string SizeFor(int usage)
    {
        double ratio = (double)usage / _maxUsage;
        return ratio switch
        {
            >= 0.8 => "tag-chip--lg",
            >= 0.4 => "tag-chip--md",
            _ => "tag-chip--sm"
        };
    }

    private void OpenNewTagModal()
    {
        _editingId = null;
        _form = new TagFormModel();
        _error = null;
        _showModal = true;
    }

    private void OpenEditTagModal(Tag tag)
    {
        _editingId = tag.Id;
        _form = new TagFormModel { Name = tag.Name };
        _error = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private void OnModalOpenChanged(bool isOpen)
    {
        _showModal = isOpen;
    }

    private async Task SaveAsync()
    {
        _error = null;
        try
        {
            if (_editingId is null)
            {
                await Data.CreateTagAsync(_form.Name);
                Toast.Show("Etiqueta creada exitosamente", ToastVariant.Success, "user-check");
            }
            else
            {
                await Data.UpdateTagAsync(_editingId.Value, _form.Name);
                Toast.Show("Etiqueta actualizada exitosamente", ToastVariant.Success, "user-check");
            }

            await LoadDataAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private class TagFormModel
    {
        [Required(ErrorMessage = "El nombre de la etiqueta es obligatorio.")]
        public string Name { get; set; } = string.Empty;
    }
}
