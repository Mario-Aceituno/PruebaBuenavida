<nav class="chip-row" style="display:flex; gap: var(--space-2); margin-bottom: var(--space-5)">
    <NavLink href="/admin/seguridad/usuarios" Match="NavLinkMatch.Prefix" class="chip" ActiveClass="chip--active">
        <Icon Name="users" /> Usuarios
    </NavLink>
    <NavLink href="/admin/seguridad/roles" Match="NavLinkMatch.Prefix" class="chip" ActiveClass="chip--active">
        <Icon Name="shield" /> Roles y permisos
    </NavLink>
    <NavLink href="/admin/seguridad/auditoria" Match="NavLinkMatch.Prefix" class="chip" ActiveClass="chip--active">
        <Icon Name="history" /> Auditoría
