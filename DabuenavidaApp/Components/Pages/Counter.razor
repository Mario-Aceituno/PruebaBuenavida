protected override async Task OnInitializedAsync()
{
    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
    _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

    _users = await SecurityService.GetAllUsersAsync();
    _allRoles = await SecurityService.GetAllRolesAsync();

    // Secuencial: el DbContext es scoped y NO admite llamadas concurrentes.
    // Si el listado crece mucho, la solución correcta es un método batch en el
    // servicio, ej: GetUserRolesForUsersAsync(IEnumerable<Guid> userIds) con un
    // solo query (.Where(ur => ids.Contains(ur.UserId)).Include(...)) — dejo la
    // firma sugerida más abajo.
    _userRoles = new Dictionary<Guid, List<SecurityRole>>();
    foreach (var u in _users)
    {
        _userRoles[u.Id] = (await SecurityService.GetUserRolesAsync(u.Id)).ToList();
    }

    _loading = false;
}





// ISecurityService
Task<Dictionary<Guid, List<SecurityRole>>> GetUserRolesForUsersAsync(IEnumerable<Guid> userIds);

// Implementación (un solo query con Include)
public async Task<Dictionary<Guid, List<SecurityRole>>> GetUserRolesForUsersAsync(IEnumerable<Guid> userIds)
{
    var ids = userIds.ToList();
    var rows = await _db.SecurityUserRoles
        .Where(ur => ids.Contains(ur.UserId))
        .Include(ur => ur.Role)
        .ToListAsync();

    return ids.ToDictionary(id => id, id => rows.Where(r => r.UserId == id).Select(r => r.Role).ToList());
}







/* ===== Switch (toggle) ===== */
.switch {
  position: relative;
  display: inline-flex;
  width: 36px;
  height: 20px;
  cursor: pointer;
}

.switch input {
  position: absolute;
  opacity: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  cursor: pointer;
  z-index: 1;
}

.switch__track {
  position: absolute;
  inset: 0;
  background: var(--bg-surface-3);
  border-radius: var(--radius-full);
  transition: background var(--transition-fast);
}

.switch__track::before {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: 16px;
  height: 16px;
  background: white;
  border-radius: 50%;
  box-shadow: 0 1px 2px rgba(0,0,0,0.25);
  transition: transform var(--transition-fast);
}

.switch input:checked + .switch__track {
  background: var(--brand-500);
}

.switch input:checked + .switch__track::before {
  transform: translateX(16px);
}

.switch input:disabled + .switch__track {
  opacity: 0.5;
  cursor: not-allowed;
}

.switch input:focus-visible + .switch__track {
  outline: 2px solid var(--brand-500);
  outline-offset: 2px;
}






@page "/admin/seguridad/roles/{RoleId:guid}/permisos"
@attribute [Authorize(Policy = "ADMIN:READ")]
@rendermode InteractiveServer
@inject ISecurityService SecurityService
@inject AuthenticationStateProvider AuthStateProvider
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Web.Security
@using CorpWiki.Web.Components.Shared.Security

<PageTitle>DaviWiki - Permisos de rol</PageTitle>

<AdminNav />

@if (_loading)
{
    <div class="skeleton" style="height:60px; border-radius:var(--radius-lg); margin-bottom:var(--space-4)"></div>
    <div class="skeleton" style="height:400px; border-radius:var(--radius-lg)"></div>
}
else if (_role is null)
{
    <SecurityEmptyState IconName="shield" Title="Rol no encontrado" Description="El rol que buscás no existe o fue eliminado." />
}
else
{
    <SecurityPageHeader BackHref="/admin/seguridad/roles" BackText="Roles" Title="@($"Permisos: {_role.Name}")"
                        Subtitle="Elegí un nivel de acceso por pantalla. Usá 'Detalle' solo si necesitás algo distinto a los niveles estándar.">
        @if (_canWrite && _isDirty)
        {
            <button class="btn btn--ghost" @onclick="Discard">Descartar</button>
            <button class="btn btn--primary" @onclick="Save">
                <Icon Name="check-circle" /> Guardar cambios
            </button>
        }
    </SecurityPageHeader>

    @if (_isDirty)
    {
        <div class="callout callout--tip" role="status" aria-live="polite">
            <Icon Name="alert-triangle" />
            <p>Tenés cambios sin guardar (@_changedCount pantalla(s) modificada(s)).</p>
        </div>
    }

    <div class="matrix-toolbar">
        <div class="security-search">
            <Icon Name="search" />
            <input type="text" placeholder="Buscar pantalla..." aria-label="Buscar pantalla"
                   @bind="_screenSearch" @bind:event="oninput" />
        </div>

        @if (_canWrite)
        {
            <div class="matrix-bulk">
                <span>Aplicar a todas las visibles:</span>
                <div class="segmented" role="group" aria-label="Aplicar nivel a todas las pantallas visibles">
                    <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("none")'>Sin acceso</button>
                    <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("read")'>Lectura</button>
                    <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("write")'>Editor</button>
                    <button class="segmented__btn" @onclick='() => ApplyPresetToAllVisible("admin")'>Total</button>
                </div>
            </div>
        }

        <span class="security-toolbar__count">@FilteredScreens.Count de @_screens.Count pantallas</span>
    </div>

    @if (FilteredScreens.Count == 0)
    {
        <SecurityEmptyState IconName="search" Title="Sin resultados" Description="No hay pantallas que coincidan con la búsqueda." Inline="true" />
    }
    else
    {
        <div class="matrix-card-list">
            @foreach (var s in FilteredScreens)
            {
                var preset = GetPreset(s.Id);
                var expanded = _expandedScreens.Contains(s.Id);
                var changed = HasChanged(s.Id);

                <div class="matrix-card @(changed ? "matrix-card--changed" : "")">
                    <div class="matrix-card__header">
                        <div class="matrix-card__name">
                            @s.Name
                            @if (changed)
                            {
                                <span class="matrix-card__dot" title="Modificado"></span>
                            }
                        </div>

                        <div class="segmented" role="group" aria-label="@($"Nivel de acceso para {s.Name}")">
                            <button class="segmented__btn @(preset == "none" ? "segmented__btn--active" : "")"
                                    disabled="@(!_canWrite)" @onclick="() => ApplyPreset(s.Id, "none")">Sin acceso</button>
                            <button class="segmented__btn @(preset == "read" ? "segmented__btn--active" : "")"
                                    disabled="@(!_canWrite)" @onclick="() => ApplyPreset(s.Id, "read")">Lectura</button>
                            <button class="segmented__btn @(preset == "write" ? "segmented__btn--active" : "")"
                                    disabled="@(!_canWrite)" @onclick="() => ApplyPreset(s.Id, "write")">Editor</button>
                            <button class="segmented__btn @(preset == "admin" ? "segmented__btn--active" : "")"
                                    disabled="@(!_canWrite)" @onclick="() => ApplyPreset(s.Id, "admin")">Total</button>
                            @if (preset == "custom")
                            {
                                <span class="segmented__custom-tag">Personalizado</span>
                            }
                        </div>

                        <button type="button" class="matrix-card__expand" @onclick="() => ToggleExpanded(s.Id)"
                                aria-expanded="@expanded" aria-label="@(expanded ? $"Ocultar detalle de {s.Name}" : $"Ver detalle de {s.Name}")">
                            <Icon Name="@(expanded ? "chevron-up" : "chevron-down")" /> Detalle
                        </button>
                    </div>

                    @if (expanded)
                    {
                        <div class="matrix-card__detail">
                            @foreach (var p in _permissions)
                            {
                                var key = (s.Id, p.Id);
                                <label class="matrix-detail-row">
                                    <span>@p.Name</span>
                                    <label class="switch">
                                        <input type="checkbox"
                                               disabled="@(!_canWrite)"
                                               checked="@_matrix[key]"
                                               aria-label="@($"{p.Name} en {s.Name}")"
                                               @onchange="@(e => Toggle(key, (bool)e.Value!))" />
                                        <span class="switch__track"></span>
                                    </label>
                                </label>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_showToast)
    {
        <div class="toast" role="status" aria-live="polite"><Icon Name="check-circle" /> @_toastMessage</div>
    }
}

@code {
    [Parameter] public Guid RoleId { get; set; }

    private SecurityRole? _role;
    private List<SecurityScreen> _screens = new();
    private List<SecurityPermission> _permissions = new();
    private Dictionary<(Guid ScreenId, Guid PermissionId), bool> _matrix = new();
    private Dictionary<(Guid ScreenId, Guid PermissionId), bool> _original = new();
    private HashSet<Guid> _expandedScreens = new();
    private bool _loading = true;
    private bool _canWrite;
    private string _actingUser = "unknown";
    private string _screenSearch = "";
    private bool _showToast;
    private string _toastMessage = "";

    // Códigos esperados: READ, WRITE, DELETE, EXPORT, ADMIN
    private static readonly string[] PermissionOrder = { "READ", "WRITE", "DELETE", "EXPORT", "ADMIN" };

    private bool _isDirty => !_matrix.OrderBy(kv => kv.Key).SequenceEqual(_original.OrderBy(kv => kv.Key));
    private int _changedCount => _screens.Count(s => HasChanged(s.Id));

    private IReadOnlyList<SecurityScreen> FilteredScreens =>
        string.IsNullOrWhiteSpace(_screenSearch)
            ? _screens
            : _screens.Where(s => s.Name.Contains(_screenSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _role = await SecurityService.GetRoleByIdAsync(RoleId);
        _screens = (await SecurityService.GetAllScreensAsync()).OrderBy(s => s.DisplayOrder).ToList();
        _permissions = (await SecurityService.GetAllPermissionsAsync())
            .OrderBy(p => Array.IndexOf(PermissionOrder, p.Code))
            .ToList();

        var granted = await SecurityService.GetRolePermissionsAsync(RoleId);
        var grantedSet = granted.Select(rp => (rp.ScreenId, rp.PermissionId)).ToHashSet();

        foreach (var s in _screens)
        {
            foreach (var p in _permissions)
            {
                _matrix[(s.Id, p.Id)] = grantedSet.Contains((s.Id, p.Id));
            }
        }

        _original = new Dictionary<(Guid, Guid), bool>(_matrix);
        _loading = false;
    }

    private Guid? PermIdByCode(string code) => _permissions.FirstOrDefault(p => p.Code == code)?.Id;

    // Determina qué preset representa el estado actual de una pantalla.
    // "none": nada activo. "read": solo READ. "write": READ+WRITE.
    // "admin": todos los permisos conocidos activos. Cualquier otra combinación: "custom".
    private string GetPreset(Guid screenId)
    {
        bool Has(string code)
        {
            var id = PermIdByCode(code);
            return id.HasValue && _matrix.TryGetValue((screenId, id.Value), out var v) && v;
        }

        var read = Has("READ");
        var write = Has("WRITE");
        var del = Has("DELETE");
        var export = Has("EXPORT");
        var admin = Has("ADMIN");

        if (!read && !write && !del && !export && !admin) return "none";
        if (read && !write && !del && !export && !admin) return "read";
        if (read && write && !del && !export && !admin) return "write";
        if (read && write && del && export && admin) return "admin";
        return "custom";
    }

    private bool HasChanged(Guid screenId) =>
        _permissions.Any(p =>
        {
            var key = (screenId, p.Id);
            return _original.TryGetValue(key, out var was) && was != _matrix[key];
        });

    private void ApplyPreset(Guid screenId, string preset)
    {
        if (!_canWrite) return;

        bool read = preset is "read" or "write" or "admin";
        bool write = preset is "write" or "admin";
        bool full = preset is "admin";

        foreach (var p in _permissions)
        {
            var key = (screenId, p.Id);
            _matrix[key] = p.Code switch
            {
                "READ" => read,
                "WRITE" => write,
                "DELETE" => full,
                "EXPORT" => full,
                "ADMIN" => full,
                _ => _matrix[key] // permisos no estándar: no se tocan
            };
        }
    }

    private void ApplyPresetToAllVisible(string preset)
    {
        if (!_canWrite) return;
        foreach (var s in FilteredScreens) ApplyPreset(s.Id, preset);
    }

    private void Toggle((Guid ScreenId, Guid PermissionId) key, bool value)
    {
        if (!_canWrite) return;
        _matrix[key] = value;
    }

    private void ToggleExpanded(Guid screenId)
    {
        if (!_expandedScreens.Add(screenId))
            _expandedScreens.Remove(screenId);
    }

    private void Discard()
    {
        _matrix = new Dictionary<(Guid, Guid), bool>(_original);
    }

    private async Task Save()
    {
        if (!_canWrite) return;

        var changes = _matrix
            .Where(kv => !_original.TryGetValue(kv.Key, out var was) || was != kv.Value)
            .ToList();

        foreach (var kv in changes)
        {
            var (screenId, permissionId) = kv.Key;
            await SecurityService.SetRolePermissionAsync(RoleId, screenId, permissionId, kv.Value);
        }

        if (changes.Count > 0)
        {
            var affectedScreens = changes.Select(c => c.Key.ScreenId).Distinct().Count();
            await SecurityService.LogAuditAsync(null, _actingUser, "PERMISSION_CHANGED",
                $"Rol '{_role!.Name}': {affectedScreens} pantalla(s) modificada(s) ({changes.Count} permiso(s)).");
        }

        _original = new Dictionary<(Guid, Guid), bool>(_matrix);

        _toastMessage = $"{changes.Count} permiso(s) guardado(s).";
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }
}









