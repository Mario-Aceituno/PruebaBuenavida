<div class="journey-context">

    <div class="journey-context__block">

        <span class="journey-context__label">
            Recorrido del incidente
        </span>

        <div class="journey-context__route">
            @foreach (var area in _journey)
            {
                <span class="journey-context__area 
                    @(area.AreaName == _journeyStep.AreaName ? "journey-context__area--active" : "")">

                    @area.AreaName

                </span>

                @if (area != _journey.Last())
                {
                    <Icon Name="chevron-right" />
                }
            }
        </div>

    </div>


    <div class="journey-context__block journey-context__status">

        <span class="journey-context__label">
            Estado actual
        </span>

        <span class="journey-stage-badge">
            @GetJourneyStageLabel()
        </span>

    </div>

</div>




<div class="journey-conclusion">

    <div class="journey-conclusion__icon">
        <Icon Name="sparkles" />
    </div>

    <div>
        <p class="journey-conclusion__title">
            Conclusión de la etapa
        </p>

        <p class="journey-conclusion__text">
            @BuildStageConclusion()
        </p>
    </div>

</div>




<div class="journey-modal__controls">

    <button 
        class="btn btn--ghost btn--sm"
        @onclick="() => GoToJourneyStep(_journeyStepIndex - 1)"
        disabled="@(_journeyStepIndex == 0)">

        <Icon Name="chevron-left" />
        Anterior

    </button>


    <span class="journey-controls__position">
        @(_journeyStepIndex + 1) / @_journey.Count
    </span>


    <button 
        class="btn btn--ghost btn--sm"
        @onclick="() => GoToJourneyStep(_journeyStepIndex + 1)"
        disabled="@(_journeyStepIndex == _journey.Count - 1)">

        Siguiente
        <Icon Name="chevron-right" />

    </button>

</div>


.journey-context {

    display:flex;
    flex-direction:column;

    gap:var(--space-4);

    padding:var(--space-4) var(--space-6);

    border-bottom:1px solid var(--border-subtle);

}


.journey-context__block {

    display:flex;

    flex-direction:column;

    gap:var(--space-2);

}


.journey-context__label {

    font-size:var(--fs-xs);

    color:var(--text-tertiary);

    text-transform:uppercase;

    letter-spacing:.05em;

}


.journey-context__route {

    display:flex;

    align-items:center;

    flex-wrap:wrap;

    gap:var(--space-2);

    font-size:var(--fs-sm);

}


.journey-context__route .icon {

    width:14px;
    opacity:.5;

}


.journey-context__area {

    padding:4px 10px;

    border-radius:999px;

    background:var(--bg-surface-2);

    color:var(--text-secondary);

}


.journey-context__area--active {

    background:var(--brand-100);

    color:var(--brand-600);

    font-weight:600;

}


.journey-context__status {

    flex-direction:row;

    align-items:center;

    gap:var(--space-3);

}




.journey-conclusion {

    display:flex;

    gap:var(--space-3);

    margin-top:var(--space-5);

    padding-top:var(--space-4);

    border-top:1px solid var(--border-subtle);

}


.journey-conclusion__icon {

    color:var(--brand-500);

    margin-top:3px;

}


.journey-conclusion__title {

    font-size:var(--fs-sm);

    font-weight:700;

    margin:0;

}


.journey-conclusion__text {

    margin-top:4px;

    font-size:var(--fs-sm);

    color:var(--text-secondary);

    line-height:1.5;

}



.journey-modal__controls {

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:var(--space-3) var(--space-6);

    border-top:1px solid var(--border-subtle);

}


.journey-controls__position {

    font-size:var(--fs-xs);

    color:var(--text-tertiary);

}