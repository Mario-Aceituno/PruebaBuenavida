<div class="card admin-section">
    <h3 class="admin-section__title"><Icon Name="shield" /> Rol asignado</h3>
    <p class="role-chip-list__empty">Cada usuario tiene un único rol activo. Cambiarlo reemplaza el anterior.</p>

    <div class="role-chip-list">
        @if (_currentRole is not null)
        {
            <span class="chip chip--active">@_currentRole.Name</span>
        }
        else
        {
            <span class="role-chip-list__empty">Sin rol asignado.</span>
        }
    </div>

    @if (_canWrite)
    {
        <div class="role-assign-row">
            <select class="input" @bind="_selectedRoleId">
                <option value="">Sin rol</option>
                @foreach (var r in _allRoles)
                {
                    <option value="@r.Id">@r.Name</option>
                }
            </select>
            <button class="btn btn--primary btn--sm"
                    disabled="@(_selectedRoleId == (_currentRole?.Id ?? Guid.Empty))"
                    @onclick="ChangeRole">
                Guardar rol
            </button>
        </div>
    }
</div>







@code {
    [Parameter] public Guid UserId { get; set; }

    private SecurityUser? _user;
    private SecurityRole? _currentRole;
    private List<SecurityRole> _allRoles = new();
    private Guid _selectedRoleId = Guid.Empty;
    private bool _loading = true;
    private bool _canWrite;
    private string _actingUser = "unknown";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _user = await SecurityService.GetUserByIdAsync(UserId);
        _allRoles = await SecurityService.GetAllRolesAsync();

        var userRoles = await SecurityService.GetUserRolesAsync(UserId);
        _currentRole = userRoles.FirstOrDefault(); // se asume un único rol por usuario
        _selectedRoleId = _currentRole?.Id ?? Guid.Empty;

        _loading = false;
    }

    private async Task ChangeRole()
    {
        if (!_canWrite || _user is null) return;

        var oldRole = _currentRole;

        if (oldRole is not null)
        {
            await SecurityService.RemoveRoleFromUserAsync(UserId, oldRole.Id);
        }

        if (_selectedRoleId != Guid.Empty)
        {
            await SecurityService.AssignRoleToUserAsync(UserId, _selectedRoleId, _actingUser);
            var newRole = _allRoles.First(r => r.Id == _selectedRoleId);
            _currentRole = newRole;

            var detail = oldRole is null
                ? $"Rol asignado: {newRole.Name}"
                : $"Rol cambiado: {oldRole.Name} → {newRole.Name}";

            await SecurityService.LogAuditAsync(UserId, _user.Username, "ROLE_ASSIGNED", detail);
        }
        else
        {
            _currentRole = null;
            await SecurityService.LogAuditAsync(UserId, _user.Username, "ROLE_REMOVED",
                oldRole is null ? "Sin cambios." : $"Rol removido: {oldRole.Name}");
        }
    }
}





private static readonly string[] PermissionOrder = { "READ", "WRITE", "DELETE", "EXPORT", "ADMIN" };

// en OnInitializedAsync, reemplazar la línea de _permissions:
_permissions = (await SecurityService.GetAllPermissionsAsync())
    .OrderBy(p => Array.IndexOf(PermissionOrder, p.Code))
    .ToList();








<div class="card permission-matrix-wrap">
    <table class="permission-matrix">
        <colgroup>
            <col class="permission-matrix__screen-col" />
            @for (int i = 0; i < _permissions.Count; i++)
            {
                <col />
            }
        </colgroup>
        <thead>
            <tr>
                <th>Pantalla</th>
                @foreach (var p in _permissions)
                {
                    <th>@p.Name</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _screens)
            {
                <tr>
                    <td>@s.Name</td>
                    @foreach (var p in _permissions)
                    {
                        var key = (s.Id, p.Id);
                        <td>
                            <input type="checkbox"
                                   disabled="@(!_canWrite)"
                                   checked="@_matrix[key]"
                                   @onchange="@(e => Toggle(key, (bool)e.Value!))" />
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>






/* ===== Módulo de Seguridad / Administración ===== */

.role-chip-list {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
}

.role-chip-list__empty {
    color: var(--text-tertiary);
    font-size: var(--fs-sm);
}

.role-assign-row {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-3);
}

.role-assign-row .input {
    max-width: 260px;
}

.permission-matrix-wrap {
    overflow-x: auto;
}

.permission-matrix {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    min-width: 720px;
}

.permission-matrix__screen-col {
    width: 220px;
}

.permission-matrix thead th {
    position: sticky;
    top: 0;
    background: var(--bg-surface);
    z-index: 1;
    padding: var(--space-3) var(--space-2);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-align: center;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-default);
    white-space: nowrap;
}

.permission-matrix thead th:first-child {
    text-align: left;
}

.permission-matrix tbody td {
    padding: var(--space-2);
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
}

.permission-matrix tbody td:first-child {
    text-align: left;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-primary);
}

.permission-matrix tbody tr:hover {
    background: var(--bg-hover);
}

.permission-matrix input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--brand-500);
    cursor: pointer;
}

.permission-matrix input[type="checkbox"]:disabled {
    cursor: not-allowed;
    opacity: 0.5;
}





