@page "/admin/seguridad/usuarios/{UserId:guid}"
@attribute [Authorize(Policy = "ADMIN:READ")]

@inject ISecurityService SecurityService
@inject AuthenticationStateProvider AuthStateProvider
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Web.Security
@using CorpWiki.Web.Components.Shared.Security

<PageTitle>DaviWiki - Detalle de usuario</PageTitle>

<AdminNav />

@if (_loading)
{
    <div class="skeleton" style="height:80px; border-radius:var(--radius-lg)"></div>
}
else if (_user is null)
{
    <SecurityEmptyState IconName="user" Title="Usuario no encontrado"
                        Description="El usuario que buscás no existe o fue eliminado." />
}
else
{
    <SecurityPageHeader BackHref="/admin/seguridad/usuarios" BackText="Usuarios" Title="Detalle de usuario">
        @if (_canWrite)
        {
            <button class="btn @(_user.IsActive ? "btn--danger" : "btn--primary") btn--sm" @onclick="() => _confirmingToggle = true">
                @(_user.IsActive ? "Desactivar" : "Activar")
            </button>
        }
    </SecurityPageHeader>

    <div class="card" style="padding: var(--space-6)">
        <div class="entity-header">
            <span class="avatar entity-header__avatar" style="background: linear-gradient(135deg, @_user.AvatarColorFrom, @_user.AvatarColorTo)">
                @GetInitials(_user.FullName)
            </span>
            <div>
                <h2 style="margin-bottom:2px">@_user.FullName</h2>
                <div class="entity-header__meta">
                    <span>@_user.Username</span>
                    <span>•</span>
                    <span>@_user.Email</span>
                    <span>•</span>
                    <span>@_user.Department @(string.IsNullOrEmpty(_user.Position) ? "" : $" - {_user.Position}")</span>
                </div>
            </div>
            <div style="margin-left:auto">
                <SecurityStatusBadge Active="_user.IsActive" />
            </div>
        </div>

        <div class="security-tabs" role="tablist" aria-label="Secciones del usuario">
            <button role="tab"
                    id="tab-role" aria-controls="panel-role"
                    aria-selected="@(_tab == "role" ? "true" : "false")"
                    class="security-tab @(_tab == "role" ? "security-tab--active" : "")"
                    @onclick='() => _tab = "role"'>
                Roles y permisos
            </button>
            <button role="tab"
                    id="tab-info" aria-controls="panel-info"
                    aria-selected="@(_tab == "info" ? "true" : "false")"
                    class="security-tab @(_tab == "info" ? "security-tab--active" : "")"
                    @onclick='() => _tab = "info"'>
                Información
            </button>
        </div>

        @if (_tab == "role")
        {
            <div class="card admin-section" id="panel-role" role="tabpanel" aria-labelledby="tab-role">
                <h3 class="admin-section__title"><Icon Name="shield" /> Roles asignados</h3>
                <p class="admin-section__desc">Un usuario puede tener uno o más roles activos al mismo tiempo. Los permisos efectivos son la suma de todos sus roles.</p>

                <div class="role-chip-list">
                    @if (SelectedRoles.Count == 0)
                    {
                        <span class="role-chip-list__empty">Sin roles asignados.</span>
                    }
                    else
                    {
                        @foreach (var r in SelectedRoles)
                        {
                            <span class="chip chip--active">
                                @r.Name
                                @if (_canWrite)
                                {
                                    <button type="button" class="chip__remove" aria-label="@($"Quitar rol {r.Name}")" @onclick="() => RemoveRole(r.Id)">
                                        <Icon Name="x" />
                                    </button>
                                }
                            </span>
                        }
                    }
                </div>

                @if (_canWrite)
                {
                    <div class="role-assign-row">
                        <select class="input" @bind="_roleToAdd" aria-label="Agregar rol">
                            <option value="">Agregar rol...</option>
                            @foreach (var r in AvailableRolesToAdd)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                        <button class="btn btn--secondary btn--sm" disabled="@string.IsNullOrEmpty(_roleToAdd)" @onclick="AddRole">
                            <Icon Name="plus" /> Agregar
                        </button>
                    </div>

                    @if (_isDirty)
                    {
                        <div class="role-assign-actions">
                            <span class="role-assign-actions__hint"><Icon Name="alert-triangle" /> Tenés cambios sin guardar</span>
                            <button class="btn btn--ghost btn--sm" @onclick="DiscardRoleChanges">Descartar</button>
                            <button class="btn btn--primary btn--sm" @onclick="RequestRoleChange">Guardar cambios</button>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="card admin-section" id="panel-info" role="tabpanel" aria-labelledby="tab-info">
                <h3 class="admin-section__title"><Icon Name="user" /> Información</h3>
                <div class="drawer__row">
                    <span class="drawer__row-label">Nombre completo</span>
                    <span class="drawer__row-value">@_user.FullName</span>
                </div>
                <div class="drawer__row">
                    <span class="drawer__row-label">Usuario</span>
                    <span class="drawer__row-value">@_user.Username</span>
                </div>
                <div class="drawer__row">
                    <span class="drawer__row-label">Correo</span>
                    <span class="drawer__row-value">@_user.Email</span>
                </div>
                <div class="drawer__row">
                    <span class="drawer__row-label">Departamento / Cargo</span>
                    <span class="drawer__row-value">@_user.Department @(string.IsNullOrEmpty(_user.Position) ? "" : $" - {_user.Position}")</span>
                </div>
            </div>
        }
    </div>

    <SecurityConfirmDialog Visible="_confirmingToggle"
                           Title="@(_user?.IsActive == true ? "Desactivar usuario" : "Activar usuario")"
                           Message="@($"...{_user?.FullName} {(_user?.IsActive == true ? "perderá acceso al sistema" : "recuperará acceso al sistema")}. ¿Continuar?")"
                           ConfirmText="@(_user?.IsActive == true ? "Desactivar" : "Activar")"
                           Dangerous="@(_user?.IsActive == true)"
                           OnConfirm="ToggleActive"
                           OnCancel="() => _confirmingToggle = false" />

    <SecurityConfirmDialog Visible="_confirmingRoleChange"
                           Title="Cambiar roles"
                           Message="@RoleChangeMessage"
                           ConfirmText="Confirmar cambios"
                           OnConfirm="ChangeRole"
                           OnCancel="() => _confirmingRoleChange = false" />

    @if (_showToast)
    {
        <div class="toast" role="status" aria-live="polite"><Icon Name="check-circle" /> @_toastMessage</div>
    }
}

@code {
    [Parameter] public Guid UserId { get; set; }

    private SecurityUser? _user;
    private List<SecurityRole> _allRoles = new();
    private HashSet<Guid> _savedRoleIds = new();
    private HashSet<Guid> _selectedRoleIds = new();
    private string _roleToAdd = "";
    private bool _loading = true;
    private bool _canWrite;
    private string _actingUser = "unknown";
    private string _tab = "role";
    private bool _confirmingToggle;
    private bool _confirmingRoleChange;
    private bool _showToast;
    private string _toastMessage = "";

    private bool _isDirty => !_selectedRoleIds.SetEquals(_savedRoleIds);

    private List<SecurityRole> SelectedRoles =>
        _allRoles.Where(r => _selectedRoleIds.Contains(r.Id)).OrderBy(r => r.Name).ToList();

    private List<SecurityRole> AvailableRolesToAdd =>
        _allRoles.Where(r => !_selectedRoleIds.Contains(r.Id)).OrderBy(r => r.Name).ToList();

    private string RoleChangeMessage
    {
        get
        {
            var added = _allRoles.Where(r => _selectedRoleIds.Contains(r.Id) && !_savedRoleIds.Contains(r.Id)).Select(r => r.Name).ToList();
            var removed = _allRoles.Where(r => _savedRoleIds.Contains(r.Id) && !_selectedRoleIds.Contains(r.Id)).Select(r => r.Name).ToList();

            var parts = new List<string>();
            if (added.Count > 0) parts.Add($"Se agregará: {string.Join(", ", added)}");
            if (removed.Count > 0) parts.Add($"Se quitará: {string.Join(", ", removed)}");
            if (parts.Count == 0) parts.Add("No hay cambios pendientes");

            return $"{string.Join(". ", parts)} para {_user?.FullName}.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _user = await SecurityService.GetUserByIdAsync(UserId);
        _allRoles = await SecurityService.GetAllRolesAsync();

        var userRoles = await SecurityService.GetUserRolesAsync(UserId);
        _savedRoleIds = userRoles.Select(r => r.Id).ToHashSet();
        _selectedRoleIds = new HashSet<Guid>(_savedRoleIds);

        _loading = false;
    }

    private void AddRole()
    {
        if (!_canWrite || string.IsNullOrEmpty(_roleToAdd)) return;
        if (Guid.TryParse(_roleToAdd, out var id)) _selectedRoleIds.Add(id);
        _roleToAdd = "";
    }

    private void RemoveRole(Guid roleId)
    {
        if (!_canWrite) return;
        _selectedRoleIds.Remove(roleId);
    }

    private void DiscardRoleChanges() => _selectedRoleIds = new HashSet<Guid>(_savedRoleIds);

    private void RequestRoleChange()
    {
        if (!_canWrite || !_isDirty) return;
        _confirmingRoleChange = true;
    }

    private async Task ChangeRole()
    {
        _confirmingRoleChange = false;
        if (!_canWrite || _user is null) return;

        var toAdd = _selectedRoleIds.Except(_savedRoleIds).ToList();
        var toRemove = _savedRoleIds.Except(_selectedRoleIds).ToList();

        foreach (var roleId in toRemove)
            await SecurityService.RemoveRoleFromUserAsync(UserId, roleId);

        foreach (var roleId in toAdd)
            await SecurityService.AssignRoleToUserAsync(UserId, roleId, _actingUser);

        var addedNames = _allRoles.Where(r => toAdd.Contains(r.Id)).Select(r => r.Name).ToList();
        var removedNames = _allRoles.Where(r => toRemove.Contains(r.Id)).Select(r => r.Name).ToList();

        var detailParts = new List<string>();
        if (addedNames.Count > 0) detailParts.Add($"Agregados: {string.Join(", ", addedNames)}");
        if (removedNames.Count > 0) detailParts.Add($"Removidos: {string.Join(", ", removedNames)}");

        await SecurityService.LogAuditAsync(UserId, _user.Username, "ROLES_CHANGED", string.Join(" | ", detailParts));

        _savedRoleIds = new HashSet<Guid>(_selectedRoleIds);
        _toastMessage = "Roles actualizados correctamente.";
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }

    private async Task ToggleActive()
    {
        _confirmingToggle = false;

        if (_user is null || !_canWrite)
            return;

        try
        {
            var success = await SecurityService.ToggleUserActiveAsync(_user.Id);
            if (!success)
            {
                _toastMessage = "No se pudo actualizar el estado del usuario.";
                _showToast = true;
                return;
            }

            var updatedUser = await SecurityService.GetUserByIdAsync(_user.Id);
            if (updatedUser is not null)
            {
                _user.IsActive = updatedUser.IsActive;
            }

            await SecurityService.LogAuditAsync(
                _user.Id,
                _actingUser,
                _user.IsActive ? "USER_ACTIVATED" : "USER_DEACTIVATED",
                $"Usuario afectado: {_user.Username}");

            _toastMessage = _user.IsActive
                ? "Usuario activado correctamente."
                : "Usuario desactivado correctamente.";

            _showToast = true;
        }
        catch (Exception)
        {
            _toastMessage = "Ocurrió un error al actualizar el usuario.";
            _showToast = true;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..1].ToUpper() : $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}








@page "/admin/seguridad/usuarios"
@attribute [Authorize(Policy = "ADMIN:READ")]

@inject ISecurityService SecurityService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Web.Security
@using CorpWiki.Web.Components.Shared.Security
<PageTitle>DaviWiki - Usuarios</PageTitle>

<AdminNav />

<SecurityPageHeader Title="Usuarios" Subtitle="Provisionados automáticamente desde el Active Directory en el primer login." />

@if (_loading)
{
    <div class="card" style="padding: var(--space-4)">
        @for (int i = 0; i < 5; i++)
        {
            <div class="skeleton" style="height:48px; margin-bottom:8px; border-radius:var(--radius-md)"></div>
        }
    </div>
}
else if (_users.Count == 0)
{
    <SecurityEmptyState IconName="users" Title="Todavía no hay usuarios"
                        Description="Los usuarios se crean automáticamente cuando alguien inicia sesión por primera vez con su cuenta corporativa." />
}
else
{
    <div class="security-toolbar">
        <div class="security-search">
            <Icon Name="search" />
            <input type="text" placeholder="Buscar por nombre, usuario o correo..."
                   aria-label="Buscar usuarios"
                   @bind="_searchTerm" @bind:event="oninput" />
        </div>
        <div class="security-filter-group" role="group" aria-label="Filtrar por estado">
            <button class="security-filter-btn @(_statusFilter == "all" ? "security-filter-btn--active" : "")" @onclick='() => _statusFilter = "all"'>Todos</button>
            <button class="security-filter-btn @(_statusFilter == "active" ? "security-filter-btn--active" : "")" @onclick='() => _statusFilter = "active"'>Activos</button>
            <button class="security-filter-btn @(_statusFilter == "inactive" ? "security-filter-btn--active" : "")" @onclick='() => _statusFilter = "inactive"'>Inactivos</button>
        </div>
        <select class="input" style="max-width:200px" @bind="_roleFilter" aria-label="Filtrar por rol">
            <option value="">Todos los roles</option>
            @foreach (var r in _allRoles)
            {
                <option value="@r.Id">@r.Name</option>
            }
        </select>
        <span class="security-toolbar__count">@FilteredUsers.Count de @_users.Count</span>
    </div>

    @if (_selectedIds.Count > 0 && _canWrite)
    {
        <div class="bulk-action-bar" role="status" aria-live="polite">
            <span><strong>@_selectedIds.Count</strong> usuario(s) seleccionado(s)</span>
            <div class="bulk-action-bar__actions">
                <button class="btn btn--secondary btn--sm" @onclick="() => RequestBulkToggle(true)">Activar</button>
                <button class="btn btn--danger btn--sm" @onclick="() => RequestBulkToggle(false)">Desactivar</button>
                <button class="btn btn--ghost btn--sm" @onclick="ClearSelection">Cancelar</button>
            </div>
        </div>
    }

    @if (FilteredUsers.Count == 0)
    {
        <SecurityEmptyState IconName="search" Title="Sin resultados"
                            Description="No encontramos usuarios que coincidan con la búsqueda o el filtro aplicado." />
    }
    else
    {
        <div class="card data-table-wrap">
            <table class="data-table data-table--clickable">
                <thead>
                    <tr>
                        @if (_canWrite)
                        {
                            <th style="width:36px">
                                <input type="checkbox" aria-label="Seleccionar todos los usuarios visibles"
                                       checked="@AllVisibleSelected"
                                       @onchange="@(e => ToggleSelectAll((bool)e.Value!))" />
                            </th>
                        }
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Departamento</th>
                        <th>Roles</th>
                        <th>Estado</th>
                        <th class="data-table__actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in FilteredUsers)
                    {
                        <tr @onclick="() => GoToDetail(u.Id)">
                            @if (_canWrite)
                            {
                                <td @onclick:stopPropagation="true">
                                    <input type="checkbox" aria-label="@($"Seleccionar {u.FullName}")"
                                           checked="@_selectedIds.Contains(u.Id)"
                                           @onchange="@(e => ToggleSelect(u.Id, (bool)e.Value!))" />
                                </td>
                            }
                            <td>
                                <div class="data-table__user-cell">
                                    <span class="avatar avatar--sm" style="background: linear-gradient(135deg, @u.AvatarColorFrom, @u.AvatarColorTo)">
                                        @GetInitials(u.FullName)
                                    </span>
                                    <div class="data-table__user-info">
                                        <span class="data-table__user-name">@u.FullName</span>
                                        <span class="data-table__user-sub">@u.Username</span>
                                    </div>
                                </div>
                            </td>
                            <td>@u.Email</td>
                            <td>@u.Department</td>
                            <td>
                                <div class="role-chip-list role-chip-list--compact">
                                    @if (_userRoles.TryGetValue(u.Id, out var roles) && roles.Count > 0)
                                    {
                                        @foreach (var r in roles.Take(2))
                                        {
                                            <span class="chip chip--sm">@r.Name</span>
                                        }
                                        @if (roles.Count > 2)
                                        {
                                            <span class="chip chip--sm chip--muted">+@(roles.Count - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="role-chip-list__empty">Sin rol</span>
                                    }
                                </div>
                            </td>
                            <td><SecurityStatusBadge Active="u.IsActive" /></td>
                            <td class="data-table__actions" @onclick:stopPropagation="true">
                                <div class="row-actions">
                                    <button class="btn btn--secondary btn--sm" @onclick="() => GoToDetail(u.Id)">
                                        Ver detalle
                                    </button>
                                    @if (_canWrite)
                                    {
                                        <button class="btn @(u.IsActive ? "btn--danger" : "btn--primary") btn--sm"
                                                @onclick="() => RequestToggle(u)">
                                            @(u.IsActive ? "Desactivar" : "Activar")
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <SecurityConfirmDialog Visible="_confirmingUser is not null"
                           Title="@(_confirmingUser?.IsActive == true ? "Desactivar usuario" : "Activar usuario")"
                           Message="@ConfirmMessage"
                           ConfirmText="@(_confirmingUser?.IsActive == true ? "Desactivar" : "Activar")"
                           Dangerous="@(_confirmingUser?.IsActive == true)"
                           OnConfirm="ConfirmToggle"
                           OnCancel="() => _confirmingUser = null" />

    <SecurityConfirmDialog Visible="_confirmingBulk"
                           Title="@(_bulkActivate ? "Activar usuarios" : "Desactivar usuarios")"
                           Message="@BulkConfirmMessage"
                           ConfirmText="@(_bulkActivate ? "Activar" : "Desactivar")"
                           Dangerous="@(!_bulkActivate)"
                           OnConfirm="ConfirmBulkToggle"
                           OnCancel="() => _confirmingBulk = false" />

    @if (_showToast)
    {
        <div class="toast" role="status" aria-live="polite"><Icon Name="check-circle" /> @_toastMessage</div>
    }
}

@code {
    private List<SecurityUser> _users = new();
    private List<SecurityRole> _allRoles = new();
    private Dictionary<Guid, List<SecurityRole>> _userRoles = new();
    private bool _loading = true;
    private bool _canWrite;
    private string _actingUser = "unknown";
    private string _searchTerm = "";
    private string _statusFilter = "all";
    private string _roleFilter = "";
    private SecurityUser? _confirmingUser;
    private HashSet<Guid> _selectedIds = new();
    private bool _confirmingBulk;
    private bool _bulkActivate;
    private bool _showToast;
    private string _toastMessage = "";

    private IReadOnlyList<SecurityUser> FilteredUsers =>
        _users.Where(u =>
            (_statusFilter == "all" || (_statusFilter == "active" == u.IsActive)) &&
            (string.IsNullOrEmpty(_roleFilter) ||
             (Guid.TryParse(_roleFilter, out var rid) && _userRoles.TryGetValue(u.Id, out var roles) && roles.Any(r => r.Id == rid))) &&
            (string.IsNullOrWhiteSpace(_searchTerm) ||
             u.FullName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             u.Username.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (u.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)))
        .OrderBy(u => u.FullName)
        .ToList();

    private bool AllVisibleSelected =>
        FilteredUsers.Count > 0 && FilteredUsers.All(u => _selectedIds.Contains(u.Id));

    private string ConfirmMessage => _confirmingUser?.IsActive == true
        ? $"'{_confirmingUser.FullName}' no podrá iniciar sesión hasta que vuelva a activarse. ¿Continuar?"
        : $"'{_confirmingUser?.FullName}' recuperará acceso al sistema. ¿Continuar?";

    private string BulkConfirmMessage => _bulkActivate
        ? $"Se activarán {_selectedIds.Count} usuario(s). ¿Continuar?"
        : $"Se desactivarán {_selectedIds.Count} usuario(s), quienes perderán acceso al sistema. ¿Continuar?";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _users = await SecurityService.GetAllUsersAsync();
        _allRoles = await SecurityService.GetAllRolesAsync();

        // NOTA: si el volumen de usuarios crece, reemplazar por un endpoint batch
        // (ej. GetUserRolesForUsersAsync(IEnumerable<Guid>)) para evitar N llamadas.
        var roleLookups = await Task.WhenAll(_users.Select(async u => (u.Id, Roles: await SecurityService.GetUserRolesAsync(u.Id))));
        _userRoles = roleLookups.ToDictionary(x => x.Id, x => x.Roles.ToList());

        _loading = false;
    }

    private void GoToDetail(Guid id) => Navigation.NavigateTo($"/admin/seguridad/usuarios/{id}");

    private void ToggleSelect(Guid id, bool value)
    {
        if (value) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
    }

    private void ToggleSelectAll(bool value)
    {
        if (value)
        {
            foreach (var u in FilteredUsers) _selectedIds.Add(u.Id);
        }
        else
        {
            foreach (var u in FilteredUsers) _selectedIds.Remove(u.Id);
        }
    }

    private void ClearSelection() => _selectedIds.Clear();

    private void RequestToggle(SecurityUser u)
    {
        if (!_canWrite) return;
        _confirmingUser = u;
    }

    private void RequestBulkToggle(bool activate)
    {
        if (!_canWrite || _selectedIds.Count == 0) return;
        _bulkActivate = activate;
        _confirmingBulk = true;
    }

    private async Task ConfirmBulkToggle()
    {
        _confirmingBulk = false;
        if (!_canWrite) return;

        var targets = _users.Where(u => _selectedIds.Contains(u.Id) && u.IsActive != _bulkActivate).ToList();
        int successCount = 0;

        foreach (var u in targets)
        {
            var success = await SecurityService.ToggleUserActiveAsync(u.Id);
            if (!success) continue;

            u.IsActive = _bulkActivate;
            successCount++;

            await SecurityService.LogAuditAsync(
                u.Id, _actingUser,
                u.IsActive ? "USER_ACTIVATED" : "USER_DEACTIVATED",
                $"Usuario afectado (acción masiva): {u.Username}");
        }

        _toastMessage = _bulkActivate
            ? $"{successCount} usuario(s) activado(s)."
            : $"{successCount} usuario(s) desactivado(s).";

        _selectedIds.Clear();
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }

    private async Task ConfirmToggle()
    {
        var user = _confirmingUser;
        if (user is null || !_canWrite)
            return;

        _confirmingUser = null;
        var previousState = user.IsActive;

        try
        {
            var success = await SecurityService.ToggleUserActiveAsync(user.Id);
            if (!success)
            {
                _toastMessage = "No se pudo actualizar el estado del usuario.";
                _showToast = true;
                return;
            }

            var updatedUser = await SecurityService.GetUserByIdAsync(user.Id);
            if (updatedUser is not null)
            {
                user.IsActive = updatedUser.IsActive;
            }
            else
            {
                user.IsActive = !previousState;
            }

            await SecurityService.LogAuditAsync(
                user.Id, _actingUser,
                user.IsActive ? "USER_ACTIVATED" : "USER_DEACTIVATED",
                $"Usuario afectado: {user.Username}");

            _toastMessage = user.IsActive
                ? "Usuario activado correctamente."
                : "Usuario desactivado correctamente.";

            _showToast = true;
        }
        catch (Exception)
        {
            _toastMessage = "Ocurrió un error al actualizar el usuario.";
            _showToast = true;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..1].ToUpper() : $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}









@page "/admin/seguridad/roles/{RoleId:guid}/permisos"
@attribute [Authorize(Policy = "ADMIN:READ")]
@rendermode InteractiveServer
@inject ISecurityService SecurityService
@inject AuthenticationStateProvider AuthStateProvider
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Web.Security
@using CorpWiki.Web.Components.Shared.Security

<PageTitle>DaviWiki - Permisos de rol</PageTitle>

<AdminNav />

@if (_loading)
{
    <div class="skeleton" style="height:60px; border-radius:var(--radius-lg); margin-bottom:var(--space-4)"></div>
    <div class="skeleton" style="height:320px; border-radius:var(--radius-lg)"></div>
}
else if (_role is null)
{
    <SecurityEmptyState IconName="shield" Title="Rol no encontrado" Description="El rol que buscás no existe o fue eliminado." />
}
else
{
    <SecurityPageHeader BackHref="/admin/seguridad/roles" BackText="Roles" Title="@($"Permisos: {_role.Name}")"
                        Subtitle="Marcá qué puede hacer este rol en cada pantalla del sistema.">
        @if (_canWrite && _isDirty)
        {
            <button class="btn btn--ghost" @onclick="Discard">Descartar</button>
            <button class="btn btn--primary" @onclick="Save">
                <Icon Name="check-circle" /> Guardar cambios
            </button>
        }
    </SecurityPageHeader>

    @if (_isDirty)
    {
        <div class="callout callout--tip" role="status" aria-live="polite">
            <Icon Name="alert-triangle" />
            <p>Tenés cambios sin guardar (@_changedCount permiso(s) modificado(s)).</p>
        </div>
    }

    <div class="matrix-toolbar">
        <div class="security-search">
            <Icon Name="search" />
            <input type="text" placeholder="Buscar pantalla..." aria-label="Buscar pantalla"
                   @bind="_screenSearch" @bind:event="oninput" />
        </div>
        <span class="security-toolbar__count">@FilteredScreens.Count de @_screens.Count pantallas</span>
    </div>

    @if (FilteredScreens.Count == 0)
    {
        <SecurityEmptyState IconName="search" Title="Sin resultados" Description="No hay pantallas que coincidan con la búsqueda." Inline="true" />
    }
    else
    {
        <div class="card permission-matrix-wrap">
            <table class="permission-matrix">
                <colgroup>
                    <col class="permission-matrix__screen-col" />
                    @for (int i = 0; i < _permissions.Count; i++)
                    {
                        <col />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th>Pantalla</th>
                        @foreach (var p in _permissions)
                        {
                            <th>
                                <div class="matrix-col-header">
                                    <span>@p.Name</span>
                                    @if (_canWrite)
                                    {
                                        <button type="button" class="matrix-col-toggle"
                                                title="@(AllChecked(p) ? $"Quitar {p.Name} de todas las pantallas visibles" : $"Otorgar {p.Name} a todas las pantallas visibles")"
                                                aria-label="@(AllChecked(p) ? $"Quitar {p.Name} de todas las pantallas visibles" : $"Otorgar {p.Name} a todas las pantallas visibles")"
                                                @onclick="() => ToggleColumn(p, !AllChecked(p))">
                                            <Icon Name="@(AllChecked(p) ? "check-square" : "square")" />
                                        </button>
                                    }
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in FilteredScreens)
                    {
                        <tr>
                            <td>@s.Name</td>
                            @foreach (var p in _permissions)
                            {
                                var key = (s.Id, p.Id);
                                var changed = _original.TryGetValue(key, out var was) && was != _matrix[key];
                                <td class="@(changed ? "matrix-changed" : "")">
                                    <label class="switch">
                                        <input type="checkbox"
                                               disabled="@(!_canWrite)"
                                               checked="@_matrix[key]"
                                               aria-label="@($"{p.Name} en {s.Name}")"
                                               @onchange="@(e => Toggle(key, (bool)e.Value!))" />
                                        <span class="switch__track"></span>
                                    </label>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_showToast)
    {
        <div class="toast" role="status" aria-live="polite"><Icon Name="check-circle" /> @_toastMessage</div>
    }
}

@code {
    [Parameter] public Guid RoleId { get; set; }

    private SecurityRole? _role;
    private List<SecurityScreen> _screens = new();
    private List<SecurityPermission> _permissions = new();
    private Dictionary<(Guid ScreenId, Guid PermissionId), bool> _matrix = new();
    private Dictionary<(Guid ScreenId, Guid PermissionId), bool> _original = new();
    private bool _loading = true;
    private bool _canWrite;
    private string _actingUser = "unknown";
    private string _screenSearch = "";
    private bool _showToast;
    private string _toastMessage = "";
    private static readonly string[] PermissionOrder = { "READ", "WRITE", "DELETE", "EXPORT", "ADMIN" };

    private bool _isDirty => !_matrix.OrderBy(kv => kv.Key).SequenceEqual(_original.OrderBy(kv => kv.Key));
    private int _changedCount => _matrix.Count(kv => !_original.TryGetValue(kv.Key, out var was) || was != kv.Value);

    private IReadOnlyList<SecurityScreen> FilteredScreens =>
        string.IsNullOrWhiteSpace(_screenSearch)
            ? _screens
            : _screens.Where(s => s.Name.Contains(_screenSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasPermission("ADMIN", "WRITE");
        _actingUser = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown";

        _role = await SecurityService.GetRoleByIdAsync(RoleId);
        _screens = (await SecurityService.GetAllScreensAsync()).OrderBy(s => s.DisplayOrder).ToList();
        _permissions = (await SecurityService.GetAllPermissionsAsync())
            .OrderBy(p => Array.IndexOf(PermissionOrder, p.Code))
            .ToList();

        var granted = await SecurityService.GetRolePermissionsAsync(RoleId);
        var grantedSet = granted.Select(rp => (rp.ScreenId, rp.PermissionId)).ToHashSet();

        foreach (var s in _screens)
        {
            foreach (var p in _permissions)
            {
                _matrix[(s.Id, p.Id)] = grantedSet.Contains((s.Id, p.Id));
            }
        }

        _original = new Dictionary<(Guid, Guid), bool>(_matrix);
        _loading = false;
    }

    private void Toggle((Guid ScreenId, Guid PermissionId) key, bool value)
    {
        if (!_canWrite) return;
        _matrix[key] = value;
    }

    private void ToggleColumn(SecurityPermission p, bool value)
    {
        if (!_canWrite) return;
        foreach (var s in FilteredScreens)
        {
            _matrix[(s.Id, p.Id)] = value;
        }
    }

    private bool AllChecked(SecurityPermission p) =>
        FilteredScreens.Count > 0 && FilteredScreens.All(s => _matrix[(s.Id, p.Id)]);

    private void Discard() => _matrix = new Dictionary<(Guid, Guid), bool>(_original);

    private async Task Save()
    {
        if (!_canWrite) return;

        var changes = _matrix
            .Where(kv => !_original.TryGetValue(kv.Key, out var was) || was != kv.Value)
            .ToList();

        foreach (var kv in changes)
        {
            var (screenId, permissionId) = kv.Key;
            await SecurityService.SetRolePermissionAsync(RoleId, screenId, permissionId, kv.Value);
        }

        if (changes.Count > 0)
        {
            await SecurityService.LogAuditAsync(null, _actingUser, "PERMISSION_CHANGED",
                $"Rol '{_role!.Name}': {changes.Count} permiso(s) modificado(s).");
        }

        _original = new Dictionary<(Guid, Guid), bool>(_matrix);

        _toastMessage = $"{changes.Count} permiso(s) guardado(s).";
        _showToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        _showToast = false;
        StateHasChanged();
    }
}









@page "/admin/seguridad/roles"
@attribute [Authorize(Policy = "ADMIN:READ")]
@rendermode InteractiveServer
