@using CorpWiki.Domain.Entities.Security

<span class="badge badge--brand role-badge">
    <Icon Name="shield" />
    @Role.Name
    @if (Removable)
    {
        <button type="button" class="role-badge__remove" @onclick="HandleRemove" @onclick:stopPropagation title="Quitar rol">
            <Icon Name="x" />
        </button>
    }
</span>

@code {
    [Parameter, EditorRequired] public SecurityRole Role { get; set; } = default!;
    [Parameter] public bool Removable { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private async Task HandleRemove()
    {
        if (OnRemove.HasDelegate)
        {
            await OnRemove.InvokeAsync();
        }
    }
}







<span class="badge @(IsActive ? "badge--success" : "badge--muted")">
    <span class="status-dot @(IsActive ? "status-dot--active" : "status-dot--inactive")"></span>
    @(IsActive ? "Activo" : "Inactivo")
</span>

@code {
    [Parameter] public bool IsActive { get; set; }
}






@page "/admin/seguridad/usuarios"
@namespace CorpWiki.Web.Components.Pages
@attribute [Authorize(Policy = "ADMIN:READ")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Application.Interfaces
@using CorpWiki.Web.Security
@using CorpWiki.Web.Components.Shared.Security

@inject ISecurityService SecurityService
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Navigation

<PageTitle>DaviWiki - Usuarios</PageTitle>

<div class="page-header">
    <div>
        <h1>Gestión de Usuarios</h1>
        <p>@_filteredUsers.Count() usuarios registrados</p>
    </div>
    @if (_canWrite)
    {
        <button class="btn btn--primary" @onclick="() => _showCreateModal = true">
            <Icon Name="plus" /> Nuevo Usuario
        </button>
    }
</div>

<AdminNav />

<div class="admin-toolbar">
    <div class="admin-search">
        <Icon Name="search" />
        <input class="input" placeholder="Buscar por nombre, usuario o email..." @bind="_searchTerm" @bind:event="oninput" />
    </div>

    <div class="pill-group">
        <button class="pill @(_statusFilter == "all" ? "pill--active" : "")" @onclick='() => _statusFilter = "all"'>Todos</button>
        <button class="pill @(_statusFilter == "active" ? "pill--active" : "")" @onclick='() => _statusFilter = "active"'>Activos</button>
        <button class="pill @(_statusFilter == "inactive" ? "pill--active" : "")" @onclick='() => _statusFilter = "inactive"'>Inactivos</button>
    </div>
</div>

@if (_loading)
{
    <p>Cargando usuarios...</p>
}
else
{
    <div class="card admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Roles</th>
                    <th>Estado</th>
                    <th class="admin-table__actions-col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _filteredUsers)
                {
                    <tr>
                        <td>
                            <div class="admin-table__user">
                                <span class="avatar avatar--sm" style="background: linear-gradient(135deg, @u.AvatarColorFrom, @u.AvatarColorTo)">
                                    @GetInitials(u.FullName)
                                </span>
                                <div>
                                    <p class="admin-table__user-name">@u.FullName</p>
                                    <p class="admin-table__user-meta">@u.Email · @u.Department</p>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="role-chip-list role-chip-list--compact">
                                @foreach (var r in GetRolesFor(u.Id))
                                {
                                    <RoleBadge Role="r" />
                                }
                                @if (!GetRolesFor(u.Id).Any())
                                {
                                    <span class="role-chip-list__empty">Sin rol</span>
                                }
                            </div>
                        </td>
                        <td><StatusBadge IsActive="u.IsActive" /></td>
                        <td>
                            <div class="admin-table__actions">
                                <button class="icon-btn icon-btn--ghost" title="Ver detalle / asignar rol" @onclick="() => GoToDetail(u.Id)">
                                    <Icon Name="user-cog" />
                                </button>
                                @if (_canWrite)
                                {
                                    <button class="icon-btn icon-btn--ghost" title="@(u.IsActive ? "Desactivar" : "Activar")" @onclick="() => ToggleActive(u)">
                                        <Icon Name="@(u.IsActive ? "user-x" : "user-check")" />
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showCreateModal)
{
    <CreateUserRoleAssignHint />
}








using CorpWiki.Application.Interfaces;
using CorpWiki.Domain.Entities.Security;
using CorpWiki.Web.Security;
using Microsoft.AspNetCore.Components;

namespace CorpWiki.Web.Components.Pages;

public partial class UserManagement
{
    [Inject] private ISecurityService SecurityService { get; set; } = default!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private List<SecurityUser> _users = new();
    private Dictionary<Guid, List<SecurityRole>> _rolesByUser = new();
    private bool _loading = true;
    private bool _canWrite;
    private bool _showCreateModal;
    private string _searchTerm = "";
    private string _statusFilter = "all";

    private IEnumerable<SecurityUser> _filteredUsers => _users
        .Where(u => _statusFilter == "all" || (_statusFilter == "active" && u.IsActive) || (_statusFilter == "inactive" && !u.IsActive))
        .Where(u => string.IsNullOrWhiteSpace(_searchTerm) ||
            u.FullName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
            u.Username.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        _canWrite = CurrentUser.HasPermission("ADMIN", "WRITE");

        _users = await SecurityService.GetAllUsersAsync();

        foreach (var u in _users)
            _rolesByUser[u.Id] = await SecurityService.GetUserRolesAsync(u.Id);

        _loading = false;
    }

    private List<SecurityRole> GetRolesFor(Guid userId) =>
        _rolesByUser.TryGetValue(userId, out var roles) ? roles : new();

    private void GoToDetail(Guid id) => Navigation.NavigateTo($"/admin/seguridad/usuarios/{id}");

    private async Task ToggleActive(SecurityUser u)
    {
        if (!_canWrite) return;

        var success = await SecurityService.ToggleUserActiveAsync(u.Id);
        if (!success) return;

        var refreshed = await SecurityService.GetUserByIdAsync(u.Id);
        if (refreshed is null) return;

        u.IsActive = refreshed.IsActive;

        await SecurityService.LogAuditAsync(u.Id, CurrentUser.Username,
            u.IsActive ? "USER_ACTIVATED" : "USER_DEACTIVATED", $"Usuario afectado: {u.Username}");
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..1].ToUpper() : $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
} 









@page "/admin/seguridad/usuarios/{UserId:guid}"
@namespace CorpWiki.Web.Components.Pages
@attribute [Authorize(Policy = "ADMIN:READ")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Application.Interfaces
@using CorpWiki.Web.Security
@using CorpWiki.Web.Components.Shared.Security

@inject ISecurityService SecurityService
@inject ICurrentUserContext CurrentUser

<PageTitle>DaviWiki - Detalle de usuario</PageTitle>

<AdminNav />

@if (_loading)
{
    <p>Cargando...</p>
}
else if (_user is null)
{
    <div class="empty-state"><p>No se encontró el usuario.</p></div>
}
else
{
    <div class="page-header">
        <div>
            <h1>@_user.FullName</h1>
            <p>@_user.Username · @_user.Email · @_user.Department</p>
        </div>
    </div>

    <div class="card admin-section">
        <h3 class="admin-section__title"><Icon Name="shield" /> Roles asignados</h3>

        <div class="role-chip-list">
            @foreach (var r in _userRoles)
            {
                <RoleBadge Role="r" Removable="_canWrite" OnRemove="() => RemoveRole(r.Id)" />
            }
            @if (_userRoles.Count == 0)
            {
                <span class="role-chip-list__empty">Sin roles asignados todavía.</span>
            }
        </div>

        @if (_canWrite && _availableRoles.Any())
        {
            <div class="role-assign-row">
                <select class="input" @bind="_selectedRoleId">
                    <option value="">Seleccioná un rol...</option>
                    @foreach (var r in _availableRoles)
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                </select>
                <button class="btn btn--primary btn--sm" disabled="@(_selectedRoleId == Guid.Empty)" @onclick="AssignRole">
                    <Icon Name="plus" /> Asignar rol
                </button>
            </div>
        }
    </div>
}











using CorpWiki.Application.Interfaces;
using CorpWiki.Domain.Entities.Security;
using CorpWiki.Web.Security;
using Microsoft.AspNetCore.Components;

namespace CorpWiki.Web.Components.Pages;

public partial class UserDetail
{
    [Parameter] public Guid UserId { get; set; }

    [Inject] private ISecurityService SecurityService { get; set; } = default!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = default!;

    private SecurityUser? _user;
    private List<SecurityRole> _userRoles = new();
    private List<SecurityRole> _allRoles = new();
    private List<SecurityRole> _availableRoles => _allRoles.Where(r => _userRoles.All(ur => ur.Id != r.Id)).ToList();
    private Guid _selectedRoleId = Guid.Empty;
    private bool _loading = true;
    private bool _canWrite;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        _canWrite = CurrentUser.HasPermission("ADMIN", "WRITE");

        _user = await SecurityService.GetUserByIdAsync(UserId);
        _userRoles = await SecurityService.GetUserRolesAsync(UserId);
        _allRoles = await SecurityService.GetAllRolesAsync();
        _loading = false;
    }

    private async Task AssignRole()
    {
        if (!_canWrite || _selectedRoleId == Guid.Empty || _user is null) return;

        await SecurityService.AssignRoleToUserAsync(UserId, _selectedRoleId, CurrentUser.Username);
        var role = _allRoles.First(r => r.Id == _selectedRoleId);
        await SecurityService.LogAuditAsync(UserId, _user.Username, "ROLE_ASSIGNED", $"Rol asignado: {role.Name}");

        _selectedRoleId = Guid.Empty;
        _userRoles = await SecurityService.GetUserRolesAsync(UserId);
    }

    private async Task RemoveRole(Guid roleId)
    {
        if (!_canWrite || _user is null) return;

        var role = _allRoles.First(r => r.Id == roleId);
        await SecurityService.RemoveRoleFromUserAsync(UserId, roleId);
        await SecurityService.LogAuditAsync(UserId, _user.Username, "ROLE_REMOVED", $"Rol removido: {role.Name}");

        _userRoles = await SecurityService.GetUserRolesAsync(UserId);
    }
}







@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Application.Interfaces
@using CorpWiki.Web.Security

<div class="modal-overlay" @onclick="Close">
    <div class="modal-panel" @onclick:stopPropagation>
        <div class="modal-panel__header">
            <h3>Crear Rol</h3>
            <button class="icon-btn icon-btn--ghost" @onclick="Close"><Icon Name="x" /></button>
        </div>

        <div class="modal-panel__body">
            <div class="form-group">
                <label class="form-label">Nombre del Rol <span class="form-required">*</span></label>
                <input class="input" @bind="_name" placeholder="Ej: Certificador de Contenido" />
            </div>
            <div class="form-group">
                <label class="form-label">Descripción</label>
                <input class="input" @bind="_description" placeholder="¿Qué hace este rol?" />
            </div>

            <label class="form-label" style="margin-top: var(--space-4); display:block">Permisos por pantalla</label>

            @if (_loadingCatalog)
            {
                <p>Cargando catálogo...</p>
            }
            else
            {
                @foreach (var screen in _screens)
                {
                    var checkedCount = _permissions.Count(p => _selected.Contains((screen.Id, p.Id)));

                    <div class="permission-group">
                        <div class="permission-group__header">
                            <input type="checkbox"
                                   checked="@(checkedCount == _permissions.Count)"
                                   @onchange="@(e => ToggleGroup(screen, (bool)e.Value!))" />
                            <span>@screen.Name</span>
                            <span class="permission-group__count">(@checkedCount/@_permissions.Count)</span>
                        </div>

                        @foreach (var perm in _permissions)
                        {
                            var key = (screen.Id, perm.Id);
                            <label class="permission-checkbox-row">
                                <input type="checkbox" checked="@_selected.Contains(key)" @onchange="@(e => ToggleOne(key, (bool)e.Value!))" />
                                @perm.Name
                            </label>
                        }
                    </div>
                }
            }
        </div>

        <div class="modal-panel__footer">
            <button class="btn btn--ghost" @onclick="Close">Cancelar</button>
            <button class="btn btn--primary" disabled="@(string.IsNullOrWhiteSpace(_name) || _saving)" @onclick="Create">
                <Icon Name="check-circle" /> Crear Rol
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCreated { get; set; }

    [Inject] private ISecurityService SecurityService { get; set; } = default!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = default!;

    private string _name = "";
    private string _description = "";
    private List<SecurityScreen> _screens = new();
    private List<SecurityPermission> _permissions = new();
    private HashSet<(Guid, Guid)> _selected = new();
    private bool _loadingCatalog = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _screens = (await SecurityService.GetAllScreensAsync()).OrderBy(s => s.DisplayOrder).ToList();
        _permissions = await SecurityService.GetAllPermissionsAsync();
        _loadingCatalog = false;
    }

    private void ToggleGroup(SecurityScreen screen, bool value)
    {
        foreach (var p in _permissions)
        {
            var key = (screen.Id, p.Id);
            if (value) _selected.Add(key); else _selected.Remove(key);
        }
    }

    private void ToggleOne((Guid, Guid) key, bool value)
    {
        if (value) _selected.Add(key); else _selected.Remove(key);
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_name) || _saving) return;
        _saving = true;

        var role = await SecurityService.CreateRoleAsync(_name.Trim(), _description.Trim());

        foreach (var (screenId, permId) in _selected)
        {
            await SecurityService.SetRolePermissionAsync(role.Id, screenId, permId, true);
        }

        await SecurityService.LogAuditAsync(null, CurrentUser.Username, "ROLE_CREATED",
            $"Rol creado: {role.Name} con {_selected.Count} permiso(s).");

        _saving = false;

        if (OnCreated.HasDelegate) await OnCreated.InvokeAsync();
        await Close();
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}






