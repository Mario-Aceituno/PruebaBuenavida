/* ----------- Tab Gestión: jerarquía visual entre acciones ----------- */

/* Las acciones rápidas (asignar / cambiar estado) quedan más "livianas" */
.management-grid .widget--quick .widget__title {
    font-size: 13px;
    color: var(--text-secondary);
}

/* Transferir es la acción de mayor impacto: se separa del grid rápido
   y se destaca con un borde de advertencia sutil */
.widget--transfer {
    border-left: 3px solid var(--warning-500, #e0a020);
    padding-left: var(--space-4);
}

.widget--transfer .widget__title {
    color: var(--warning-600, #b8860b);
}

/* Separación clara entre el form de transferencia y el historial debajo */
.widget--transfer + .widget {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px dashed var(--border-subtle, rgba(255,255,255,0.08));
}

/* Botón de transferir con más peso que los btn--secondary comunes */
.btn--transfer {
    background: var(--warning-500, #e0a020);
    border-color: var(--warning-500, #e0a020);
    color: #1a1a1a;
    font-weight: 600;
}
.btn--transfer:hover:not(:disabled) {
    filter: brightness(1.08);
}
.btn--transfer:disabled {
    opacity: 0.5;
}

/* Labels para los selects (accesibilidad) */
.form-group__label {
    display: block;
    font-size: 12px;
    color: var(--text-tertiary);
    margin-bottom: 4px;
}

/* Historial de transferencias: filas más compactas y legibles */
.widget--history .activity-row {
    padding-block: 10px;
}
.widget--history .activity-row + .activity-row {
    border-top: 1px solid var(--border-subtle, rgba(255,255,255,0.06));
}