using Application.Common.Models;

namespace Application.Interfaces;

/// <summary>
/// Contrato para el servicio de almacenamiento de archivos (local, Cloudflare R2, S3, etc).
/// Las implementaciones concretas viven en la capa de Infraestructura.
/// </summary>
public interface IFileStorageService
{
    /// <summary>
    /// Sube un archivo al storage configurado y devuelve la clave (key) generada.
    /// </summary>
    Task<FileUploadResult> UploadAsync(FileUploadRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Elimina un archivo del storage a partir de su clave (key).
    /// Devuelve false si la clave no existe o la eliminación falla.
    /// </summary>
    Task<bool> DeleteAsync(string key, CancellationToken cancellationToken = default);

    /// <summary>
    /// Resuelve la URL pública accesible desde la CDN a partir de una clave (key)
    /// interna. Si el valor ya es una URL absoluta (datos legados), la devuelve tal cual.
    /// </summary>
    string GetPublicUrl(string? key);
}