private async Task<Guid> GetOrCreateCurrentAuthorIdAsync()
{
    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    var userName = authState.User.Identity?.Name ?? "Usuario Anónimo";
    var userEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "anonimo@corp.com";

    var authors = await Data.GetAuthorsAsync();
    var currentAuthor = authors.FirstOrDefault(a => a.FullName == userName);
    if (currentAuthor is null)
    {
        currentAuthor = await Data.CreateAuthorAsync(userName, userEmail);
    }

    return currentAuthor.Id;
}



if (!Guid.TryParse(_model.AuthorId, out var authorId))
{
    authorId = await GetOrCreateCurrentAuthorIdAsync();
}





