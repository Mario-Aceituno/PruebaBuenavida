USE Daviwiki;
GO

BEGIN TRANSACTION;

BEGIN TRY
    -- 1. Identificador del artículo a eliminar
    DECLARE @ArticleId UNIQUEIDENTIFIER = '4705-A68F-00DD96A143DE'; -- Reemplaza con tu Id real

    -------------------------------------------------------------------
    -- PASO 1 (DeletionOrder = 1): Nivel 2 de profundidad
    -- Apuntan a dbo.article_comments(Id)
    -------------------------------------------------------------------

    -- Eliminar likes de los comentarios del artículo
    DELETE FROM dbo.article_comment_likes 
    WHERE CommentId IN (
        SELECT Id FROM dbo.article_comments WHERE ArticleId = @ArticleId
    );

    -- Eliminar notificaciones asociadas a los comentarios del artículo
    DELETE FROM dbo.notifications 
    WHERE CommentId IN (
        SELECT Id FROM dbo.article_comments WHERE ArticleId = @ArticleId
    );

    -------------------------------------------------------------------
    -- PASO 2 (DeletionOrder = 2): Nivel 1 de profundidad
    -- Apuntan directamente a dbo.articles(Id)
    -------------------------------------------------------------------

    DELETE FROM dbo.article_attachments WHERE ArticleId = @ArticleId;
    DELETE FROM dbo.article_comments WHERE ArticleId = @ArticleId;
    DELETE FROM dbo.article_content_blocks WHERE ArticleId = @ArticleId;
    DELETE FROM dbo.article_favorites WHERE ArticleId = @ArticleId;
    DELETE FROM dbo.article_history WHERE ArticleId = @ArticleId;
    DELETE FROM dbo.article_ratings WHERE ArticleId = @ArticleId;
    
    -- Maneja las dos llaves posibles en la tabla auto-referencial de relacionados
    DELETE FROM dbo.article_related WHERE ArticleId = @ArticleId OR RelatedArticleId = @ArticleId;
    
    DELETE FROM dbo.article_tags WHERE ArticleId = @ArticleId;
    DELETE FROM dbo.article_versions WHERE ArticleId = @ArticleId;
    DELETE FROM dbo.collection_articles WHERE ArticleId = @ArticleId;

    -------------------------------------------------------------------
    -- PASO 3 (DeletionOrder = 3): Tabla Principal
    -------------------------------------------------------------------

    DELETE FROM dbo.articles WHERE Id = @ArticleId;

    -- Confirmación de cambios si no hay errores
    COMMIT TRANSACTION;
    PRINT 'Transacción completada exitosamente. Artículo y dependencias eliminados.';

END TRY
BEGIN CATCH
    -- Deshacer en caso de error
    ROLLBACK TRANSACTION;
    PRINT 'Error en la transacción. Se han revertido los cambios.';
    THROW;
END CATCH;
