public async Task<FileUploadResult> UploadAsync(FileUploadRequest request, CancellationToken cancellationToken = default)
{
    if (request.Content is null || request.SizeInBytes == 0)
        return FileUploadResult.Failure("El archivo está vacío o no es válido.");

    var extension = Path.GetExtension(request.FileName).ToLowerInvariant();
    if (_options.AllowedExtensions is { Length: > 0 } &&
        !_options.AllowedExtensions.Contains(extension))
        return FileUploadResult.Failure($"La extensión de archivo '{extension}' no está permitida.");

    if (request.SizeInBytes > _options.MaxFileSizeInBytes)
        return FileUploadResult.Failure(
            $"El archivo excede el tamaño máximo permitido ({_options.MaxFileSizeInBytes / (1024 * 1024)} MB).");

    try
    {
        var safeFileName = SanitizeFileName(request.FileName);
        var folder = CategoryFolder(request.Category);
        var (key, filePath) = ResolveUniqueDestination(folder, safeFileName);

        var directory = Path.GetDirectoryName(filePath)!;
        if (!Directory.Exists(directory))
            Directory.CreateDirectory(directory);

        await using var destination = new FileStream(filePath, FileMode.CreateNew);
        await request.Content.CopyToAsync(destination, cancellationToken);

        return FileUploadResult.Success(key);
    }
    catch (Exception ex)
    {
        return FileUploadResult.Failure(ex.Message);
    }
}

/// <summary>
/// Normaliza el nombre original (quita acentos, espacios y símbolos inseguros
/// para filesystem/URL) preservando la extensión. El nombre visible en
/// MediaFile.FileName no se toca; esto solo afecta la ruta física.
/// </summary>
private static string SanitizeFileName(string originalFileName)
{
    var name = Path.GetFileNameWithoutExtension(originalFileName);
    var extension = Path.GetExtension(originalFileName).ToLowerInvariant();

    var normalized = name.Normalize(NormalizationForm.FormD);
    var sb = new StringBuilder();
    foreach (var c in normalized)
        if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            sb.Append(c);
    name = sb.ToString().Normalize(NormalizationForm.FormC);

    name = Regex.Replace(name, @"\s+", "-");
    foreach (var c in Path.GetInvalidFileNameChars().Concat(new[] { '#', '?', '%', '&', '+' }))
        name = name.Replace(c.ToString(), string.Empty);

    name = Regex.Replace(name, "-{2,}", "-").Trim('-', '.');
    if (string.IsNullOrWhiteSpace(name))
        name = "archivo";

    return name + extension;
}

/// <summary>
/// Evita sobrescribir: si "archivo.png" ya existe, prueba "archivo-1.png", etc.
/// </summary>
private (string key, string filePath) ResolveUniqueDestination(string folder, string fileName)
{
    var name = Path.GetFileNameWithoutExtension(fileName);
    var extension = Path.GetExtension(fileName);
    var attempt = 0;

    while (true)
    {
        var candidateName = attempt == 0 ? fileName : $"{name}-{attempt}{extension}";
        var candidateKey = $"{folder}/{candidateName}";
        var candidatePath = ResolveSafePath(candidateKey, mustExist: false);

        if (!File.Exists(candidatePath))
            return (candidateKey, candidatePath);

        attempt++;
    }
}