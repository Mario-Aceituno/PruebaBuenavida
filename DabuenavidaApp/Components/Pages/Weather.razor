using Microsoft.AspNetCore.SignalR;

namespace CorpWiki.Web.Hubs;

public class CommentHub : Hub
{
    private static string GroupName(Guid articleId) => $"article-{articleId}";

    public async Task JoinArticleGroup(Guid articleId)
    {
        await Groups.AddToGroupAsync(Context.ConnectionId, GroupName(articleId));
    }

    public async Task LeaveArticleGroup(Guid articleId)
    {
        await Groups.RemoveFromGroupAsync(Context.ConnectionId, GroupName(articleId));
    }
}


