<div class="comment-card" id="comment-@Id">
    <span class="avatar avatar--sm" style="background:linear-gradient(135deg, @AuthorColorFrom, @AuthorColorTo)">@AuthorInitials</span>
    <div class="comment-card__body">
        <div class="comment-card__head">
            <span class="comment-card__author">@AuthorName</span>
            <span class="comment-card__date">@CreatedAt.ToString("d MMM yyyy")</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(ReplyingToAuthorName))
        {
            <p class="comment-card__mention">@@@ReplyingToAuthorName</p>
        }

        @if (_isEditing)
        {
            <div class="comment-card__edit-box">
                <textarea class="input" rows="2" @bind="_editContent"></textarea>
                <div class="comment-card__edit-actions">
                    <button class="btn btn--sm" @onclick="CancelEdit">Cancelar</button>
                    <button class="btn btn--primary btn--sm" @onclick="SubmitEdit">Guardar</button>
                </div>
            </div>
        }
        else
        {
            <p class="comment-card__text">@Content</p>
        }

        <div class="comment-card__actions">
            <button class="comment-card__like @(IsLiked ? "comment-card__like--active" : "")" @onclick="HandleLike">
                <Icon Name="thumbs-up" /> @LikesCount
            </button>
            <button class="comment-card__reply-btn" @onclick="ToggleReply">Responder</button>
            @if (CanEditOrDelete)
            {
                <button class="comment-card__edit-btn" @onclick="StartEdit">Editar</button>
                <button class="comment-card__delete-btn" @onclick="OpenDeleteModal">Eliminar</button>
            }
        </div>

        @if (_isReplying)
        {
            <div class="comment-composer comment-composer--reply">
                <textarea class="input" rows="2" placeholder="Escribe una respuesta..." @bind="_replyContent"></textarea>
                <button class="btn btn--primary btn--sm" @onclick="SubmitReply">Responder</button>
            </div>
        }

        @if (Replies.Count > 0)
        {
            <div class="comment-card__replies">
                @foreach (var reply in Replies)
                {
                    <CommentCard
                        Id="@reply.Id"
                        ParentCommentId="@reply.ParentCommentId"
                        AuthorName="@reply.AuthorName"
                        AuthorInitials="@reply.AuthorInitials"
                        AuthorColorFrom="@reply.AuthorColorFrom"
                        AuthorColorTo="@reply.AuthorColorTo"
                        Content="@reply.Content"
                        CreatedAt="@reply.CreatedAt"
                        LikesCount="@reply.LikesCount"
                        IsLiked="@reply.IsLikedByCurrentUser"
                        CanEditOrDelete="@reply.CanEditOrDelete"
                        ReplyingToAuthorName="@reply.ReplyingToAuthorName"
                        Replies="@(new List<CommentDto>())"
                        RootCommentId="@Id"
                        OnLike="OnLike"
                        OnReply="OnReply"
                        OnEdit="OnEdit"
                        OnDelete="OnDelete" />
                }
            </div>
        }
    </div>
</div>

@if (_showDeleteModal)
{
    <div class="modal-backdrop" @onclick="CloseDeleteModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h4>Eliminar comentario</h4>
            @if (Replies.Count > 0)
            {
                <p>Este comentario tiene @Replies.Count respuesta(s), también se eliminarán.</p>
            }
            else
            {
                <p>¿Seguro que quieres eliminar este comentario?</p>
            }
            <div class="modal-box__actions">
                <button class="btn btn--sm" @onclick="CloseDeleteModal">Cancelar</button>
                <button class="btn btn--danger btn--sm" @onclick="ConfirmDelete">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public Guid? ParentCommentId { get; set; }
    [Parameter] public Guid? RootCommentId { get; set; } // solo se usa en respuestas, para saber a qué hilo pertenecen al responder/editar
    [Parameter] public string AuthorName { get; set; } = string.Empty;
    [Parameter] public string AuthorInitials { get; set; } = "??";
    [Parameter] public string AuthorColorFrom { get; set; } = "#6366f1";
    [Parameter] public string AuthorColorTo { get; set; } = "#8b5cf6";
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public DateTime CreatedAt { get; set; }
    [Parameter] public int LikesCount { get; set; }
    [Parameter] public bool IsLiked { get; set; }
    [Parameter] public bool CanEditOrDelete { get; set; }
    [Parameter] public string? ReplyingToAuthorName { get; set; }
    [Parameter] public List<CommentDto> Replies { get; set; } = new();

    [Parameter] public EventCallback<Guid> OnLike { get; set; }
    [Parameter] public EventCallback<(Guid ParentId, string Content)> OnReply { get; set; }
    [Parameter] public EventCallback<(Guid CommentId, string Content)> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private bool _isReplying;
    private string _replyContent = string.Empty;
    private bool _isEditing;
    private string _editContent = string.Empty;
    private bool _showDeleteModal;

    private Task HandleLike() => OnLike.InvokeAsync(Id);

    private void ToggleReply() => _isReplying = !_isReplying;

    private async Task SubmitReply()
    {
        if (string.IsNullOrWhiteSpace(_replyContent)) return;

        // Si este CommentCard ya es una respuesta (tiene RootCommentId), el nuevo comentario
        // debe colgar del comentario raíz del hilo, no de esta respuesta específica —
        // el backend se encarga de mostrar la mención igualmente vía ReplyingToCommentId.
        var parentId = RootCommentId ?? Id;
        await OnReply.InvokeAsync((parentId, _replyContent));
        _replyContent = string.Empty;
        _isReplying = false;
    }

    private void StartEdit()
    {
        _editContent = Content;
        _isEditing = true;
    }

    private void CancelEdit() => _isEditing = false;

    private async Task SubmitEdit()
    {
        if (string.IsNullOrWhiteSpace(_editContent)) return;
        await OnEdit.InvokeAsync((Id, _editContent));
        _isEditing = false;
    }

    private void OpenDeleteModal() => _showDeleteModal = true;
    private void CloseDeleteModal() => _showDeleteModal = false;

    private async Task ConfirmDelete()
    {
        _showDeleteModal = false;
        await OnDelete.InvokeAsync(Id);
    }
}

