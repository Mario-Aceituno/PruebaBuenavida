if (content != null)
{
    var existingBlocks = await db.ArticleContentBlocks
        .Where(b => b.ArticleId == id)
        .ToListAsync();

    var incomingIds = content.Select(b => b.Id).ToHashSet();

    // Eliminar los que ya no están
    var toRemove = existingBlocks.Where(b => !incomingIds.Contains(b.Id)).ToList();
    if (toRemove.Count > 0)
        db.ArticleContentBlocks.RemoveRange(toRemove);

    // Actualizar los que siguen existiendo
    foreach (var block in content)
    {
        var existing = existingBlocks.FirstOrDefault(b => b.Id == block.Id);
        if (existing != null)
        {
            existing.Type = block.Type;
            existing.Order = block.Order;
            existing.Text = block.Text;
            existing.Meta = block.Meta;
            existing.Urls = block.Urls;
            existing.TableRows = block.TableRows;
        }
        else
        {
            block.ArticleId = id;
            db.ArticleContentBlocks.Add(block);
        }
    }

    await db.SaveChangesAsync();
}