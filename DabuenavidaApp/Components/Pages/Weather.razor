private async Task HandleCommentLike(Guid commentId)
{
    await Data.ToggleCommentLikeAsync(commentId);
    // La UI se actualiza vía el evento CommentLikeToggled, no aquí.
}

private async Task HandleCommentReply((Guid ParentId, string Content) args)
{
    if (string.IsNullOrWhiteSpace(args.Content)) return;
    await Data.CreateCommentAsync(_article.Id, args.ParentId, args.Content);
    // La UI se actualiza vía el evento CommentAdded.
}

private async Task HandleCommentEdit((Guid CommentId, string Content) args)
{
    if (string.IsNullOrWhiteSpace(args.Content)) return;
    await Data.UpdateCommentAsync(args.CommentId, args.Content);
    // La UI se actualiza vía el evento CommentUpdated.
}

private async Task HandleCommentDelete(Guid commentId)
{
    await Data.DeleteCommentAsync(commentId);
    // La UI se actualiza vía el evento CommentDeleted.
}



CSS

/* ---------- Comment card: acciones y estados nuevos ---------- */
.comment-card__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: 4px;
}

.comment-card__like--active {
    color: var(--brand-500);
}

.comment-card__reply-btn,
.comment-card__edit-btn,
.comment-card__delete-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    padding: 0;
}

.comment-card__reply-btn:hover,
.comment-card__edit-btn:hover {
    color: var(--brand-500);
}

.comment-card__delete-btn:hover {
    color: #ef4444;
}

.comment-card__mention {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--brand-500);
    margin-top: 2px;
    margin-bottom: 2px;
}

.comment-card__edit-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: 4px;
}

.comment-card__edit-box textarea {
    resize: vertical;
}

.comment-card__edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
}

.comment-card__replies {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-left: var(--space-6);
    border-left: 2px solid var(--border-color, #e5e7eb);
}

/* ---------- Composer de respuesta (reutiliza .comment-composer) ---------- */
.comment-composer--reply {
    margin-top: var(--space-2);
    margin-bottom: 0;
}

/* ---------- Botón de peligro ---------- */
.btn--danger {
    background: #ef4444;
    color: #fff;
    border: none;
}

.btn--danger:hover {
    background: #dc2626;
}

/* ---------- Modal de confirmación (sin librería) ---------- */
.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-box {
    background: var(--bg-surface, #fff);
    border-radius: 8px;
    padding: var(--space-6);
    max-width: 400px;
    width: 90%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.modal-box__actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-top: var(--space-4);
}