using CorpWiki.Application.DTOs;
using CorpWiki.Application.Interfaces;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Persistence;

public class StatsDataService : IStatsDataService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;

    public StatsDataService(IDbContextFactory<DaviWikiDbContext> dbFactory)
    {
        _dbFactory = dbFactory;
    }

    public async Task<StatsSnapshot> GetStatsAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var totalArticles = await db.Articles.CountAsync();
        var totalCategories = await db.Categories.CountAsync();
        var totalTags = await db.Tags.CountAsync();
        var totalMediaFiles = await db.MediaFiles.CountAsync();
        var totalAuthors = await db.Authors.CountAsync();
        var totalViews = await db.Articles.SumAsync(a => (int?)a.ViewCount) ?? 0;
        var featuredArticles = await db.Articles.CountAsync(a => a.IsFeatured);

        return new StatsSnapshot
        {
            TotalArticles = totalArticles,
            TotalCategories = totalCategories,
            TotalTags = totalTags,
            TotalMediaFiles = totalMediaFiles,
            TotalAuthors = totalAuthors,
            TotalViews = totalViews,
            FeaturedArticles = featuredArticles,
            WeeklyActivity = new List<WeeklyActivityPoint>() // Actividad semanal (Verificar en BD si existe)
        };
    }
}


