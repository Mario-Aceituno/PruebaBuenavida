@if (_allCards.Count == 0)
{
    <div class="empty-state">
        <Icon Name="history" Class="empty-state_icon" />
        <h3>Sin historial</h3>
        <p>Los artículos que visites aparecerán aquí.</p>
        <a class="btn btn--primary" href="/explorar">Explorar documentación</a>
    </div>
}
else
{
    <!-- Toolbar de Búsqueda -->
    <div class="explorer-toolbar mb-3">
        <div class="explorer-search">
            <Icon Name="search" />
            <input class="explorer-search__input" type="text" placeholder="Buscar en historial por título..."
                   @bind="_query" @bind:event="oninput" @bind:after="ApplyFilters" />
        </div>
    </div>

    @if (_filteredCards.Count == 0)
    {
        <div class="empty-state">
            <Icon Name="file-text" Class="empty-state_icon" />
            <h3>No se encontraron resultados</h3>
            <p>Prueba buscando con otros términos.</p>
        </div>
    }
    else
    {
        <div class="widget card" style="max-width:100%">
            @foreach (var dto in _pageItems)
            {
                <ArticleListItem Article="dto.Article"
                                Icon="clock"
                                MetaText="@($"Actualizado {Relative(dto.Article.UpdatedAt)}")" />
            }
        </div>

        <Pagination TotalItems="_filteredCards.Count"
                    PageSize="_pageSize"
                    CurrentPage="_page"
                    CurrentPageChanged="OnPageChanged" />
    }
}
