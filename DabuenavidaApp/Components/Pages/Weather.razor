public async Task<IReadOnlyList<CommentDto>> GetCommentsByArticleAsync(Guid articleId)
{
    var currentUserId = await _securityService.GetCurrentUserIdAsync();

    var all = await _db.ArticleComments
        .Include(c => c.User)
        .Where(c => c.ArticleId == articleId)
        .OrderBy(c => c.CreatedAt)
        .ToListAsync();

    if (all.Count == 0) return new List<CommentDto>();

    var likeCounts = await _db.ArticleCommentLikes
        .Where(l => all.Select(c => c.Id).Contains(l.CommentId))
        .GroupBy(l => l.CommentId)
        .Select(g => new { CommentId = g.Key, Count = g.Count() })
        .ToDictionaryAsync(x => x.CommentId, x => x.Count);

    var likedByMe = currentUserId != Guid.Empty
        ? (await _db.ArticleCommentLikes
            .Where(l => l.UserId == currentUserId && all.Select(c => c.Id).Contains(l.CommentId))
            .Select(l => l.CommentId)
            .ToListAsync()).ToHashSet()
        : new HashSet<Guid>();

    // Mapa comentario -> raíz de su hilo, y comentario -> autor (para menciones)
    var byId = all.ToDictionary(c => c.Id);
    Guid GetRootId(ArticleComment c)
    {
        var current = c;
        while (current.ParentCommentId is Guid pid && byId.TryGetValue(pid, out var parent))
            current = parent;
        return current.Id;
    }

    CommentDto Map(ArticleComment c)
    {
        var dto = new CommentDto
        {
            Id = c.Id,
            ParentCommentId = c.ParentCommentId,
            Content = c.Content,
            CreatedAt = c.CreatedAt,
            UpdatedAt = c.UpdatedAt,
            AuthorName = c.User?.FullName ?? "Usuario",
            AuthorInitials = c.User?.Initials ?? "??",
            AuthorColorFrom = c.User?.AvatarColorFrom ?? "#6366f1",
            AuthorColorTo = c.User?.AvatarColorTo ?? "#8b5cf6",
            LikesCount = likeCounts.TryGetValue(c.Id, out var lc) ? lc : 0,
            IsLikedByCurrentUser = likedByMe.Contains(c.Id),
            CanEditOrDelete = currentUserId != Guid.Empty && c.UserId == currentUserId
        };
        return dto;
    }

    var roots = all.Where(c => c.ParentCommentId == null)
                   .OrderBy(c => c.CreatedAt)
                   .Select(Map)
                   .ToList();
    var rootsById = roots.ToDictionary(r => r.Id);

    // Aplanar: cualquier comentario cuya raíz de hilo sea un root, va a Replies de ese root
    foreach (var c in all.Where(c => c.ParentCommentId != null).OrderBy(c => c.CreatedAt))
    {
        var rootId = GetRootId(c);
        if (!rootsById.TryGetValue(rootId, out var rootDto)) continue;

        var replyDto = Map(c);

        // Si respondió a otra respuesta (no a la raíz), guardar mención
        if (c.ParentCommentId != rootId && byId.TryGetValue(c.ParentCommentId!.Value, out var directParent))
        {
            replyDto.ReplyingToCommentId = directParent.Id;
            replyDto.ReplyingToAuthorName = directParent.User?.FullName ?? "Usuario";
        }

        rootDto.Replies.Add(replyDto);
    }

    return roots;
}

public async Task<CommentDto> CreateCommentAsync(Guid articleId, Guid? parentCommentId, string content)
{
    var userId = await _securityService.GetCurrentUserIdAsync();
    if (userId == Guid.Empty) throw new InvalidOperationException("Usuario no autenticado.");
    if (string.IsNullOrWhiteSpace(content)) throw new ArgumentException("El comentario no puede estar vacío.");

    var comment = new ArticleComment
    {
        Id = Guid.NewGuid(),
        ArticleId = articleId,
        UserId = userId,
        ParentCommentId = parentCommentId,
        Content = content.Trim(),
        CreatedAt = DateTime.UtcNow,
        IsDeleted = false
    };

    _db.ArticleComments.Add(comment);
    await _db.SaveChangesAsync();

    await CreateNotificationForNewCommentAsync(comment, userId);

    var saved = await _db.ArticleComments.Include(c => c.User)
        .FirstAsync(c => c.Id == comment.Id);

    return new CommentDto
    {
        Id = saved.Id,
        ParentCommentId = saved.ParentCommentId,
        Content = saved.Content,
        CreatedAt = saved.CreatedAt,
        AuthorName = saved.User?.FullName ?? "Usuario",
        AuthorInitials = saved.User?.Initials ?? "??",
        AuthorColorFrom = saved.User?.AvatarColorFrom ?? "#6366f1",
        AuthorColorTo = saved.User?.AvatarColorTo ?? "#8b5cf6",
        CanEditOrDelete = true
    };
}

public async Task<bool> UpdateCommentAsync(Guid commentId, string content)
{
    var userId = await _securityService.GetCurrentUserIdAsync();
    if (userId == Guid.Empty) return false;
    if (string.IsNullOrWhiteSpace(content)) return false;

    var comment = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
    if (comment is null || comment.UserId != userId) return false;

    comment.Content = content.Trim();
    comment.UpdatedAt = DateTime.UtcNow;
    await _db.SaveChangesAsync();
    return true;
}

public async Task<bool> DeleteCommentAsync(Guid commentId)
{
    var userId = await _securityService.GetCurrentUserIdAsync();
    if (userId == Guid.Empty) return false;

    var root = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
    if (root is null || root.UserId != userId) return false;

    // Cargar todo el subárbol (respuestas de respuestas incluidas)
    var toDelete = new List<ArticleComment> { root };
    var frontier = new List<Guid> { root.Id };
    while (frontier.Count > 0)
    {
        var children = await _db.ArticleComments
            .Where(c => c.ParentCommentId != null && frontier.Contains(c.ParentCommentId!.Value))
            .ToListAsync();
        if (children.Count == 0) break;
        toDelete.AddRange(children);
        frontier = children.Select(c => c.Id).ToList();
    }

    // Borrar de hojas hacia raíz (orden inverso al que se descubrieron, ya es BFS raíz->hojas)
    await using var tx = await _db.Database.BeginTransactionAsync();
    try
    {
        for (int i = toDelete.Count - 1; i >= 0; i--)
        {
            _db.ArticleComments.Remove(toDelete[i]);
            await _db.SaveChangesAsync();
        }
        await tx.CommitAsync();
    }
    catch
    {
        await tx.RollbackAsync();
        throw;
    }

    return true;
}

public async Task<bool> ToggleCommentLikeAsync(Guid commentId)
{
    var userId = await _securityService.GetCurrentUserIdAsync();
    if (userId == Guid.Empty) return false;

    var existing = await _db.ArticleCommentLikes
        .FirstOrDefaultAsync(l => l.CommentId == commentId && l.UserId == userId);

    bool liked;
    if (existing != null)
    {
        _db.ArticleCommentLikes.Remove(existing);
        liked = false;
    }
    else
    {
        _db.ArticleCommentLikes.Add(new ArticleCommentLike
        {
            CommentId = commentId,
            UserId = userId,
            CreatedAt = DateTime.UtcNow
        });
        liked = true;
    }

    await _db.SaveChangesAsync();

    if (liked)
    {
        var comment = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
        if (comment != null && comment.UserId != userId)
        {
            _db.Notifications.Add(new Notification
            {
                Id = Guid.NewGuid(),
                RecipientUserId = comment.UserId,
                ActorUserId = userId,
                CommentId = comment.Id,
                Type = NotificationType.CommentLike,
                CreatedAt = DateTime.UtcNow
            });
            await _db.SaveChangesAsync();
        }
    }

    return liked;
}

private async Task CreateNotificationForNewCommentAsync(ArticleComment comment, Guid actorUserId)
{
    if (comment.ParentCommentId is null)
    {
        var article = await _db.Articles.FirstOrDefaultAsync(a => a.Id == comment.ArticleId);
        if (article is null) return;

        var author = await _db.Authors.FirstOrDefaultAsync(a => a.Id == article.AuthorId);
        if (author?.SecurityUserId is not Guid recipientId || recipientId == actorUserId) return;

        _db.Notifications.Add(new Notification
        {
            Id = Guid.NewGuid(),
            RecipientUserId = recipientId,
            ActorUserId = actorUserId,
            CommentId = comment.Id,
            Type = NotificationType.CommentOnArticle,
            CreatedAt = DateTime.UtcNow
        });
        await _db.SaveChangesAsync();
    }
    else
    {
        var parent = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == comment.ParentCommentId);
        if (parent is null || parent.UserId == actorUserId) return;

        _db.Notifications.Add(new Notification
        {
            Id = Guid.NewGuid(),
            RecipientUserId = parent.UserId,
            ActorUserId = actorUserId,
            CommentId = comment.Id,
            Type = NotificationType.ReplyToComment,
            CreatedAt = DateTime.UtcNow
        });
        await _db.SaveChangesAsync();
    }
}

