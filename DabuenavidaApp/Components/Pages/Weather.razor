private async Task CreateNotificationForNewCommentAsync(ArticleComment comment, Guid actorUserId)
{
    if (comment.ParentCommentId is null)
    {
        var article = await _db.Articles.FirstOrDefaultAsync(a => a.Id == comment.ArticleId);
        if (article is null) return;

        var author = await _db.Authors.FirstOrDefaultAsync(a => a.Id == article.AuthorId);
        if (author?.SecurityUserId is not Guid recipientId || recipientId == actorUserId) return;

        await CreateAndBroadcastNotificationAsync(
            recipientUserId: recipientId,
            actorUserId: actorUserId,
            commentId: comment.Id,
            type: NotificationType.CommentOnArticle);
    }
    else
    {
        var parent = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == comment.ParentCommentId);
        if (parent is null || parent.UserId == actorUserId) return;

        await CreateAndBroadcastNotificationAsync(
            recipientUserId: parent.UserId,
            actorUserId: actorUserId,
            commentId: comment.Id,
            type: NotificationType.ReplyToComment);
    }
}