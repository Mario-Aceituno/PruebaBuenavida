<div class="journey-modal_body journey-modal_body--@(_isExpanded ? "expanded" : "normal")">
    
    @if (_isExpanded)
    {
        <!-- Columna Izquierda: Información de contexto y métricas -->
        <div class="journey-modal__col">
            <!-- Bloque 1: Recorrido y Estado -->
            <div class="journey-context">
                <!-- Tu código existente de .journey-context -->
            </div>

            <!-- Bloque 2: Resumen del incidente -->
            <div class="journey-summary">
                <!-- Tu código existente de .journey-summary -->
            </div>

            <!-- Bloque 3: Métricas -->
            <div class="journey-metrics-wrapper">
                <!-- Tu código existente de MÉTRICAS (Trabajo efectivo, espera, etc.) -->
            </div>
        </div>

        <!-- Columna Derecha: Equipo, Actividad y Comentarios -->
        <div class="journey-modal__col">
            <!-- Bloque 4: Equipo -->
            <div class="journey-team-wrapper">
                <!-- Tu código existente de EQUIPO (Responsable y Otros participantes) -->
            </div>

            <!-- Bloque 5: Actividad y Timeline -->
            <div class="journey-activity-wrapper">
                <!-- Tu código existente de ACTIVIDAD y Qué hizo el equipo -->
            </div>

            <!-- Bloque 6: Transferencias / Comentarios -->
            <!-- Tu código existente de TRANSFERENCIAS Y COMENTARIOS -->
        </div>
    }
    else
    {
        <!-- Vista normal de 1 columna para cuando NO está expandido -->
        <!-- Tu código Razor tal como lo tenías originalmente sin dividir -->
    }

</div>



/* Modal Expandido */
.journey-modal.journey-modal--expanded {
    max-width: 92vw;
    width: 92vw;
    height: 88vh;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
}

/* Layout de 2 columnas cuando está expandido */
.journey-modal_body--expanded {
    display: grid !important;
    grid-template-columns: 1fr 1fr; /* Dos columnas de igual proporción */
    gap: 24px;
    padding: 20px 24px;
    flex: 1;
    overflow-y: auto; /* Scroll si el contenido vertical de alguna columna sobrepasa el alto */
    min-height: 0;   /* Permite el scroll interno en Flexbox */
}

/* Columna individual */
.journey-modal__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* Tarjetas/Contenedores internos dentro de las columnas para darle mejor impacto visual */
.journey-modal--expanded .journey-context,
.journey-modal--expanded .journey-summary,
.journey-modal--expanded .journey-metrics-wrapper,
.journey-modal--expanded .journey-team-wrapper,
.journey-modal--expanded .journey-activity-wrapper {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: 8px;
    padding: 16px;
}
