@page "/dashboard"
@inject IWikiDataService Data

<PageTitle>DaviWiki - Dashboard</PageTitle>

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p>Un resumen de lo que pasa en la DaviWiki.</p>
    </div>
</div>

<div class="stat-grid">
    @foreach (var stat in _statCards)
    {
        <StatCard Dto="stat" />
    }
</div>

<!-- BARRA DE NAVEGACIÓN POR PESTAÑAS -->
<div class="detail-tabs" role="tablist">
    <button class="detail-tabs__item @(_activeTab == "Artículos" ? "detail-tabs__item--active" : "")"
            role="tab" 
            aria-selected="@(_activeTab == "Artículos")" 
            @onclick='() => SetTab("Artículos")'>
        <Icon Name="file-text" /> Artículos
    </button>
    <button class="detail-tabs__item @(_activeTab == "Actividad" ? "detail-tabs__item--active" : "")"
            role="tab" 
            aria-selected="@(_activeTab == "Actividad")" 
            @onclick='() => SetTab("Actividad")'>
        <Icon Name="activity" /> Actividad
    </button>
</div>

<!-- CONTENIDO DE LA PESTAÑA 1: ARTÍCULOS -->
@if (_activeTab == "Artículos")
{
    <div>
        <section class="section">
            <SectionHeader Title="Artículos recientes" Subtitle="Lo último publicado o actualizado" LinkHref="/explorar" />
            <div class="widget card">
                @foreach (var a in _recent)
                {
                    <ArticleListItem Article="a" Icon="clock" MetaText="@($"Actualizado {FormatRelative(a.UpdatedAt)}")" />
                }
            </div>
        </section>

        <section class="section">
            <SectionHeader Title="Artículos populares" Subtitle="Los más vistos por el equipo" LinkHref="/explorar" />
            <div class="widget card">
                @foreach (var a in _popular)
                {
                    <ArticleListItem Article="a" Icon="eye" MetaText="@($" {a.ViewCount} vistas")" />
                }
            </div>
        </section>

        <section class="section">
            <SectionHeader Title="Pendientes de leer" Subtitle="Sugerencias basadas en tu actividad" />
            <div class="widget card">
                @foreach (var a in _pending)
                {
                    <ArticleListItem Article="a" Icon="inbox" MetaText="@($" {a.ReadingTimeMinutes} min de lectura")" />
                }
            </div>
        </section>
    </div>
}

<!-- CONTENIDO DE LA PESTAÑA 2: ACTIVIDAD Y SECUNDARIOS -->
@if (_activeTab == "Actividad")
{
    <div>
        <section class="section">
            <h4 class="widget__title"><Icon Name="activity" /> Actividad reciente</h4>
            <div class="widget card">
                @foreach (var activity in _activity)
                {
                    <div class="activity-row">
                        <span class="activity-row__avatar">@GetAuthorInitials(activity.AuthorId)</span>
                        <div>
                            <p class="activity-row__text">@activity.Description</p>
                            <p class="activity-row__time">@FormatRelative(activity.OccurredAt)</p>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="section">
            <h4 class="widget__title"><Icon Name="folder-tree" /> Categorías con más actividad</h4>
            <div class="widget card">
                @foreach (var cat in _topCategories)
                {
                    <a class="category-row" href="@($"/categorias/{cat.Slug}")">
                        <span class="category-row__icon" style="background:@($"{cat.Color}1a"); color:@cat.Color;"><Icon Name="@cat.Icon" /></span>
                        <span class="category-row__name">@cat.Name</span>
                        <span class="badge">@cat.ArticlesCount</span>
                    </a>
                }
            </div>
        </section>

        <section class="section">
            <h4 class="widget__title"><Icon Name="star" /> Tus favoritos</h4>
            <div class="widget card">
                @if (_favorites.Count == 0)
                {
                    <p style="color:var(--text-tertiary); font-size:var(--fs-sm);">Aún no tienes artículos favoritos.</p>
                }
                @foreach (var a in _favorites.Take(4))
                {
                    <ArticleListItem Article="a" Icon="star" MetaText="Guardado en favoritos" ShowChevron="false" />
                }
            </div>
        </section>
    </div>
}

@code {
    private string _activeTab = "Artículos";

    private void SetTab(string tab) => _activeTab = tab;
}
