using CorpWiki.Application.Interfaces;
using CorpWiki.Application.Interfaces.Repositories;
using CorpWiki.Domain.Entities;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Persistence;

public class TagDataService : ITagDataService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;
    private readonly ITagRepository _tagRepo;

    public TagDataService(
        IDbContextFactory<DaviWikiDbContext> dbFactory,
        ITagRepository tagRepo)
    {
        _dbFactory = dbFactory;
        _tagRepo = tagRepo;
    }

    public async Task<IReadOnlyList<Tag>> GetTagsAsync() => await _tagRepo.GetAllAsync();

    public async Task<Tag?> GetTagByIdAsync(Guid id) => await _tagRepo.GetByIdAsync(id);

    public async Task<Tag?> GetTagBySlugAsync(string slug) => await _tagRepo.GetBySlugAsync(slug);

    public async Task<IReadOnlyList<Tag>> GetPopularTagsAsync(int count = 30)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        return await db.Tags
            .OrderByDescending(t => t.UsageCount)
            .Take(count)
            .AsNoTracking()
            .ToListAsync();
    }

    public async Task<Tag> CreateTagAsync(string name)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var trimmedName = name.Trim();
        var slug = trimmedName.ToLowerInvariant().Replace(" ", "-");

        var newTag = new Tag
        {
            Id = Guid.NewGuid(),
            Name = trimmedName,
            Slug = slug
        };

        db.Tags.Add(newTag);
        await db.SaveChangesAsync();
        return newTag;
    }

    public async Task<Tag?> UpdateTagAsync(Guid id, string name)
    {
        var tag = await _tagRepo.GetByIdAsync(id);
        if (tag == null) return null;

        var trimmedName = name.Trim();
        tag.Name = trimmedName;
        tag.Slug = trimmedName.ToLowerInvariant().Replace(" ", "-");

        return await _tagRepo.UpdateAsync(tag);
    }
}



