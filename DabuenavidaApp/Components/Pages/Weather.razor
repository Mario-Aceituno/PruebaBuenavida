// Ejemplo al auto-provisionar o actualizar el usuario en base de datos:
var adResult = await _adValidator.ValidateAsync(username, password, peopleSoftId);

if (adResult.IsValid)
{
    var user = await _userRepository.GetByUsernameAsync(username);
    if (user == null)
    {
        user = new SecurityUser { Username = username };
    }

    // AQUÍ ES DONDE SE ACTUALIZAN LOS DATOS DEL AD
    user.FullName = adResult.FullName;
    user.Email = adResult.Email;
    user.Department = adResult.Department;
    user.Position = adResult.Position;
    user.PeopleSoftId = peopleSoftId;
    user.LastLoginAt = DateTime.UtcNow;

    await _userRepository.SaveAsync(user);
}



