// Modificado a async Task para permitir interoperabilidad con JS
private async Task OpenJourneyModal(int startIndex = 0)
{
    if (_journey.Count == 0) return;
    
    _journeyStepIndex = Math.Clamp(startIndex, 0, _journey.Count - 1);
    _journeyStep = BuildAreaStory(_journey[_journeyStepIndex].AreaName);
    _showJourneyModal = true;

    // 1. Mueve el scroll del navegador al inicio
    await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);

    // 2. Bloquea el scroll del body agregando la clase
    await JSRuntime.InvokeVoidAsync("document.body.classList.add", "modal-open");
}

// Modificado a async Task para quitar la clase al cerrar
private async Task CloseJourneyModal()
{
    _showJourneyModal = false;

    // Devuelve el scroll a la página al cerrar
    await JSRuntime.InvokeVoidAsync("document.body.classList.remove", "modal-open");
}

// Modificado a async Task porque invoca a OpenJourneyModal
private async Task OpenAreaModal(string areaName)
{
    var idx = _journey.FindIndex(j => j.AreaName == areaName);
    await OpenJourneyModal(idx >= 0 ? idx : 0);
}
