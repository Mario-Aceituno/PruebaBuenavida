using Microsoft.AspNetCore.SignalR.Client;
using CorpWiki.Application.DTOs;

public partial class ArticuloDetalle : IAsyncDisposable

private List<Comment> _comments = new();

private List<CommentDto> _comments = new();
private HubConnection? _commentHubConnection;

_comments = (await Data.GetCommentsByArticleAsync(_article.Id)).ToList();

protected override async Task OnInitializedAsync()
{
    if (_article is not null)
    {
        _userRating = await wikiDataService.GetUserRatingAsync(_article.Id);
    }

    await ConnectCommentHubAsync();
}

private async Task ConnectCommentHubAsync()
{
    _commentHubConnection = new HubConnectionBuilder()
        .WithUrl(Nav.ToAbsoluteUri("/hubs/comments"))
        .WithAutomaticReconnect()
        .Build();

    _commentHubConnection.On<CommentDto>("CommentAdded", comment =>
    {
        InvokeAsync(() =>
        {
            if (comment.ParentCommentId is null)
            {
                _comments.Add(comment);
            }
            else
            {
                var root = _comments.FirstOrDefault(c => c.Id == comment.ParentCommentId)
                           ?? _comments.FirstOrDefault(c => c.Replies.Any(r => r.Id == comment.ParentCommentId));
                root?.Replies.Add(comment);
            }
            StateHasChanged();
        });
    });

    _commentHubConnection.On<CommentDto>("CommentUpdated", comment =>
    {
        InvokeAsync(() =>
        {
            if (comment.ParentCommentId is null)
            {
                var idx = _comments.FindIndex(c => c.Id == comment.Id);
                if (idx >= 0)
                {
                    comment.Replies = _comments[idx].Replies; // conservar respuestas ya cargadas
                    _comments[idx] = comment;
                }
            }
            else
            {
                var root = _comments.FirstOrDefault(c => c.Replies.Any(r => r.Id == comment.Id));
                if (root != null)
                {
                    var ridx = root.Replies.FindIndex(r => r.Id == comment.Id);
                    if (ridx >= 0) root.Replies[ridx] = comment;
                }
            }
            StateHasChanged();
        });
    });

    _commentHubConnection.On<Guid[]>("CommentDeleted", deletedIds =>
    {
        InvokeAsync(() =>
        {
            _comments.RemoveAll(c => deletedIds.Contains(c.Id));
            foreach (var root in _comments)
                root.Replies.RemoveAll(r => deletedIds.Contains(r.Id));
            StateHasChanged();
        });
    });

    _commentHubConnection.On<Guid, int, Guid, bool>("CommentLikeToggled", (commentId, likesCount, userId, liked) =>
    {
        InvokeAsync(() =>
        {
            var target = _comments.FirstOrDefault(c => c.Id == commentId)
                         ?? _comments.SelectMany(c => c.Replies).FirstOrDefault(r => r.Id == commentId);
            if (target != null)
            {
                target.LikesCount = likesCount;
                if (userId == _author?.Id) target.IsLikedByCurrentUser = liked;
            }
            StateHasChanged();
        });
    });

    await _commentHubConnection.StartAsync();

    if (_article is not null)
        await _commentHubConnection.SendAsync("JoinArticleGroup", _article.Id);
}


if (_commentHubConnection is { State: HubConnectionState.Connected })
    await _commentHubConnection.SendAsync("JoinArticleGroup", _article.Id);

private async Task AddComment()
{
    if (string.IsNullOrWhiteSpace(_newComment) || _article is null) return;

    await Data.CreateCommentAsync(_article.Id, null, _newComment);
    _newComment = string.Empty;
    // No se actualiza _comments aquí: llega por el evento CommentAdded del Hub.
}

private async Task LikeComment(Guid commentId)
{
    await Data.ToggleCommentLikeAsync(commentId);
}

private async Task ReplyToComment((Guid ParentId, string Content) reply)
{
    if (_article is null || string.IsNullOrWhiteSpace(reply.Content)) return;
    await Data.CreateCommentAsync(_article.Id, reply.ParentId, reply.Content);
}

private async Task EditComment((Guid CommentId, string Content) edit)
{
    if (string.IsNullOrWhiteSpace(edit.Content)) return;
    await Data.UpdateCommentAsync(edit.CommentId, edit.Content);
}

private async Task DeleteComment(Guid commentId)
{
    await Data.DeleteCommentAsync(commentId);
}

public async ValueTask DisposeAsync()
{
    if (_commentHubConnection is not null)
    {
        if (_commentHubConnection.State == HubConnectionState.Connected && _article is not null)
        {
            try { await _commentHubConnection.SendAsync("LeaveArticleGroup", _article.Id); }
            catch { /* conexión ya cerrada, ignorar */ }
        }
        await _commentHubConnection.DisposeAsync();
    }
}

