@inject NavigationManager Navigation

<div class="category-card card card--interactive" @onclick="NavigateToCategory">
    @if (OnEdit.HasDelegate)
    {
        <button type="button" 
                class="card-edit-btn" 
                title="Editar categoría" 
                @onclick="HandleEdit" 
                @onclick:stopPropagation>
            <Icon Name="pencil" />
        </button>
    }

    <div class="category-card__icon style-init category-card__icon-dynamic" style="--user-cat-color: @Category.Color;">
        <Icon Name="@Category.Icon" />
    </div>
    <div class="category-card__info">
        <h4 class="category-card__name">@Category.Name</h4>
        <p class="category-card__count">@Category.ArticlesCount artículos</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Category Category { get; set; } = default!;
    [Parameter] public EventCallback<Category> OnEdit { get; set; }

    private Task HandleEdit() => OnEdit.InvokeAsync(Category);

    private void NavigateToCategory()
    {
        Navigation.NavigateTo($"/categorias/{Category.Slug}");
    }
}
