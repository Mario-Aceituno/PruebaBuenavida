// Application
public interface INotificationBroadcaster
{
    Task RaiseNotificationCreatedAsync(Guid recipientUserId, NotificationItem item);
}

public interface INotificationRealtimeNotifier
{
    event Func<NotificationItem, Task>? NotificationCreated;
    Task InvokeAllAsync(Guid recipientUserId, NotificationItem item);
}

