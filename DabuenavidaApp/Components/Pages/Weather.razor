public async Task<bool> DeleteCommentAsync(Guid commentId)
{
    var userId = await _securityService.GetCurrentUserIdAsync();
    if (userId == Guid.Empty) return false;

    var root = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
    if (root is null || root.UserId != userId) return false;

    // Traemos todo el árbol de comentarios del artículo una sola vez;
    // el BFS se hace en memoria para no repetir Contains() sobre BD (eso disparaba el error "WITH").
    var allInArticle = await _db.ArticleComments
        .Where(c => c.ArticleId == root.ArticleId)
        .ToListAsync();

    var toDelete = new List<ArticleComment> { root };
    var frontier = new HashSet<Guid> { root.Id };
    while (frontier.Count > 0)
    {
        var children = allInArticle
            .Where(c => c.ParentCommentId is Guid pid && frontier.Contains(pid))
            .ToList();
        if (children.Count == 0) break;
        toDelete.AddRange(children);
        frontier = children.Select(c => c.Id).ToHashSet();
    }

    var articleId = root.ArticleId;
    await using var tx = await _db.Database.BeginTransactionAsync();
    try
    {
        for (int i = toDelete.Count - 1; i >= 0; i--)
        {
            _db.ArticleComments.Remove(toDelete[i]);
            await _db.SaveChangesAsync();
        }
        await tx.CommitAsync();
    }
    catch
    {
        await tx.RollbackAsync();
        throw;
    }

    var deletedIds = toDelete.Select(c => c.Id).ToArray();
    await _commentBroadcaster.CommentDeletedAsync(articleId, deletedIds);
    return true;
}



