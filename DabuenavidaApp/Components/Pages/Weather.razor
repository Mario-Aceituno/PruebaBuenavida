    new(ClaimTypes.Name, !string.IsNullOrEmpty(authResult.User.FullName) ? authResult.User.FullName : authResult.User.Username),
    new("FullName", authResult.User.FullName ?? string.Empty),
    new("PeopleSoftId", authResult.User.PeopleSoftId ?? string.Empty),
    new("Email", authResult.User.Email ?? string.Empty),
    new("Department", authResult.User.Department ?? string.Empty),
    new("Position", authResult.User.Position ?? string.Empty)
};

foreach (var role in authResult.Roles)
{
    claims.Add(new Claim(ClaimTypes.Role, role));
}


