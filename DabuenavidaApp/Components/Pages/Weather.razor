public async Task<IReadOnlyList<NotificationItem>> GetNotificationsAsync()
{
    var userId = _currentUser.UserId; // ajusta al accessor real

    var notifications = await _db.Notifications
        .Where(n => n.RecipientUserId == userId)
        .Include(n => n.Actor)
        .Include(n => n.Comment)
        .OrderByDescending(n => n.CreatedAt)
        .Take(30) // límite razonable para el dropdown
        .ToListAsync();

    return notifications.Select(ToNotificationItem).ToList();
}

public async Task<int> GetUnreadNotificationsCountAsync()
{
    var userId = _currentUser.UserId;

    return await _db.Notifications
        .CountAsync(n => n.RecipientUserId == userId && !n.IsRead);
}

public async Task MarkNotificationAsReadAsync(Guid id)
{
    var userId = _currentUser.UserId;

    var notification = await _db.Notifications
        .FirstOrDefaultAsync(n => n.Id == id && n.RecipientUserId == userId);

    if (notification is null || notification.IsRead) return;

    notification.IsRead = true;
    notification.ReadAt = DateTime.UtcNow;
    await _db.SaveChangesAsync();
}

public async Task MarkAllNotificationsAsReadAsync()
{
    var userId = _currentUser.UserId;
    var now = DateTime.UtcNow;

    await _db.Notifications
        .Where(n => n.RecipientUserId == userId && !n.IsRead)
        .ExecuteUpdateAsync(s => s
            .SetProperty(n => n.IsRead, true)
            .SetProperty(n => n.ReadAt, now));
}


