using CorpWiki.Application.Interfaces;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Persistence;

public class EfWikiDataService : IWikiDataService
{
    private readonly DaviwikiDbContext _db;
    private readonly ICurrentUserContext _currentUserContext;

    public EfWikiDataService(DaviwikiDbContext db, ICurrentUserContext currentUserContext)
    {
        _db = db;
        _currentUserContext = currentUserContext;
    }

    public async Task<bool> IsFavoriteAsync(Guid articleId)
    {
        var userId = await _currentUserContext.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return false;

        return await _db.ArticleFavorites
            .AnyAsync(f => f.UserId == userId && f.ArticleId == articleId);
    }

    public async Task<bool> ToggleFavoriteAsync(Guid articleId)
    {
        var userId = await _currentUserContext.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return false;

        var favorite = await _db.ArticleFavorites
            .FirstOrDefaultAsync(f => f.UserId == userId && f.ArticleId == articleId);

        if (favorite != null)
        {
            _db.ArticleFavorites.Remove(favorite);
            await _db.SaveChangesAsync();
            return false; // Ya no es favorito
        }

        var newFavorite = new ArticleFavorite
        {
            UserId = userId,
            ArticleId = articleId,
            CreatedAt = DateTime.UtcNow
        };

        await _db.ArticleFavorites.AddAsync(newFavorite);
        await _db.SaveChangesAsync();
        return true; // Marcado como favorito
    }

    public async Task<IReadOnlyList<Article>> GetFavoriteArticlesAsync()
    {
        var userId = await _currentUserContext.GetCurrentUserIdAsync();
        if (userId == Guid.Empty) return new List<Article>();

        var favoriteArticles = await _db.ArticleFavorites
            .Where(f => f.UserId == userId)
            .OrderByDescending(f => f.CreatedAt)
            .Select(f => f.Article)
            .ToListAsync();

        foreach (var article in favoriteArticles)
        {
            await PopulateNotMappedListsAsync(article);
        }

        return favoriteArticles;
    }
}


