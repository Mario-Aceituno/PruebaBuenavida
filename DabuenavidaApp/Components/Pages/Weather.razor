private async Task CreateAndBroadcastNotificationAsync(
    Guid recipientUserId, Guid actorUserId, Guid commentId, NotificationType type)
{
    // Evita auto-notificarte (comentar tu propio artículo, dar like a tu propio comentario, etc.)
    if (recipientUserId == actorUserId) return;

    var notification = new Notification
    {
        Id = Guid.NewGuid(),
        RecipientUserId = recipientUserId,
        ActorUserId = actorUserId,
        CommentId = commentId,
        Type = type,
        IsRead = false,
        CreatedAt = DateTime.UtcNow
    };

    _db.Notifications.Add(notification);
    await _db.SaveChangesAsync();

    // Recargar con Actor/Comment para poder mapear a NotificationItem
    await _db.Entry(notification).Reference(n => n.Actor).LoadAsync();
    await _db.Entry(notification).Reference(n => n.Comment).LoadAsync();

    var item = ToNotificationItem(notification);
    await _notificationBroadcaster.RaiseNotificationCreatedAsync(recipientUserId, item);
}

