using CorpWiki.Domain.Entities;

namespace CorpWiki.Application.Interfaces;

public interface ITagDataService
{
    Task<IReadOnlyList<Tag>> GetTagsAsync();
    Task<Tag?> GetTagByIdAsync(Guid id);
    Task<Tag?> GetTagBySlugAsync(string slug);
    Task<IReadOnlyList<Tag>> GetPopularTagsAsync(int count = 30);
