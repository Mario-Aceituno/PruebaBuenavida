// Web
public class NotificationBroadcaster : INotificationBroadcaster
{
    private readonly INotificationRealtimeNotifier _notifier;
    public NotificationBroadcaster(INotificationRealtimeNotifier notifier) => _notifier = notifier;

    public Task RaiseNotificationCreatedAsync(Guid recipientUserId, NotificationItem item)
        => _notifier.InvokeAllAsync(recipientUserId, item);
}

public class NotificationRealtimeNotifier : INotificationRealtimeNotifier
{
    public event Func<NotificationItem, Task>? NotificationCreated;

    // Guardamos el userId destinatario junto con cada suscriptor para filtrar
    private readonly List<(Guid UserId, Func<NotificationItem, Task> Handler)> _subscribers = new();

    public void Subscribe(Guid userId, Func<NotificationItem, Task> handler)
        => _subscribers.Add((userId, handler));

    public void Unsubscribe(Func<NotificationItem, Task> handler)
        => _subscribers.RemoveAll(s => s.Handler == handler);

    public async Task InvokeAllAsync(Guid recipientUserId, NotificationItem item)
    {
        foreach (var (userId, handler) in _subscribers.Where(s => s.UserId == recipientUserId).ToList())
            await handler(item);
    }
}

