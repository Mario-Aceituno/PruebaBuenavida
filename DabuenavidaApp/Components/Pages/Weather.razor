using CorpWiki.Application.Interfaces;
using CorpWiki.Application.Interfaces.Repositories;
using CorpWiki.Domain.Entities;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Persistence;

public class AuthorDataService : IAuthorDataService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;
    private readonly IAuthorRepository _authorRepo;

    public AuthorDataService(
        IDbContextFactory<DaviWikiDbContext> dbFactory,
        IAuthorRepository authorRepo)
    {
        _dbFactory = dbFactory;
        _authorRepo = authorRepo;
    }

    public async Task<IReadOnlyList<Author>> GetAuthorsAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        return await db.Authors.AsNoTracking().Select(a => new Author
        {
            Id = a.Id,
            FullName = a.FullName,
            Role = a.Role,
            Department = a.Department,
            Initials = a.Initials,
            AvatarColorFrom = a.AvatarColorFrom,
            AvatarColorTo = a.AvatarColorTo,
            Badges = a.Badges,
            ArticlesCount = db.Articles.Count(art => art.AuthorId == a.Id)
        }).ToListAsync();
    }

    public async Task<Author?> GetAuthorByIdAsync(Guid id) => await _authorRepo.GetByIdAsync(id);

    public async Task<Author> CreateAuthorAsync(string fullName, string email, string? avatarUrl = null, string? bio = null, string? department = null)
    {
        var initials = GetInitials(fullName);
        var author = new Author
        {
            Id = Guid.NewGuid(),
            FullName = fullName,
            Initials = initials,
            Bio = bio ?? string.Empty,
            Department = department ?? string.Empty,
            Role = "Lector",
            JoinedAt = DateTime.UtcNow
        };
        return await _authorRepo.AddAsync(author);
    }

    // TODO: duplicado de GetInitials en ArticleDataService/CommentDataService —
    // pendiente decidir si se mueve a un helper estático compartido (CorpWiki.Application.Helpers).
    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "US";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", parts.Take(2).Select(s => s[0])).ToUpper();
    }
}

