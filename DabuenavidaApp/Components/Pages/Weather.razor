protected override void OnInitialized()
{
    RealtimeNotifier.CommentAdded += OnCommentAddedAsync;
    RealtimeNotifier.CommentUpdated += OnCommentUpdatedAsync;
    RealtimeNotifier.CommentDeleted += OnCommentDeletedAsync;
    RealtimeNotifier.CommentLikeToggled += OnCommentLikeToggledAsync;
}

private Task OnCommentAddedAsync(Guid articleId, CommentDto comment)
{
    if (_article is null || articleId != _article.Id) return Task.CompletedTask;

    return InvokeAsync(() =>
    {
        if (comment.ParentCommentId is null)
        {
            _comments.Add(comment);
        }
        else
        {
            var root = _comments.FirstOrDefault(c => c.Id == comment.ParentCommentId)
                       ?? _comments.FirstOrDefault(c => c.Replies.Any(r => r.Id == comment.ParentCommentId));
            root?.Replies.Add(comment);
        }
        StateHasChanged();
    });
}

private Task OnCommentUpdatedAsync(Guid articleId, CommentDto comment)
{
    if (_article is null || articleId != _article.Id) return Task.CompletedTask;

    return InvokeAsync(() =>
    {
        if (comment.ParentCommentId is null)
        {
            var idx = _comments.FindIndex(c => c.Id == comment.Id);
            if (idx >= 0)
            {
                comment.Replies = _comments[idx].Replies; // conservar respuestas ya cargadas
                _comments[idx] = comment;
            }
        }
        else
        {
            var root = _comments.FirstOrDefault(c => c.Replies.Any(r => r.Id == comment.Id));
            var ridx = root?.Replies.FindIndex(r => r.Id == comment.Id) ?? -1;
            if (root != null && ridx >= 0) root.Replies[ridx] = comment;
        }
        StateHasChanged();
    });
}

private Task OnCommentDeletedAsync(Guid articleId, Guid[] deletedIds)
{
    if (_article is null || articleId != _article.Id) return Task.CompletedTask;

    return InvokeAsync(() =>
    {
        _comments.RemoveAll(c => deletedIds.Contains(c.Id));
        foreach (var root in _comments)
            root.Replies.RemoveAll(r => deletedIds.Contains(r.Id));
        StateHasChanged();
    });
}

private Task OnCommentLikeToggledAsync(Guid articleId, Guid commentId, int likesCount, Guid userId, bool liked)
{
    if (_article is null || articleId != _article.Id) return Task.CompletedTask;

    return InvokeAsync(() =>
    {
        var target = _comments.FirstOrDefault(c => c.Id == commentId)
                     ?? _comments.SelectMany(c => c.Replies).FirstOrDefault(r => r.Id == commentId);
        if (target != null)
        {
            target.LikesCount = likesCount;
            if (userId == _author?.Id) target.IsLikedByCurrentUser = liked;
        }
        StateHasChanged();
    });
}