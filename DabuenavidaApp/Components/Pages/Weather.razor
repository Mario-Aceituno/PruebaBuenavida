connection.Bind();

// 1. Definir la búsqueda en Active Directory
var filtro = $"(sAMAccountName={username})";
var baseDn = "DC=daviviendahn,DC=dvhn"; // O el BaseDN que use tu dominio

var searchRequest = new SearchRequest(
    baseDn,
    filtro,
    SearchScope.Subtree,
    "displayName", "mail", "department", "title"
);

// 2. Ejecutar la consulta
var searchResponse = (SearchResponse)connection.SendRequest(searchRequest);

string fullName = username;
string email = $"{username}@davivienda.com.hn";
string department = "";
string position = "";

// 3. Extraer los datos si encontró el usuario
if (searchResponse.Entries.Count > 0)
{
    var entry = searchResponse.Entries[0];

    if (entry.Attributes["displayName"] != null && entry.Attributes["displayName"].Count > 0)
        fullName = entry.Attributes["displayName"][0]!.ToString()!;

    if (entry.Attributes["mail"] != null && entry.Attributes["mail"].Count > 0)
        email = entry.Attributes["mail"][0]!.ToString()!;

    if (entry.Attributes["department"] != null && entry.Attributes["department"].Count > 0)
        department = entry.Attributes["department"][0]!.ToString()!;

    if (entry.Attributes["title"] != null && entry.Attributes["title"].Count > 0)
        position = entry.Attributes["title"][0]!.ToString()!;
}

_logger.LogInformation("Autenticación AD exitosa para: {Username}", username);

return Task.FromResult(AdValidationResult.Success(fullName, email, department, position));
