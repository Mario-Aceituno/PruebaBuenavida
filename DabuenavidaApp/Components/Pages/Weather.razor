using CorpWiki.Domain.Entities;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Persistence;

public class MediaFileDataService : IMediaFileDataService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;
    private readonly IMediaFileRepository _mediaRepo;

    public MediaFileDataService(
        IDbContextFactory<DaviWikiDbContext> dbFactory,
        IMediaFileRepository mediaRepo)
    {
        _dbFactory = dbFactory;
        _mediaRepo = mediaRepo;
    }

    public async Task<MediaFile?> GetMediaFileAsync(Guid id) => await _mediaRepo.GetByIdAsync(id);

    public async Task<MediaFile> CreateMediaFileAsync(MediaFile mediaFile) => await _mediaRepo.AddAsync(mediaFile);

    public async Task<MediaFile> UpdateMediaFileAsync(MediaFile mediaFile) => await _mediaRepo.UpdateAsync(mediaFile);

    public async Task<IReadOnlyList<MediaFile>> GetMediaFilesAsync() => await _mediaRepo.GetAllAsync();

    public async Task<MediaFile?> GetMediaFileByIdAsync(Guid id) => await _mediaRepo.GetByIdAsync(id);

    public async Task<IReadOnlyList<MediaFile>> GetMediaFilesByTypeAsync(MediaType type) => await _mediaRepo.GetByTypeAsync(type);

    public async Task<bool> DeleteMediaFileAsync(Guid id)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var mediaFile = await db.MediaFiles.FindAsync(id);
        if (mediaFile is null)
            return false;

        db.MediaFiles.Remove(mediaFile);
        await db.SaveChangesAsync();
        return true;
    }
}


