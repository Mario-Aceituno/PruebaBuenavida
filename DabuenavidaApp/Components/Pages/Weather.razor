CSS SEPARADO
---------------
/* Modificador para expandir el modal casi a pantalla completa */
.journey-modal.journey-modal--expanded {
    max-width: 92vw; /* Cubre el 92% del ancho de la pantalla */
    height: 90vh;    /* Ocupa el 90% del alto de la ventana */
    max-height: 90vh;
}

/* Estilo para el botón de expandir en la cabecera */
.journey-modal__expand-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-radius: 4px;
    color: inherit;
    opacity: 0.7;
    transition: opacity 0.2s ease, background-color 0.2s ease;
}

.journey-modal__expand-btn:hover {
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.1);
}

CODE 
----------
private bool _isExpanded = false;

private void ToggleExpandModal()
{
    _isExpanded = !_isExpanded;
}



ETIQUETA HTML
------------------
<div class="journey-modal @(_isExpanded ? "journey-modal--expanded" : "")" @onclick:stopPropagation="true">


BOTÓN 1
-----------
<!-- Reemplaza o coloca junto al botón de cerrar existente -->
<button class="journey-modal__expand-btn" @onclick="ToggleExpandModal" title="@(_isExpanded ? "Restaurar tamaño" : "Maximizar")">
    <Icon Name="@(_isExpanded ? "minimize" : "maximize")" />
</button>

<button class="btn btn--ghost btn--sm" @onclick="CloseJourneyModal">
    <Icon Name="x" />
</button>


