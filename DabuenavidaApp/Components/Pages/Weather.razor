// NotificationDataService.cs
using CorpWiki.Application.DTOs;
using CorpWiki.Application.Interfaces;
using CorpWiki.Domain.Entities;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Persistence;

public class NotificationDataService : INotificationDataService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;
    private readonly ISecurityService _securityService;
    private readonly INotificationBroadcaster _notificationBroadcaster;

    public NotificationDataService(
        IDbContextFactory<DaviWikiDbContext> dbFactory,
        ISecurityService securityService,
        INotificationBroadcaster notificationBroadcaster)
    {
        _dbFactory = dbFactory;
        _securityService = securityService;
        _notificationBroadcaster = notificationBroadcaster;
    }

    private static NotificationItem ToNotificationItem(Notification n)
    {
        var actorName = n.Actor?.FullName ?? "Alguien";

        var (title, message, icon) = n.Type switch
        {
            NotificationType.CommentOnArticle => (
                "Nuevo comentario",
                $"{actorName} respondió a tu comentario.",
                "corner-down-right"
            ),
            NotificationType.CommentLike => (
                "Le gustó tu comentario",
                $"A {actorName} le gustó tu comentario.",
                "thumbs-up"
            ),
            _ => ("Notificación", "Tienes una nueva notificación.", "bell")
        };

        return new NotificationItem
        {
            Id = n.Id,
            Title = title,
            Message = message,
            Icon = icon,
            Url = n.Comment is not null ? $"/articulo/{n.Comment.ArticleId}#comment-{n.CommentId}" : null,
            CreatedAt = n.CreatedAt,
            IsRead = n.IsRead
        };
    }

    public async Task<IReadOnlyList<NotificationItem>> GetNotificationsAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var userId = await _securityService.GetCurrentUserIdAsync();

        var notifications = await db.Notifications
            .Where(n => n.RecipientUserId == userId)
            .Include(n => n.Actor)
            .Include(n => n.Comment)
            .OrderByDescending(n => n.CreatedAt)
            .Take(30)
            .ToListAsync();

        return notifications.Select(ToNotificationItem).ToList();
    }

    public async Task<int> GetUnreadNotificationsCountAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var userId = await _securityService.GetCurrentUserIdAsync();

        return await db.Notifications
            .CountAsync(n => n.RecipientUserId == userId && !n.IsRead);
    }

    public async Task MarkNotificationAsReadAsync(Guid id)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var userId = await _securityService.GetCurrentUserIdAsync();

        var notification = await db.Notifications
            .FirstOrDefaultAsync(n => n.Id == id && n.RecipientUserId == userId);

        if (notification is null || notification.IsRead) return;

        notification.IsRead = true;
        notification.ReadAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
    }

    public async Task MarkAllNotificationsAsReadAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var userId = await _securityService.GetCurrentUserIdAsync();
        var now = DateTime.UtcNow;

        await db.Notifications
            .Where(n => n.RecipientUserId == userId && !n.IsRead)
            .ExecuteUpdateAsync(s => s
                .SetProperty(n => n.IsRead, true)
                .SetProperty(n => n.ReadAt, now));
    }

    public async Task CreateNotificationAsync(
        Guid recipientUserId, Guid actorUserId, Guid commentId, NotificationType type)
    {
        if (recipientUserId == actorUserId) return;

        await using var db = await _dbFactory.CreateDbContextAsync();

        var notification = new Notification
        {
            Id = Guid.NewGuid(),
            RecipientUserId = recipientUserId,
            ActorUserId = actorUserId,
            CommentId = commentId,
            Type = type,
            IsRead = false,
            CreatedAt = DateTime.UtcNow
        };

        db.Notifications.Add(notification);
        await db.SaveChangesAsync();

        await db.Entry(notification).Reference(n => n.Actor).LoadAsync();
        await db.Entry(notification).Reference(n => n.Comment).LoadAsync();

        var item = ToNotificationItem(notification);
        await _notificationBroadcaster.RaiseNotificationCreatedAsync(recipientUserId, item);
    }
}

