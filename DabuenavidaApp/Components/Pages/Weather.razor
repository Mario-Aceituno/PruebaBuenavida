private bool _isFavorite;

protected override async Task OnParametersSetAsync()
{
    _article = await Data.GetArticleBySlugAsync(Slug);
    if (_article is null) return;

    _isFavorite = await Data.IsFavoriteAsync(_article.Id);

    await Data.IncrementArticleViewCountAsync(_article.Id);
    _article.ViewCount++;
}

private async Task ToggleFavorite()
{
    if (_article is null) return;
    _isFavorite = await Data.ToggleFavoriteAsync(_article.Id);
}

