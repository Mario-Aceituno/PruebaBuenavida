using CorpWiki.Application.Helpers;
using CorpWiki.Application.Interfaces.Repositories;
using CorpWiki.Domain.Entities;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Persistence;

public interface ICategoryDataService
{
    Task<IReadOnlyList<Category>> GetCategoriesAsync();
    Task<Category?> GetCategoryByIdAsync(Guid id);
    Task<Category?> GetCategoryBySlugAsync(string slug);
    Task<IReadOnlyList<Category>> GetFeaturedCategoriesAsync(int count = 8);
    Task<Category> CreateCategoryAsync(string name, string description, string icon, string color);
    Task<Category?> UpdateCategoryAsync(Guid id, string name, string description, string icon, string color);
}

public class CategoryDataService : ICategoryDataService
{
    private readonly IDbContextFactory<DaviWikiDbContext> _dbFactory;
    private readonly ICategoryRepository _categoryRepo;
    private readonly ISlugGenerator _slugGenerator;

    public CategoryDataService(
        IDbContextFactory<DaviWikiDbContext> dbFactory,
        ICategoryRepository categoryRepo,
        ISlugGenerator slugGenerator)
    {
        _dbFactory = dbFactory;
        _categoryRepo = categoryRepo;
        _slugGenerator = slugGenerator;
    }

    public async Task<IReadOnlyList<Category>> GetCategoriesAsync()
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.Categories.Select(c => new Category
        {
            Id = c.Id,
            Name = c.Name,
            Slug = c.Slug,
            Description = c.Description,
            Icon = c.Icon,
            Color = c.Color,
            ArticlesCount = db.Articles.Count(a => a.CategoryId == c.Id)
        }).ToListAsync();
    }

    public async Task<Category?> GetCategoryByIdAsync(Guid id) => await _categoryRepo.GetByIdAsync(id);

    public async Task<Category?> GetCategoryBySlugAsync(string slug) => await _categoryRepo.GetBySlugAsync(slug);

    public async Task<IReadOnlyList<Category>> GetFeaturedCategoriesAsync(int count = 8)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        return await db.Categories.AsNoTracking().Select(c => new Category
        {
            Id = c.Id,
            Name = c.Name,
            Slug = c.Slug,
            Description = c.Description,
            Icon = c.Icon,
            Color = c.Color,
            IsFeatured = c.IsFeatured,
            ArticlesCount = db.Articles.Count(a => a.CategoryId == c.Id)
        }).OrderByDescending(c => c.ArticlesCount).Take(count).ToListAsync();
    }

    public async Task<Category> CreateCategoryAsync(string name, string description, string icon, string color)
    {
        var category = new Category
        {
            Id = Guid.NewGuid(),
            Name = name,
            Description = description,
            Icon = icon,
            Color = color,
            Slug = _slugGenerator.GenerateSlug(name)
        };
        return await _categoryRepo.AddAsync(category);
    }

    public async Task<Category?> UpdateCategoryAsync(Guid id, string name, string description, string icon, string color)
    {
        var cat = await _categoryRepo.GetByIdAsync(id);
        if (cat == null) return null;

        cat.Name = name;
        cat.Description = description;
        cat.Icon = icon;
        cat.Color = color;

        return await _categoryRepo.UpdateAsync(cat);
    }
}